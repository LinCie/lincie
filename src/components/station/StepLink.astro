---
interface Props {
  href: string;
}

const { href } = Astro.props;
---

<p class="text-[.875rem] leading-[1.6] text-[#5f665c]">
  <a
    class="inline-flex min-h-11 items-center gap-2 font-bold text-[#843d2f] underline decoration-[#b8614b] decoration-1 underline-offset-4 transition-colors hover:text-[#2d332b]"
    href={href}
  >
    <span><slot /></span>
    <span aria-hidden="true">&rarr;</span>
  </a>
</p>
