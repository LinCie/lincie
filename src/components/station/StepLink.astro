---
interface Props {
  href: string;
}

const { href } = Astro.props;
---

<p class="text-ink-secondary text-[.875rem] leading-[1.6]">
  <a
    class="text-signal-terracotta-ink decoration-signal-terracotta hover:text-ink-primary inline-flex min-h-11 items-center gap-2 font-bold underline decoration-1 underline-offset-4 transition-colors"
    href={href}
  >
    <span><slot /></span>
    <span aria-hidden="true">&rarr;</span>
  </a>
</p>
