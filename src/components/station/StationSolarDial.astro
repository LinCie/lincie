---
interface Props {
  class?: string;
}

const { class: className = "" } = Astro.props;

interface TimeOption {
  id: "morning" | "midday" | "dusk" | "night";
  label: string;
  kanji: string;
  time: string;
  desc: string;
}

const times: TimeOption[] = [
  {
    id: "morning",
    label: "Morning",
    kanji: "朝",
    time: "07:00",
    desc: "Dewy morning mist and soft golden sun",
  },
  {
    id: "midday",
    label: "Midday",
    kanji: "昼",
    time: "12:00",
    desc: "Clear high sun over the countryside",
  },
  {
    id: "dusk",
    label: "Sunset",
    kanji: "夕",
    time: "17:30",
    desc: "Warm terracotta golden hour and amber tracks",
  },
  {
    id: "night",
    label: "Night",
    kanji: "夜",
    time: "21:00",
    desc: "Quiet indigo night, crescent moon, and platform lanterns",
  },
];
---

<div
  class:list={[
    "border-border-soft/80 bg-surface-paper inline-flex flex-col gap-1.5 rounded-xl border p-1.5 shadow-xs max-[640px]:w-full sm:flex-row sm:items-center sm:gap-2 sm:px-2.5 sm:py-1",
    className,
  ]}
  role="region"
  aria-label="Optional station atmosphere controls"
  data-station-clock
>
  <!-- Solar Clock Indicator (and Live button on small screens) -->
  <div
    class="text-ink-secondary flex items-center justify-between gap-1.5 px-1 font-sans text-xs font-semibold sm:justify-start"
  >
    <div class="flex items-center gap-1.5">
      <span
        class="bg-signal-terracotta size-2 shrink-0 rounded-full"
        aria-hidden="true"></span>
      <span
        class="text-ink-primary font-serif text-[.8125rem] tracking-[-0.01em]"
      >
        Station Dial
      </span>
      <span class="text-border-soft" aria-hidden="true">·</span>
      <span
        data-clock-current-time
        class="text-ink-primary font-mono text-[.8125rem] font-semibold"
      >
        07:00
      </span>
    </div>

    <!-- Live toggle on mobile top row -->
    <button
      type="button"
      data-time-live
      aria-pressed="false"
      class="text-ink-secondary hover:border-border-soft/60 hover:bg-surface-sunlit hover:text-ink-primary focus-visible:outline-signal-terracotta inline-flex min-h-11 min-w-11 items-center justify-center gap-1 rounded-lg border border-transparent px-2 py-0.5 text-[.8125rem] font-medium transition-all duration-200 focus-visible:outline-2 focus-visible:outline-offset-1 motion-reduce:transition-none sm:hidden"
      title="Synchronize station atmosphere with your local time of day"
    >
      <svg
        class="text-signal-terracotta size-2.5"
        viewBox="0 0 24 24"
        fill="none"
        stroke="currentColor"
        stroke-width="2"
        stroke-linecap="round"
        stroke-linejoin="round"
        aria-hidden="true"
      >
        <circle cx="12" cy="12" r="10"></circle>
        <polyline points="12 6 12 12 16 14"></polyline>
      </svg>
      <span>Live</span>
    </button>
  </div>

  <!-- Time buttons group -->
  <div
    class="grid grid-cols-4 gap-1 sm:flex sm:items-center"
    role="radiogroup"
    aria-label="Choose station atmosphere"
    aria-orientation="horizontal"
  >
    {
      times.map((t) => (
        <button
          type="button"
          role="radio"
          aria-checked={t.id === "morning" ? "true" : "false"}
          tabindex={t.id === "morning" ? 0 : -1}
          data-time-btn={t.id}
          data-time-hour={t.time}
          data-time-name={t.label}
          title={`${t.label} (${t.time}) — ${t.desc}`}
          class:list={[
            "group text-ink-secondary focus-visible:outline-signal-terracotta inline-flex min-h-11 min-w-11 items-center justify-center gap-1 rounded-lg px-2 py-0.5 text-[.8125rem] font-medium transition-all duration-200 focus-visible:outline-2 focus-visible:outline-offset-1 motion-reduce:transition-none",
            t.id === "morning"
              ? "border-signal-terracotta/60 bg-surface-station text-ink-primary border font-semibold shadow-xs"
              : "text-ink-secondary hover:border-border-soft/60 hover:bg-surface-sunlit hover:text-ink-primary border border-transparent",
          ]}
        >
          <span
            class:list={[
              "size-1 rounded-full transition-colors motion-reduce:transition-none",
              t.id === "morning" ? "bg-signal-terracotta" : "bg-border-soft",
            ]}
            aria-hidden="true"
            data-btn-indicator
          />
          <span class="font-serif font-normal">{t.kanji}</span>
          <span>{t.label}</span>
        </button>
      ))
    }

    <span
      class="bg-border-soft/60 mx-0.5 hidden h-3 w-px sm:inline-block"
      aria-hidden="true"></span>

    <!-- Live Sync Toggle (Desktop inline) -->
    <button
      type="button"
      data-time-live
      aria-pressed="false"
      class="text-ink-secondary hover:border-border-soft/60 hover:bg-surface-sunlit hover:text-ink-primary focus-visible:outline-signal-terracotta hidden min-h-11 min-w-11 items-center justify-center gap-1 rounded-lg border border-transparent px-2 py-0.5 text-[.8125rem] font-medium transition-all duration-200 focus-visible:outline-2 focus-visible:outline-offset-1 motion-reduce:transition-none sm:inline-flex"
      title="Synchronize station atmosphere with your local time of day"
    >
      <svg
        class="text-signal-terracotta size-2.5"
        viewBox="0 0 24 24"
        fill="none"
        stroke="currentColor"
        stroke-width="2"
        stroke-linecap="round"
        stroke-linejoin="round"
        aria-hidden="true"
      >
        <circle cx="12" cy="12" r="10"></circle>
        <polyline points="12 6 12 12 16 14"></polyline>
      </svg>
      <span>Live</span>
    </button>
  </div>

  <span class="sr-only" aria-live="polite" data-clock-announcement>
    Station atmosphere set to Morning, 07:00. Dewy morning mist and soft golden
    sun.
  </span>
</div>
