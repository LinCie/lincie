---
import { stationRoutes } from "../../data/routes";
import StationStopSign from "./StationStopSign.astro";
import { siteContainer } from "../layout/container";

interface Props {
  currentRoute?: string;
  stationId?: string;
  title?: string;
  subtitle?: string;
  class?: string;
}

const {
  currentRoute,
  stationId,
  title = "Choose another station stop",
  subtitle = "Six direct routes connect the station’s current rooms and working spaces. Choose a stop to keep wandering, or return to the main platform.",
  class: className = "",
} = Astro.props;

// Determine active station index from stationId or currentRoute
const pathname = (currentRoute ?? Astro.url.pathname).replace(/\/$/, "") || "/";

let activeIndex = -1;
if (stationId) {
  activeIndex = stationRoutes.findIndex((r) => r.id === stationId);
}
if (activeIndex === -1) {
  activeIndex = stationRoutes.findIndex((r) => r.href === pathname);
}
if (activeIndex === -1) {
  if (pathname.startsWith("/about")) {
    activeIndex = stationRoutes.findIndex((r) => r.id === "about-me");
  } else if (pathname.startsWith("/projects")) {
    activeIndex = stationRoutes.findIndex((r) => r.id === "projects");
  } else if (
    pathname.startsWith("/workshop") ||
    pathname.startsWith("/offers")
  ) {
    activeIndex = stationRoutes.findIndex((r) => r.id === "offers");
  } else if (
    pathname.startsWith("/thoughts") ||
    pathname.startsWith("/waiting-room")
  ) {
    activeIndex = stationRoutes.findIndex((r) => r.id === "thoughts");
  } else if (
    pathname.startsWith("/connect") ||
    pathname.startsWith("/letterbox")
  ) {
    activeIndex = stationRoutes.findIndex((r) => r.id === "connect");
  } else {
    activeIndex = 0;
  }
}

const currentStation = stationRoutes[activeIndex];
const currentCode = `0${activeIndex + 1}`;

// Previous and Next station resolution along the line
const totalStations = stationRoutes.length;
const prevIndex = activeIndex === 0 ? totalStations - 1 : activeIndex - 1;
const nextIndex = activeIndex === totalStations - 1 ? 0 : activeIndex + 1;

const prevStation = stationRoutes[prevIndex];
const nextStation = stationRoutes[nextIndex];
---

<section
  class:list={[
    "border-border-soft bg-surface-sunlit border-t py-16 md:py-24",
    className,
  ]}
  aria-labelledby="destination-section-title"
>
  <div class={siteContainer}>
    <!-- Section Wayfinding Header -->
    <div class="max-w-[70ch]">
      <h2
        id="destination-section-title"
        class="text-ink-primary font-serif text-[clamp(2rem,3.8vw,2.85rem)] leading-[1.12] font-normal tracking-[-0.025em]"
      >
        {title}
      </h2>

      <p
        class="text-signal-terracotta-ink mt-3 flex items-center gap-2 font-sans text-xs font-bold tracking-[0.05em] uppercase"
      >
        <span
          class="bg-signal-terracotta size-2 rounded-full"
          aria-hidden="true"></span>
        <span>
          Station Stop · STN {currentCode} · {currentStation.place} ({
            currentStation.kanji
          })
        </span>
      </p>

      <p class="text-ink-secondary mt-2.5 text-base leading-[1.68]">
        {subtitle}
      </p>
    </div>

    <!-- Train Stop Sign Illustration -->
    <div class="my-10">
      <StationStopSign
        currentStation={currentStation}
        currentCode={currentCode}
        prevStation={prevStation}
        nextStation={nextStation}
      />
    </div>

    <!-- Current Station Board -->
    <nav
      class="border-border-soft/70 mt-14 border-t pt-10"
      aria-labelledby="destination-list-title"
    >
      <div
        class="mb-6 flex flex-col justify-between gap-2 sm:flex-row sm:items-baseline"
      >
        <div>
          <h3
            id="destination-list-title"
            class="text-ink-primary font-serif text-xl font-normal md:text-2xl"
          >
            Main Line Stops
          </h3>
          <p class="text-ink-secondary mt-1 text-xs">
            Six current routes connect the station’s rooms and working spaces.
          </p>
        </div>
        <span
          class="text-ink-secondary hidden font-mono text-xs font-bold tracking-wider sm:inline"
        >
          6 STOPS · 路線図
        </span>
      </div>

      <div class="grid grid-cols-1 gap-4 sm:grid-cols-2 lg:grid-cols-3">
        {
          stationRoutes.map((route, index) => {
            const isCurrent = index === activeIndex;
            const code = `0${index + 1}`;

            if (isCurrent) {
              return (
                <div
                  class="border-signal-terracotta/70 bg-surface-paper relative flex flex-col justify-between rounded-2xl border-2 p-5 shadow-2xs"
                  aria-current="location"
                >
                  <div>
                    <div class="flex items-center justify-between gap-2">
                      <span class="bg-signal-terracotta/15 text-signal-terracotta-ink rounded-md px-2 py-0.5 font-mono text-xs font-bold">
                        STN · {code}
                      </span>
                      <span class="bg-signal-terracotta/10 text-signal-terracotta-ink inline-flex items-center gap-1.5 rounded-full px-2.5 py-0.5 font-sans text-xs font-bold">
                        <span
                          class="bg-signal-terracotta size-1.5 rounded-full"
                          aria-hidden="true"
                        />
                        <span>Current Stop (現在地)</span>
                      </span>
                    </div>

                    <div class="mt-3.5">
                      <div class="flex items-baseline gap-2">
                        <h4 class="text-ink-primary font-serif text-xl font-normal">
                          {route.place}
                        </h4>
                        <span class="text-ink-secondary font-serif text-sm">
                          ({route.kanji})
                        </span>
                      </div>
                      <p class="text-signal-terracotta-ink mt-0.5 font-sans text-xs font-bold tracking-wide">
                        {route.label}
                      </p>
                      <p class="text-ink-secondary mt-2 text-xs leading-relaxed">
                        {route.desc}
                      </p>
                    </div>
                  </div>
                </div>
              );
            }

            return (
              <a
                href={route.href}
                class="group border-border-soft bg-surface-paper hover:border-signal-terracotta focus-visible:outline-signal-terracotta relative flex flex-col justify-between rounded-2xl border p-5 shadow-xs transition-[border-color,background-color,transform,box-shadow] duration-200 ease-out hover:-translate-y-1 hover:shadow-md focus-visible:outline-2 focus-visible:outline-offset-2 motion-reduce:transition-none"
              >
                <div>
                  <div class="flex items-center justify-between gap-2">
                    <span class="bg-surface-station/60 text-ink-primary rounded-md px-2 py-0.5 font-mono text-xs font-bold">
                      STN · {code}
                    </span>
                    <span class="text-ink-secondary group-hover:text-signal-terracotta-ink font-serif text-xs transition-colors">
                      {route.kanji}
                    </span>
                  </div>

                  <div class="mt-3.5">
                    <h4 class="text-ink-primary group-hover:text-signal-terracotta-ink font-serif text-xl font-normal transition-colors">
                      {route.place}
                    </h4>
                    <p class="text-ink-secondary mt-0.5 font-sans text-xs font-bold tracking-wide">
                      {route.label}
                    </p>
                    <p class="text-ink-secondary mt-2 text-xs leading-relaxed">
                      {route.desc}
                    </p>
                  </div>
                </div>

                <div class="border-border-soft/40 text-ink-primary group-hover:text-signal-terracotta-ink mt-4 flex items-center justify-between border-t pt-3 text-xs font-bold transition-colors">
                  <span>Wander here</span>
                  <span
                    class="transition-transform group-hover:translate-x-1 motion-reduce:transform-none"
                    aria-hidden="true"
                  >
                    &rarr;
                  </span>
                </div>
              </a>
            );
          })
        }
      </div>
    </nav>

    <!-- Bottom Return Actions -->
    <div
      class="border-border-soft/60 mt-12 flex flex-wrap items-center justify-between gap-4 border-t pt-6"
    >
      <a
        href="/"
        class="border-ink-primary bg-ink-primary text-surface-paper hover:border-signal-terracotta hover:bg-signal-terracotta focus-visible:outline-signal-terracotta inline-flex min-h-11 items-center gap-2 rounded-xl border px-5 py-2.5 font-sans text-xs font-bold shadow-xs transition-[background-color,border-color,transform] hover:-translate-y-0.5 focus-visible:outline-2 focus-visible:outline-offset-2 motion-reduce:transition-none"
      >
        <svg
          class="size-4 fill-none [stroke:currentColor] [stroke-width:2]"
          viewBox="0 0 24 24"
          aria-hidden="true"
        >
          <path
            d="M19 12H5M12 19l-7-7 7-7"
            stroke-linecap="round"
            stroke-linejoin="round"></path>
        </svg>
        <span>Return to Station Platform</span>
      </a>

      <a
        href="#main-content"
        class="border-border-soft bg-surface-paper text-ink-primary hover:border-signal-terracotta hover:text-signal-terracotta-ink focus-visible:outline-signal-terracotta inline-flex min-h-11 items-center gap-2 rounded-xl border px-4 py-2.5 font-sans text-xs font-bold transition-[border-color,color] focus-visible:outline-2 focus-visible:outline-offset-2"
      >
        <span>Back to top</span>
        <svg
          class="size-3.5 fill-none [stroke:currentColor] [stroke-width:2]"
          viewBox="0 0 24 24"
          aria-hidden="true"
        >
          <path
            d="M12 19V5M5 12l7-7 7 7"
            stroke-linecap="round"
            stroke-linejoin="round"></path>
        </svg>
      </a>
    </div>
  </div>
</section>
