---
interface Props {
  /** Quiet context on the left: status, place, or category. */
  meta: string;
  /** Quiet context on the right: date, timeline, or approach. */
  metaEnd: string;
  title: string;
  href: string;
  body: string;
  /** Label for the card's own onward link. */
  cta: string;
}

const { meta, metaEnd, title, href, body, cta } = Astro.props;
---

<article
  class="border-border-soft/80 bg-surface-paper hover:border-signal-terracotta rounded-xl border p-4 transition-colors"
>
  <div
    class="text-ink-secondary flex items-center justify-between gap-2 text-[.8125rem]"
  >
    <span class="text-ink-primary font-semibold">{meta}</span>
    <span class="text-right">{metaEnd}</span>
  </div>
  <h4 class="text-ink-primary mt-1.5 font-serif text-lg font-normal">
    <a
      href={href}
      class="text-ink-primary hover:text-signal-terracotta-ink no-underline hover:underline"
    >
      {title}
    </a>
  </h4>
  <p class="text-ink-secondary mt-1.5 text-[.875rem] leading-relaxed">{body}</p>
  <a
    href={href}
    class="text-signal-terracotta-ink decoration-signal-terracotta hover:text-ink-primary mt-3 inline-flex min-h-11 items-center gap-1 text-[.8125rem] font-bold underline decoration-1 underline-offset-2 transition-colors"
  >
    <span>{cta}</span>
    <span aria-hidden="true">&rarr;</span>
  </a>
</article>
