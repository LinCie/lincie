<style>
  /* Cat gentle breathing loop */
  @keyframes catBreathing {
    0%,
    100% {
      transform: scale(1);
    }
    50% {
      transform: scale(1.025) translateY(-0.75px);
    }
  }

  :global(.cat-breathing) {
    transform-origin: 56px 46px;
    animation: catBreathing 3.6s ease-in-out infinite;
  }

  @media (prefers-reduced-motion: reduce) {
    :global(.cat-breathing) {
      animation: none;
    }
  }

  /* Dynamic Sky Shifting Integration for Diorama Cards */
  :global([data-arrival][data-sky="morning"]) .diorama-card {
    filter: brightness(1) saturate(1);
  }

  :global([data-arrival][data-sky="midday"]) .diorama-card {
    filter: brightness(1.04) saturate(1.06) contrast(1.02);
  }

  :global([data-arrival][data-sky="dusk"]) .diorama-card {
    filter: sepia(0.22) saturate(1.22) brightness(0.96) hue-rotate(-12deg);
  }

  :global([data-arrival][data-sky="night"]) .diorama-card {
    filter: brightness(0.7) contrast(1.16) saturate(0.86) hue-rotate(185deg);
  }
</style>
