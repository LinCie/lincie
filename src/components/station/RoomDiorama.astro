---
interface Props {
  id: string;
  place: string;
  tone: "house" | "field" | "workshop" | "thoughts" | "letterbox";
}

const { id, place, tone } = Astro.props;
---

<div id={`diorama-${id}`} class="relative w-full select-none">
  <div
    class:list={[
      "diorama-card border-border-soft bg-surface-sunlit relative min-h-[clamp(13rem,25vw,19rem)] w-full overflow-hidden rounded-[1.25rem] border max-[760px]:min-h-[13.5rem]",
      tone === "house" && "border-[#b49b82]/90 bg-[#f4ebe1]",
      tone === "field" && "border-[#8da978]/90 bg-[#ebf2df]",
      tone === "workshop" && "border-border-soft/90 bg-[#ebe5db]",
      tone === "thoughts" && "border-border-soft/90 bg-[#f9f6f0]",
      tone === "letterbox" && "border-border-soft/90 bg-[#f5ede4]",
    ]}
    aria-hidden="true"
  >
    <div class="pointer-events-none absolute inset-0">
      {
        tone === "house" && (
          <svg
            viewBox="0 0 360 260"
            preserveAspectRatio="xMidYMid slice"
            class="size-full"
          >
            <defs>
              <linearGradient
                id="house-sky-grad"
                x1="0%"
                y1="0%"
                x2="0%"
                y2="100%"
              >
                <stop offset="0%" stop-color="var(--sky-morning)" />
                <stop offset="65%" stop-color="#e2ece6" />
                <stop offset="100%" stop-color="var(--surface-sunlit)" />
              </linearGradient>
              <linearGradient
                id="house-sunbeam-grad"
                x1="0%"
                y1="0%"
                x2="100%"
                y2="100%"
              >
                <stop offset="0%" stop-color="#ffd479" stop-opacity="0.32" />
                <stop offset="60%" stop-color="#ffd479" stop-opacity="0.14" />
                <stop offset="100%" stop-color="#ffd479" stop-opacity="0" />
              </linearGradient>
            </defs>

            {/* Distant Countryside Sky seen through window */}
            <rect
              x="50"
              y="20"
              width="260"
              height="160"
              rx="4"
              fill="url(#house-sky-grad)"
            />

            {/* Distant soft mountain ridge */}
            <path
              d="M50 145 Q120 115 180 135 T310 125 L310 180 L50 180 Z"
              fill="var(--field-green)"
              opacity="0.45"
            />
            <path
              d="M70 155 Q150 130 220 150 T310 142 L310 180 L70 180 Z"
              fill="var(--ink-secondary)"
              opacity="0.35"
            />

            {/* Distant cedar treetops */}
            <path
              d="M85 148 L90 138 L95 148 Z M102 150 L106 142 L110 150 Z M250 144 L255 134 L260 144 Z M268 147 L272 138 L276 147 Z"
              fill="var(--ink-primary)"
              opacity="0.4"
            />

            {/* Shoji Window Frame & Timber Mullions */}
            <rect
              x="44"
              y="16"
              width="272"
              height="168"
              rx="6"
              fill="none"
              stroke="#b49b82"
              stroke-width="8"
            />
            <rect
              x="48"
              y="20"
              width="264"
              height="160"
              rx="3"
              fill="none"
              stroke="var(--signal-terracotta-ink)"
              stroke-width="2"
            />

            {/* Vertical Mullions */}
            <line
              x1="114"
              y1="20"
              x2="114"
              y2="180"
              stroke="#b49b82"
              stroke-width="3"
            />
            <line
              x1="180"
              y1="20"
              x2="180"
              y2="180"
              stroke="#b49b82"
              stroke-width="4"
            />
            <line
              x1="246"
              y1="20"
              x2="246"
              y2="180"
              stroke="#b49b82"
              stroke-width="3"
            />

            {/* Horizontal Mullions */}
            <line
              x1="48"
              y1="60"
              x2="312"
              y2="60"
              stroke="#b49b82"
              stroke-width="2.5"
            />
            <line
              x1="48"
              y1="100"
              x2="312"
              y2="100"
              stroke="#b49b82"
              stroke-width="2.5"
            />
            <line
              x1="48"
              y1="140"
              x2="312"
              y2="140"
              stroke="#b49b82"
              stroke-width="2.5"
            />

            {/* Slanted Golden Sunbeam descending from upper window */}
            <polygon
              points="180,20 280,20 340,240 120,240"
              fill="url(#house-sunbeam-grad)"
            />

            {/* Back Wall Trim */}
            <rect
              x="0"
              y="0"
              width="360"
              height="24"
              fill="var(--surface-station)"
            />
            <line
              x1="0"
              y1="24"
              x2="360"
              y2="24"
              stroke="var(--border-soft)"
              stroke-width="2"
            />
          </svg>
        )
      }

      {
        tone === "field" && (
          <svg
            viewBox="0 0 360 260"
            preserveAspectRatio="xMidYMid slice"
            class="size-full"
          >
            <defs>
              <linearGradient
                id="field-sky-grad"
                x1="0%"
                y1="0%"
                x2="0%"
                y2="100%"
              >
                <stop offset="0%" stop-color="#bde0ea" />
                <stop offset="50%" stop-color="var(--surface-field)" />
                <stop offset="100%" stop-color="var(--surface-sunlit)" />
              </linearGradient>
              <radialGradient id="field-sun-halo" cx="50%" cy="50%" r="50%">
                <stop offset="0%" stop-color="#ffd479" stop-opacity="0.8" />
                <stop offset="40%" stop-color="#ffd479" stop-opacity="0.35" />
                <stop offset="100%" stop-color="#ffd479" stop-opacity="0" />
              </radialGradient>
            </defs>

            {/* Expansive Countryside Sky */}
            <rect width="360" height="260" fill="url(#field-sky-grad)" />

            {/* Morning Sun over Mountain Ridge */}
            <circle cx="260" cy="70" r="48" fill="url(#field-sun-halo)" />
            <circle
              cx="260"
              cy="70"
              r="18"
              fill="#ffd479"
              stroke="var(--surface-sunlit)"
              stroke-width="2"
            />

            {/* Distant Mountain 1 (Farthest Pale Ridge) */}
            <path
              d="M0 130 Q90 85 190 115 T360 95 L360 260 L0 260 Z"
              fill="#97b8b2"
              opacity="0.55"
            />

            {/* Distant Mountain 2 (Mid Forest Ridge) */}
            <path
              d="M0 150 Q110 120 230 142 T360 128 L360 260 L0 260 Z"
              fill="#7a9973"
              opacity="0.65"
            />

            {/* Forest Silhouettes on Ridge */}
            <path
              d="M40 148 L44 138 L48 148 Z M52 149 L56 141 L60 149 Z M120 135 L124 125 L128 135 Z M132 136 L135 128 L138 136 Z M300 132 L304 122 L308 132 Z"
              fill="var(--ink-primary)"
              opacity="0.3"
            />

            {/* Distant Telegraph Wire Silhouette crossing the valley */}
            <line
              x1="30"
              y1="160"
              x2="30"
              y2="185"
              stroke="var(--ink-secondary)"
              stroke-width="1.2"
              opacity="0.6"
            />
            <line
              x1="180"
              y1="155"
              x2="180"
              y2="180"
              stroke="var(--ink-secondary)"
              stroke-width="1.2"
              opacity="0.6"
            />
            <path
              d="M30 162 Q105 170 180 157 Q270 168 360 160"
              fill="none"
              stroke="var(--ink-secondary)"
              stroke-width="0.8"
              opacity="0.5"
            />
          </svg>
        )
      }

      {
        tone === "workshop" && (
          <svg
            viewBox="0 0 360 260"
            preserveAspectRatio="xMidYMid slice"
            class="size-full"
          >
            <defs>
              <pattern
                id="pegboard-dots"
                width="14"
                height="14"
                patternUnits="userSpaceOnUse"
              >
                <circle
                  cx="7"
                  cy="7"
                  r="1.2"
                  fill="var(--border-soft)"
                  opacity="0.6"
                />
              </pattern>
              <linearGradient
                id="blueprint-grad"
                x1="0%"
                y1="0%"
                x2="100%"
                y2="100%"
              >
                <stop offset="0%" stop-color="#4a7c87" />
                <stop offset="100%" stop-color="#345963" />
              </linearGradient>
            </defs>

            {/* Cedar Pegboard Wall */}
            <rect width="360" height="260" fill="var(--surface-station)" />
            <rect width="360" height="260" fill="url(#pegboard-dots)" />

            {/* Hanging Tools on Wall */}
            {/* 1. Drafting Triangle */}
            <polygon
              points="45,35 95,35 45,115"
              fill="var(--sky-morning)"
              stroke="var(--ink-secondary)"
              stroke-width="1.5"
              opacity="0.75"
            />
            <polygon points="52,45 80,45 52,90" fill="var(--surface-station)" />

            {/* 2. Japanese Hand Plane (Kanna) */}
            <rect
              x="115"
              y="32"
              width="24"
              height="58"
              rx="3"
              fill="#a8896c"
              stroke="var(--ink-secondary)"
              stroke-width="1.2"
            />
            <polygon
              points="120,40 134,40 132,48 122,48"
              fill="var(--ink-secondary)"
              opacity="0.9"
            />

            {/* 3. Vernier Brass Calipers */}
            <rect
              x="160"
              y="30"
              width="6"
              height="80"
              rx="1.5"
              fill="var(--signal-gold)"
              stroke="var(--signal-terracotta-ink)"
              stroke-width="0.8"
            />
            <path
              d="M152 32 L174 32 L174 44 L166 44 L166 38 L152 38 Z"
              fill="var(--signal-gold)"
              stroke="var(--signal-terracotta-ink)"
              stroke-width="0.8"
            />
            <rect x="156" y="55" width="14" height="12" rx="1" fill="#b49b82" />

            {/* 4. Pinned Distributed Systems Blueprint Sheet */}
            <rect
              x="215"
              y="28"
              width="105"
              height="75"
              rx="2"
              fill="url(#blueprint-grad)"
              stroke="var(--surface-paper)"
              stroke-width="1"
              transform="rotate(-2 267 65)"
            />
            {/* Brass thumbtack */}
            <circle
              cx="268"
              cy="32"
              r="3"
              fill="#ffd479"
              stroke="var(--signal-terracotta-ink)"
            />
            {/* White schema lines inside blueprint */}
            <rect
              x="224"
              y="42"
              width="25"
              height="16"
              rx="1"
              fill="none"
              stroke="var(--surface-paper)"
              stroke-width="0.9"
              opacity="0.8"
            />
            <rect
              x="280"
              y="42"
              width="28"
              height="16"
              rx="1"
              fill="none"
              stroke="var(--surface-paper)"
              stroke-width="0.9"
              opacity="0.8"
            />
            <rect
              x="250"
              y="70"
              width="32"
              height="16"
              rx="1"
              fill="none"
              stroke="#ffd479"
              stroke-width="1"
              opacity="0.9"
            />
            <path
              d="M249 50 L280 50 M237 58 L250 78 M294 58 L282 78"
              fill="none"
              stroke="var(--surface-paper)"
              stroke-width="0.8"
              stroke-dasharray="2 2"
              opacity="0.7"
            />

            {/* Spool of copper coil */}
            <circle
              cx="75"
              cy="95"
              r="12"
              fill="var(--signal-terracotta)"
              stroke="var(--signal-terracotta-ink)"
              stroke-width="1.5"
            />
            <circle cx="75" cy="95" r="5" fill="var(--surface-station)" />
          </svg>
        )
      }

      {
        tone === "thoughts" && (
          <svg
            viewBox="0 0 360 260"
            preserveAspectRatio="xMidYMid slice"
            class="size-full"
          >
            <defs>
              <linearGradient
                id="thoughts-sky-grad"
                x1="0%"
                y1="0%"
                x2="0%"
                y2="100%"
              >
                <stop offset="0%" stop-color="var(--sky-morning)" />
                <stop offset="60%" stop-color="var(--surface-station)" />
                <stop offset="100%" stop-color="var(--surface-paper)" />
              </linearGradient>
              <linearGradient
                id="frosted-glass"
                x1="0%"
                y1="0%"
                x2="0%"
                y2="100%"
              >
                <stop
                  offset="0%"
                  stop-color="var(--surface-paper)"
                  stop-opacity="0.1"
                />
                <stop
                  offset="100%"
                  stop-color="var(--sky-morning)"
                  stop-opacity="0.45"
                />
              </linearGradient>
            </defs>

            {/* Station Waiting Room Arched Window opening to Tracks */}
            <rect width="360" height="260" fill="var(--surface-sunlit)" />

            {/* Arched Window cut-out with countryside track view */}
            <path
              d="M50 80 Q50 25 180 25 Q310 25 310 80 L310 190 L50 190 Z"
              fill="url(#thoughts-sky-grad)"
            />

            {/* Countryside view through glass: Tracks curving away */}
            <path
              d="M120 190 Q150 145 170 120 T185 105"
              fill="none"
              stroke="var(--ink-secondary)"
              stroke-width="1.6"
              opacity="0.6"
            />
            <path
              d="M140 190 Q162 148 178 122 T190 105"
              fill="none"
              stroke="var(--ink-secondary)"
              stroke-width="1.6"
              opacity="0.6"
            />
            {/* Track sleepers / ties in perspective */}
            <line
              x1="122"
              y1="184"
              x2="142"
              y2="184"
              stroke="var(--border-soft)"
              stroke-width="2.5"
            />
            <line
              x1="134"
              y1="168"
              x2="152"
              y2="168"
              stroke="var(--border-soft)"
              stroke-width="2"
            />
            <line
              x1="148"
              y1="152"
              x2="164"
              y2="152"
              stroke="var(--border-soft)"
              stroke-width="1.8"
            />
            <line
              x1="160"
              y1="138"
              x2="173"
              y2="138"
              stroke="var(--border-soft)"
              stroke-width="1.5"
            />

            {/* Distant soft trees beyond track */}
            <path
              d="M190 115 Q210 100 240 112 T300 110 L300 190 L190 190 Z"
              fill="var(--field-green)"
              opacity="0.35"
            />

            {/* Lower pane frosted glass condensation wash */}
            <rect
              x="50"
              y="135"
              width="260"
              height="55"
              fill="url(#frosted-glass)"
            />

            {/* Arched Timber Window Frame & Mullions */}
            <path
              d="M46 80 Q46 20 180 20 Q314 20 314 80 L314 194 L46 194 Z"
              fill="none"
              stroke="#a89278"
              stroke-width="8"
            />
            <line
              x1="180"
              y1="22"
              x2="180"
              y2="194"
              stroke="#a89278"
              stroke-width="4"
            />
            <line
              x1="48"
              y1="105"
              x2="312"
              y2="105"
              stroke="#a89278"
              stroke-width="3"
            />
            <line
              x1="48"
              y1="150"
              x2="312"
              y2="150"
              stroke="#a89278"
              stroke-width="3"
            />

            {/* Classical Round Station Clock mounted above window center */}
            <circle
              cx="180"
              cy="48"
              r="22"
              fill="var(--surface-paper)"
              stroke="var(--signal-gold)"
              stroke-width="3"
              filter="drop-shadow(0 2px 4px rgba(45,51,43,0.15))"
            />
            <circle
              cx="180"
              cy="48"
              r="19"
              fill="none"
              stroke="var(--ink-primary)"
              stroke-width="0.8"
            />
            {/* Clock hour marks */}
            <line
              x1="180"
              y1="32"
              x2="180"
              y2="36"
              stroke="var(--ink-primary)"
              stroke-width="1.8"
            />
            <line
              x1="180"
              y1="60"
              x2="180"
              y2="64"
              stroke="var(--ink-primary)"
              stroke-width="1.8"
            />
            <line
              x1="164"
              y1="48"
              x2="168"
              y2="48"
              stroke="var(--ink-primary)"
              stroke-width="1.8"
            />
            <line
              x1="192"
              y1="48"
              x2="196"
              y2="48"
              stroke="var(--ink-primary)"
              stroke-width="1.8"
            />
            {/* Clock Hands showing 10:10 */}
            <line
              x1="180"
              y1="48"
              x2="173"
              y2="38"
              stroke="var(--ink-primary)"
              stroke-width="1.8"
              stroke-linecap="round"
            />
            <line
              x1="180"
              y1="48"
              x2="191"
              y2="41"
              stroke="var(--ink-primary)"
              stroke-width="1.4"
              stroke-linecap="round"
            />
            <line
              x1="180"
              y1="48"
              x2="180"
              y2="58"
              stroke="var(--signal-terracotta)"
              stroke-width="0.9"
            />
            <circle cx="180" cy="48" r="1.5" fill="var(--signal-terracotta)" />
          </svg>
        )
      }

      {
        tone === "letterbox" && (
          <svg
            viewBox="0 0 360 260"
            preserveAspectRatio="xMidYMid slice"
            class="size-full"
          >
            <defs>
              <linearGradient
                id="letterbox-sky-grad"
                x1="0%"
                y1="0%"
                x2="0%"
                y2="100%"
              >
                <stop offset="0%" stop-color="var(--sky-morning)" />
                <stop offset="55%" stop-color="#f2ded0" />
                <stop offset="100%" stop-color="var(--surface-sunlit)" />
              </linearGradient>
            </defs>

            {/* Open Morning Platform Sky */}
            <rect width="360" height="260" fill="url(#letterbox-sky-grad)" />

            {/* Distant Telegraph Poles & Drooping Wires */}
            <line
              x1="55"
              y1="85"
              x2="55"
              y2="190"
              stroke="var(--ink-secondary)"
              stroke-width="2.5"
              opacity="0.75"
            />
            <line
              x1="45"
              y1="95"
              x2="65"
              y2="95"
              stroke="var(--ink-secondary)"
              stroke-width="2"
              opacity="0.75"
            />
            <circle cx="48" cy="95" r="1.8" fill="var(--border-soft)" />
            <circle cx="62" cy="95" r="1.8" fill="var(--border-soft)" />

            <line
              x1="290"
              y1="75"
              x2="290"
              y2="185"
              stroke="var(--ink-secondary)"
              stroke-width="2.2"
              opacity="0.7"
            />
            <line
              x1="280"
              y1="85"
              x2="300"
              y2="85"
              stroke="var(--ink-secondary)"
              stroke-width="1.8"
              opacity="0.7"
            />

            {/* Power lines drooping gracefully across the morning sky */}
            <path
              d="M0 90 Q170 125 290 85 T360 82"
              fill="none"
              stroke="var(--ink-secondary)"
              stroke-width="1"
              opacity="0.55"
            />
            <path
              d="M0 96 Q170 131 290 91 T360 88"
              fill="none"
              stroke="var(--ink-secondary)"
              stroke-width="0.9"
              opacity="0.45"
            />

            {/* A pair of Swallows in flight across dawn sky */}
            <path
              d="M195 62 Q200 58 206 63 Q208 55 214 62 Q207 65 204 74 Q202 67 195 62 Z"
              fill="var(--ink-primary)"
              opacity="0.8"
            />
            <path
              d="M228 48 Q232 45 237 49 Q238 42 243 48 Q238 50 235 57 Q234 52 228 48 Z"
              fill="var(--ink-primary)"
              opacity="0.65"
            />

            {/* Distant green meadow line */}
            <path
              d="M0 165 Q120 145 240 160 T360 152 L360 260 L0 260 Z"
              fill="var(--field-green)"
              opacity="0.38"
            />
          </svg>
        )
      }
    </div>

    <div class="pointer-events-none absolute inset-0">
      {
        tone === "house" && (
          <svg
            viewBox="0 0 360 260"
            preserveAspectRatio="xMidYMid slice"
            class="size-full"
          >
            {/* Woven Tatami Platform with Borders */}
            <rect
              x="0"
              y="168"
              width="360"
              height="92"
              fill="var(--surface-field)"
            />
            {/* Tatami straw grain lines */}
            <line
              x1="0"
              y1="180"
              x2="360"
              y2="180"
              stroke="var(--border-soft)"
              stroke-width="1"
              stroke-dasharray="3 4"
              opacity="0.6"
            />
            <line
              x1="0"
              y1="194"
              x2="360"
              y2="194"
              stroke="var(--border-soft)"
              stroke-width="1"
              stroke-dasharray="3 4"
              opacity="0.6"
            />
            <line
              x1="0"
              y1="208"
              x2="360"
              y2="208"
              stroke="var(--border-soft)"
              stroke-width="1"
              stroke-dasharray="3 4"
              opacity="0.6"
            />
            {/* Tatami Fabric Edge Band (Heri) */}
            <rect x="0" y="165" width="360" height="6" fill="#3f4e3c" />
            <rect x="180" y="171" width="6" height="89" fill="#3f4e3c" />

            {/* Low Cedar Table (Chabudai) with shadow */}
            <ellipse
              cx="110"
              cy="216"
              rx="64"
              ry="20"
              fill="var(--ink-primary)"
              opacity="0.16"
            />
            <rect
              x="52"
              y="188"
              width="116"
              height="18"
              rx="4"
              fill="var(--border-soft)"
              stroke="#a89278"
              stroke-width="1.5"
            />
            {/* Table legs */}
            <rect
              x="60"
              y="204"
              width="8"
              height="12"
              rx="1.5"
              fill="#a89278"
            />
            <rect
              x="152"
              y="204"
              width="8"
              height="12"
              rx="1.5"
              fill="#a89278"
            />

            {/* Ceramic Hot Tea Mug on Table with Steam */}
            <rect
              x="72"
              y="172"
              width="16"
              height="18"
              rx="2.5"
              fill="var(--signal-terracotta)"
              stroke="var(--signal-terracotta-ink)"
              stroke-width="1"
            />
            <path
              d="M88 176 Q94 176 94 182 Q94 187 88 187"
              fill="none"
              stroke="var(--signal-terracotta-ink)"
              stroke-width="1.5"
            />
            {/* Rising Delicate Steam paths */}
            <path
              d="M78 168 Q75 160 80 152 T77 140"
              fill="none"
              stroke="var(--surface-paper)"
              stroke-width="1.2"
              stroke-linecap="round"
              opacity="0.75"
            />
            <path
              d="M84 167 Q87 158 83 150 T86 138"
              fill="none"
              stroke="var(--surface-paper)"
              stroke-width="1"
              stroke-linecap="round"
              opacity="0.65"
            />

            {/* Stacked Hardcover Engineering Books */}
            <rect
              x="105"
              y="180"
              width="54"
              height="8"
              rx="1"
              fill="var(--field-green)"
              stroke="var(--ink-primary)"
              stroke-width="0.8"
            />
            <rect
              x="108"
              y="173"
              width="50"
              height="7"
              rx="1"
