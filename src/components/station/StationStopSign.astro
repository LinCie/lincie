---
import type { StationRoute } from "../../data/routes";

interface Props {
  currentStation: StationRoute;
  currentCode: string;
  prevStation: StationRoute;
  nextStation: StationRoute;
  class?: string;
}

const {
  currentStation,
  currentCode,
  prevStation,
  nextStation,
  class: className = "",
} = Astro.props;

const kanjiLength = currentStation.kanji.length;
const kanjiFontSize = kanjiLength >= 4 ? 25 : kanjiLength === 3 ? 28 : 31;
const kanjiSpacing =
  kanjiLength >= 4 ? "0.08em" : kanjiLength === 3 ? "0.14em" : "0.24em";
const englishSubtitle = `${currentStation.place.toUpperCase()} · ${currentStation.label.toUpperCase()}`;
---

<div
  class:list={["relative mx-auto w-full max-w-[720px] select-none", className]}
>
  <svg
    viewBox="0 0 760 320"
    class="h-auto w-full overflow-visible"
    fill="none"
    xmlns="http://www.w3.org/2000/svg"
    role="img"
    aria-label={`Station platform stop sign for ${currentStation.place} (${currentStation.label}), station code STN ${currentCode}. Previous stop: ${prevStation.place}, Next stop: ${nextStation.place}.`}
  >
    <defs>
      <!-- Morning Countryside Sky Gradient -->
      <linearGradient id="sign-sky-grad" x1="0%" y1="0%" x2="0%" y2="100%">
        <stop offset="0%" stop-color="#c9e0e2" stop-opacity="0.65"></stop>
        <stop offset="65%" stop-color="#e8f0e6" stop-opacity="0.45"></stop>
        <stop offset="100%" stop-color="#f7f2e8" stop-opacity="0.15"></stop>
      </linearGradient>

      <!-- Soft Sunlit Signboard Plate Gradient -->
      <linearGradient id="sign-plate-grad" x1="0%" y1="0%" x2="0%" y2="100%">
        <stop offset="0%" stop-color="#fffdf8"></stop>
        <stop offset="100%" stop-color="#f9f4ea"></stop>
      </linearGradient>

      <!-- Weathered Stanchion Wood Grain Gradient -->
      <linearGradient id="sign-wood-post" x1="0%" y1="0%" x2="100%" y2="0%">
        <stop offset="0%" stop-color="#554b3f"></stop>
        <stop offset="45%" stop-color="#7a6d5c"></stop>
        <stop offset="100%" stop-color="#463e34"></stop>
      </linearGradient>

      <!-- Cedar Canopy Roof Gradient -->
      <linearGradient id="sign-roof-wood" x1="0%" y1="0%" x2="0%" y2="100%">
        <stop offset="0%" stop-color="#3d352e"></stop>
        <stop offset="100%" stop-color="#2a241e"></stop>
      </linearGradient>

      <!-- Steel Rail Gradient -->
      <linearGradient id="sign-rail-steel" x1="0%" y1="0%" x2="0%" y2="100%">
        <stop offset="0%" stop-color="#525d50"></stop>
        <stop offset="35%" stop-color="#697666"></stop>
        <stop offset="70%" stop-color="#384036"></stop>
        <stop offset="100%" stop-color="#232822"></stop>
      </linearGradient>

      <!-- Vintage Lantern Warm Amber Glow -->
      <radialGradient
        id="sign-lantern-glow"
        cx="50%"
        cy="40%"
        r="55%"
        fx="50%"
        fy="35%"
      >
        <stop offset="0%" stop-color="#ffd479" stop-opacity="0.48"></stop>
        <stop offset="45%" stop-color="#ffd479" stop-opacity="0.16"></stop>
        <stop offset="100%" stop-color="#ffd479" stop-opacity="0"></stop>
      </radialGradient>
    </defs>

    <!-- Background: Morning Sky & Distant Mountain Ridge -->
    <rect
      x="10"
      y="10"
      width="740"
      height="230"
      rx="12"
      fill="url(#sign-sky-grad)"></rect>

    <!-- Mountain Layer 1 (Far Soft Ridge) -->
    <path
      d="M10,210 Q160,165 320,188 T640,175 Q700,182 750,205 L750,240 L10,240 Z"
      fill="#dce7c9"
      opacity="0.55"></path>

    <!-- Mountain Layer 2 (Middle Ridge with Field Green) -->
    <path
      d="M10,224 Q180,195 380,214 T750,206 L750,240 L10,240 Z"
      fill="#c9dbc2"
      opacity="0.45"></path>

    <!-- Distant Cedar Treetops -->
    <path
      d="M55,218 L60,204 L65,218 Z M70,220 L75,208 L80,220 Z M675,212 L680,200 L685,212 Z M692,216 L697,205 L702,216 Z"
      fill="#6c895f"
      opacity="0.4"></path>

    <!-- Platform Base & Trackbed Section (y: 240 to 320) -->
    <!-- Raised Platform Stone Curb Deck -->
    <rect
      x="0"
      y="240"
      width="760"
      height="24"
      fill="#e9ddc9"
      stroke="#c4b49d"
      stroke-width="1.5"></rect>

    <!-- Stone Masonry Joints along Platform Curb -->
    <line x1="120" y1="240" x2="120" y2="264" stroke="#c4b49d" stroke-width="1"
    ></line>
    <line x1="240" y1="240" x2="240" y2="264" stroke="#c4b49d" stroke-width="1"
    ></line>
    <line x1="360" y1="240" x2="360" y2="264" stroke="#c4b49d" stroke-width="1"
    ></line>
    <line x1="480" y1="240" x2="480" y2="264" stroke="#c4b49d" stroke-width="1"
    ></line>
    <line x1="600" y1="240" x2="600" y2="264" stroke="#c4b49d" stroke-width="1"
    ></line>
    <line x1="720" y1="240" x2="720" y2="264" stroke="#c4b49d" stroke-width="1"
    ></line>

    <!-- Platform Edge Tactile Warning Line (Warm Gold / Terracotta) -->
    <rect x="0" y="242" width="760" height="3.5" fill="#d49a48" opacity="0.85"
    ></rect>
    <line
      x1="0"
      y1="248.5"
      x2="760"
      y2="248.5"
      stroke="#b8614b"
      stroke-width="1.5"
      stroke-dasharray="3 7"
      opacity="0.7"></line>

    <!-- Gravel Ballast Bed below Platform -->
    <rect x="0" y="264" width="760" height="56" fill="#e4d7c5"></rect>

    <!-- Ballast Gravel Texture Dots -->
    <g fill="#c4b49d" opacity="0.65">
      <circle cx="45" cy="272" r="1.5"></circle>
      <circle cx="85" cy="276" r="1"></circle>
      <circle cx="150" cy="273" r="1.5"></circle>
      <circle cx="210" cy="277" r="1"></circle>
      <circle cx="295" cy="272" r="1.5"></circle>
      <circle cx="370" cy="275" r="1.2"></circle>
      <circle cx="445" cy="271" r="1.5"></circle>
      <circle cx="530" cy="276" r="1"></circle>
      <circle cx="615" cy="272" r="1.5"></circle>
      <circle cx="690" cy="275" r="1.2"></circle>
      <circle cx="105" cy="314" r="1.2"></circle>
      <circle cx="230" cy="316" r="1.5"></circle>
      <circle cx="340" cy="313" r="1"></circle>
      <circle cx="475" cy="315" r="1.5"></circle>
      <circle cx="585" cy="314" r="1.2"></circle>
      <circle cx="710" cy="316" r="1.5"></circle>
    </g>

    <!-- Wooden Railroad Ties (Sleepers) across Trackbed -->
    <g fill="#5a4e3f" stroke="#3d352e" stroke-width="1">
      <rect x="25" y="278" width="24" height="38" rx="2"></rect>
      <rect x="75" y="278" width="24" height="38" rx="2"></rect>
      <rect x="125" y="278" width="24" height="38" rx="2"></rect>
      <rect x="175" y="278" width="24" height="38" rx="2"></rect>
      <rect x="225" y="278" width="24" height="38" rx="2"></rect>
      <rect x="275" y="278" width="24" height="38" rx="2"></rect>
      <rect x="325" y="278" width="24" height="38" rx="2"></rect>
      <rect x="375" y="278" width="24" height="38" rx="2"></rect>
      <rect x="425" y="278" width="24" height="38" rx="2"></rect>
      <rect x="475" y="278" width="24" height="38" rx="2"></rect>
      <rect x="525" y="278" width="24" height="38" rx="2"></rect>
      <rect x="575" y="278" width="24" height="38" rx="2"></rect>
      <rect x="625" y="278" width="24" height="38" rx="2"></rect>
      <rect x="675" y="278" width="24" height="38" rx="2"></rect>
      <rect x="725" y="278" width="24" height="38" rx="2"></rect>
    </g>

    <!-- Steel Rails (Running Horizontally) -->
    <!-- Top Steel Rail (y: 285 to 291) -->
    <rect
      x="0"
      y="285"
      width="760"
      height="6"
      fill="url(#sign-rail-steel)"
      stroke="#232822"
      stroke-width="0.75"></rect>
    <!-- Rail Head Polished Steel Highlight -->
    <line
      x1="0"
      y1="286.2"
      x2="760"
      y2="286.2"
      stroke="#c4b49d"
      stroke-width="1.2"
      opacity="0.9"></line>

    <!-- Bottom Steel Rail (y: 302 to 308) -->
    <rect
      x="0"
      y="302"
      width="760"
      height="6"
      fill="url(#sign-rail-steel)"
      stroke="#232822"
      stroke-width="0.75"></rect>
    <!-- Rail Head Polished Steel Highlight -->
    <line
      x1="0"
      y1="303.2"
      x2="760"
      y2="303.2"
      stroke="#c4b49d"
      stroke-width="1.2"
      opacity="0.9"></line>

    <!-- Countryside Grass Tufts & Wildflowers at Track Edge -->
    <g stroke-linecap="round">
      <!-- Grass Tufts Left -->
      <path
        d="M38,266 Q35,258 32,254 M39,266 Q41,257 44,253 M40,266 Q43,260 48,256"
        stroke="#6c895f"
        stroke-width="1.5"></path>
      <!-- Wildflower Buttercup Dot -->
      <circle cx="45" cy="253" r="2.2" fill="#d49a48"></circle>

      <!-- Grass Tufts Mid-Left -->
      <path
        d="M152,266 Q149,259 146,255 M153,266 Q156,258 159,254 M154,266 Q158,261 163,257"
        stroke="#6c895f"
        stroke-width="1.5"></path>
      <circle
        cx="160"
        cy="254"
        r="2"
        fill="#fffdf8"
        stroke="#d49a48"
        stroke-width="0.75"></circle>

      <!-- Grass Tufts Right -->
      <path
        d="M608,266 Q605,259 601,255 M609,266 Q612,258 616,253 M610,266 Q614,261 619,257"
        stroke="#6c895f"
        stroke-width="1.5"></path>
      <circle cx="617" cy="253" r="2.2" fill="#d49a48"></circle>

      <!-- Grass Tufts Far Right -->
      <path
        d="M718,266 Q715,258 712,254 M719,266 Q722,257 726,253"
        stroke="#6c895f"
        stroke-width="1.5"></path>
    </g>

    <!-- ======================================================== -->
    <!-- The Central Platform Stop Signpost Assembly (駅名標)   -->
    <!-- Center coordinate: x = 380                              -->
    <!-- ======================================================== -->

    <!-- Twin Heavy Stanchion Timber Posts -->
    <!-- Left Stanchion Post (x: 180 to 194) -->
    <rect
      x="180"
      y="54"
      width="14"
      height="192"
      rx="2"
      fill="url(#sign-wood-post)"
      stroke="#3d352e"
      stroke-width="1.5"></rect>
    <!-- Left Post Iron Platform Base Shoe & Hex Bolt -->
    <rect
      x="176"
      y="238"
      width="22"
      height="8"
      rx="1.5"
      fill="#384036"
      stroke="#232822"
      stroke-width="1"></rect>
    <circle cx="187" cy="242" r="1.8" fill="#c4b49d"></circle>

    <!-- Right Stanchion Post (x: 566 to 580) -->
    <rect
      x="566"
      y="54"
      width="14"
      height="192"
      rx="2"
      fill="url(#sign-wood-post)"
      stroke="#3d352e"
      stroke-width="1.5"></rect>
    <!-- Right Post Iron Platform Base Shoe & Hex Bolt -->
    <rect
      x="562"
      y="238"
      width="22"
      height="8"
      rx="1.5"
      fill="#384036"
      stroke="#232822"
      stroke-width="1"></rect>
    <circle cx="573" cy="242" r="1.8" fill="#c4b49d"></circle>

    <!-- Rear Horizontal Timber Crossbar Spanning Posts -->
    <rect
      x="194"
      y="136"
      width="372"
      height="10"
      fill="#554b3f"
      stroke="#3d352e"
      stroke-width="1"></rect>

    <!-- ======================================================== -->
    <!-- Main Station Signboard Plate                             -->
    <!-- Width: 388, Height: 156, from x: 186 to 574, y: 66 to 222 -->
    <!-- ======================================================== -->

    <!-- Outer Wooden Frame with Soft Drop Shadow Effect -->
    <rect
      x="184"
      y="64"
      width="392"
      height="160"
      rx="7"
      fill="#3d352e"
      stroke="#2d332b"
      stroke-width="2"></rect>

    <!-- Inner Plate Face (Sunlit Paper Toned) -->
    <rect
      x="188"
      y="68"
      width="384"
      height="152"
      rx="5"
      fill="url(#sign-plate-grad)"
      stroke="#c4b49d"
      stroke-width="1.25"></rect>

    <!-- 4 Brass Corner Rivets -->
    <circle
      cx="197"
      cy="77"
      r="2.2"
      fill="#c4b49d"
      stroke="#5f665c"
      stroke-width="0.75"></circle>
    <circle
      cx="563"
      cy="77"
      r="2.2"
      fill="#c4b49d"
      stroke="#5f665c"
      stroke-width="0.75"></circle>
    <circle
      cx="197"
      cy="211"
      r="2.2"
      fill="#c4b49d"
      stroke="#5f665c"
      stroke-width="0.75"></circle>
    <circle
      cx="563"
      cy="211"
      r="2.2"
      fill="#c4b49d"
      stroke="#5f665c"
      stroke-width="0.75"></circle>

    <!-- Station Plate Header Row (y: 86) -->
    <!-- Line Name Label (Left) -->
    <text
      class="sign-microcopy"
      x="208"
      y="86"
      font-family='"Noto Sans", system-ui, sans-serif'
      font-size="9.5"
      font-weight="700"
      fill="#5f665c"
      letter-spacing="0.08em"
    >
      LINCIE LINE · 鉄道
    </text>

    <!-- Station Stop Code Tag (Right: STN · 0X) -->
    <rect
      class="sign-microcopy"
      x="494"
      y="74"
      width="64"
      height="17"
      rx="3.5"
      fill="#e9ddc9"
      stroke="#c4b49d"
      stroke-width="1"></rect>
    <text
      class="sign-microcopy"
      x="526"
      y="86"
      text-anchor="middle"
      font-family='ui-monospace, monospace, "Noto Sans"'
      font-size="10"
      font-weight="700"
      fill="#2d332b"
      letter-spacing="0.06em"
    >
      STN · {currentCode}
    </text>

    <!-- Main Station Kanji (Center: x = 380, y = 124) -->
    <text
      x="380"
      y="124"
      text-anchor="middle"
      font-family='Georgia, "Noto Serif", "Hiragino Mincho ProN", serif'
      font-size={kanjiFontSize}
      font-weight="500"
      fill="#2d332b"
      letter-spacing={kanjiSpacing}
    >
      {currentStation.kanji}
    </text>

    <!-- Station English Name & Literal Label (Center: x = 380, y = 145) -->
    <text
      class="sign-microcopy"
      x="380"
      y="145"
      text-anchor="middle"
      font-family='"Noto Sans", system-ui, sans-serif'
      font-size="11.5"
      font-weight="700"
      fill="#5f665c"
      letter-spacing="0.1em"
    >
      {englishSubtitle}
    </text>

    <!-- ======================================================== -->
    <!-- Terracotta Railway Line Stripe (y: 156 to 162)           -->
    <!-- ======================================================== -->
    <rect x="198" y="156" width="364" height="6.5" rx="2" fill="#b8614b"></rect>

    <!-- Terracotta Stripe Center Arrow Marker -->
    <polygon points="377,157.5 383,159.25 377,161" fill="#fffdf8"></polygon>

    <!-- ======================================================== -->
    <!-- Directional Station Arrows & Adjacent Stops              -->
    <!-- ======================================================== -->
    <!-- Left Direction (Previous Stop) -->
    <g class="sign-adjacent-copy">
      <!-- Small Arrow & Direction Pill -->
      <text
        x="208"
        y="178"
        font-family='"Noto Sans", system-ui, sans-serif'
        font-size="8.5"
        font-weight="700"
        fill="#843d2f"
        letter-spacing="0.06em"
      >
        ◂ PREV · 前の駅
      </text>
      <!-- Previous Station Kanji -->
      <text
        x="208"
        y="194"
        font-family='Georgia, "Noto Serif", serif'
        font-size="12.5"
        font-weight="500"
        fill="#2d332b"
      >
        {prevStation.kanji}
      </text>
      <!-- Previous Station Place Name -->
      <text
        x="208"
        y="207"
        font-family='"Noto Sans", system-ui, sans-serif'
        font-size="9"
        font-weight="600"
        fill="#5f665c"
      >
        {prevStation.place}
      </text>
    </g>

    <!-- Center Dashed Boundary Tick -->
    <line
      x1="380"
      y1="169"
      x2="380"
      y2="214"
      stroke="#c4b49d"
      stroke-width="1"
      stroke-dasharray="2 3"></line>

    <!-- Right Direction (Next Stop) -->
    <g class="sign-adjacent-copy" text-anchor="end">
      <!-- Small Arrow & Direction Pill -->
      <text
        x="552"
        y="178"
        font-family='"Noto Sans", system-ui, sans-serif'
        font-size="8.5"
        font-weight="700"
        fill="#843d2f"
        letter-spacing="0.06em"
      >
        NEXT · 次の駅 ▸
      </text>
      <!-- Next Station Kanji -->
      <text
        x="552"
        y="194"
        font-family='Georgia, "Noto Serif", serif'
        font-size="12.5"
        font-weight="500"
        fill="#2d332b"
      >
        {nextStation.kanji}
      </text>
      <!-- Next Station Place Name -->
      <text
        x="552"
        y="207"
        font-family='"Noto Sans", system-ui, sans-serif'
        font-size="9"
        font-weight="600"
        fill="#5f665c"
      >
        {nextStation.place}
      </text>
    </g>

    <!-- ======================================================== -->
    <!-- Gabled Timber Rooflet Canopy Over Signboard              -->
    <!-- ======================================================== -->
    <!-- Sloped Timber Fascia Board -->
    <polygon
      points="164,66 380,42 596,66 592,72 380,48 168,72"
      fill="url(#sign-roof-wood)"
      stroke="#231e19"
      stroke-width="1.5"></polygon>

    <!-- Canopy Peak Ridge Cap & Brass Finial -->
    <rect
      x="372"
      y="38"
      width="16"
      height="6"
      rx="1.5"
      fill="#d49a48"
      stroke="#2d332b"
      stroke-width="1"></rect>
    <circle
      cx="380"
      cy="34"
      r="3.5"
      fill="#d49a48"
      stroke="#2d332b"
      stroke-width="1"></circle>

    <!-- ======================================================== -->
    <!-- Vintage Platform Gooseneck Platform Lamp                 -->
    <!-- ======================================================== -->
    <!-- Cast-Iron Bracket Pipe -->
    <path
      d="M380,42 C380,18 348,12 334,22 C327,27 325,35 325,43"
      fill="none"
      stroke="#2d332b"
      stroke-width="2.75"
      stroke-linecap="round"></path>

    <!-- Flared Bell Lamp Shade -->
    <path
      d="M312,52 L338,52 L332,43 L318,43 Z"
      fill="#2d332b"
      stroke="#2d332b"
      stroke-width="1"></path>

    <!-- Glowing Bulb Point -->
    <circle
      cx="325"
      cy="54"
      r="3.5"
      fill="#fff0a8"
      stroke="#d49a48"
      stroke-width="0.8"></circle>

    <!-- Warm Golden Light Pool on Sign Face -->
    <ellipse
      cx="332"
      cy="82"
      rx="96"
      ry="48"
      fill="url(#sign-lantern-glow)"
      pointer-events="none"></ellipse>
  </svg>
</div>

<style>
  /* Keep tiny station lettering atmospheric on phones; HTML labels remain readable. */
  @media (max-width: 480px) {
    .sign-microcopy,
    .sign-adjacent-copy {
      display: none;
    }
  }
</style>
