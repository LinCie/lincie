---
interface Props {
  currentRoute?: string;
}

const { currentRoute } = Astro.props;
const pathname = (currentRoute ?? Astro.url.pathname).replace(/\/$/, "") || "/";
const isHome = pathname === "/";
const isAbout = pathname === "/about";
const isProjects =
  pathname === "/projects" || pathname.startsWith("/projects/");
const isWorkshop = pathname === "/workshop" || pathname === "/offers";

const siteContainer =
  "mx-auto w-[calc(100%-40px)] max-w-[1152px] max-[480px]:w-[calc(100%-32px)] md:w-[calc(100%-80px)]";
---

<header
  class="sticky top-0 z-30 border-b border-[#c4b49d] bg-[#f7f2e8]/95 backdrop-blur-xs"
>
  <div
    class={`${siteContainer} flex min-h-[4.5rem] items-center justify-between gap-3 max-[480px]:min-h-16`}
  >
    <!-- Brand / Home Mark -->
    <a
      class="group inline-flex min-h-11 items-center gap-3 text-[#2d332b] no-underline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-[#b8614b]"
      href="/"
      aria-label={isHome
        ? "LinCie station home (current page)"
        : "Return to LinCie station home"}
      aria-current={isHome ? "page" : undefined}
    >
      <span
        class="relative grid size-8 place-items-center rounded-full border-[1.5px] border-[#b8614b] bg-[#fffdf8] transition-transform duration-200 ease-out group-hover:scale-105 before:absolute before:block before:h-0 before:w-[1.15rem] before:border-t-[1.5px] before:border-[#b8614b] before:content-[''] after:absolute after:block after:h-[1.15rem] after:w-0 after:border-l-[1.5px] after:border-[#b8614b] after:content-[''] motion-reduce:group-hover:scale-100"
        aria-hidden="true"
      >
        <span class="size-[.35rem] rounded-full bg-[#b8614b]"></span>
      </span>
      <span class="font-serif text-2xl tracking-[-0.02em]">LinCie</span>
    </a>

    <!-- Wayfinding & Navigation -->
    <nav
      aria-label="Station wayfinding"
      class="flex items-center gap-2 sm:gap-4 md:gap-6"
    >
      <!-- Location Badge -->
      <div
        class="inline-flex items-center gap-2 rounded-full border border-[#c4b49d]/70 bg-[#fffdf8] px-3 py-1.5 font-sans text-xs font-semibold tracking-[0.03em] text-[#5f665c] max-[360px]:px-2"
        aria-current="page"
      >
        <span
          class="size-2 shrink-0 rounded-full bg-[#b8614b]"
          aria-hidden="true"></span>
        <span>
          {
            isHome ? (
              <>
                Platform<span class="hidden sm:inline"> · Station arrival</span>
              </>
            ) : isAbout ? (
              <>
                <span class="hidden sm:inline">Station House · </span>About Me
                <span class="hidden md:inline"> · 駅舎</span>
              </>
            ) : isProjects ? (
              <>
                <span class="hidden sm:inline">Rice Fields · </span>Projects
                <span class="hidden md:inline"> · 稲田</span>
              </>
            ) : isWorkshop ? (
              <>
                <span class="hidden sm:inline">Workshop · </span>Offers
                <span class="hidden md:inline"> · 工房</span>
              </>
            ) : (
              "Station"
            )
          }
        </span>
      </div>

      <!-- Action / Nav Links -->
      <div class="flex items-center gap-1 sm:gap-3">
        {
          !isHome && (
            <a
              href="/"
              class="group/nav inline-flex min-h-11 items-center gap-1 rounded-md px-2 py-1.5 font-sans text-xs font-bold tracking-[0.03em] text-[#2d332b] underline decoration-[#c4b49d] decoration-1 underline-offset-4 transition-colors hover:text-[#b8614b] hover:decoration-[#b8614b] focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-[#b8614b]"
            >
              <span>Platform</span>
            </a>
          )
        }
        {
          !isAbout && (
            <a
              href="/about"
              class="group/nav inline-flex min-h-11 items-center gap-1 rounded-md px-2 py-1.5 font-sans text-xs font-bold tracking-[0.03em] text-[#2d332b] underline decoration-[#c4b49d] decoration-1 underline-offset-4 transition-colors hover:text-[#b8614b] hover:decoration-[#b8614b] focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-[#b8614b]"
            >
              <span>Station House</span>
            </a>
          )
        }
        {
          !isProjects && (
            <a
              href="/projects"
              class="group/nav inline-flex min-h-11 items-center gap-1 rounded-md px-2 py-1.5 font-sans text-xs font-bold tracking-[0.03em] text-[#2d332b] underline decoration-[#c4b49d] decoration-1 underline-offset-4 transition-colors hover:text-[#b8614b] hover:decoration-[#b8614b] focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-[#b8614b]"
            >
              <span>Rice Fields</span>
            </a>
          )
        }
        {
          !isWorkshop && (
            <a
              href="/workshop"
              class="group/nav inline-flex min-h-11 items-center gap-1 rounded-md px-2 py-1.5 font-sans text-xs font-bold tracking-[0.03em] text-[#2d332b] underline decoration-[#c4b49d] decoration-1 underline-offset-4 transition-colors hover:text-[#b8614b] hover:decoration-[#b8614b] focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-[#b8614b]"
            >
              <span>Workshop</span>
            </a>
          )
        }
      </div>
    </nav>
  </div>
</header>
