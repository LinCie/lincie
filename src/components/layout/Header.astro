---
import { siteContainer } from "./container";
import { stationRoutes } from "../../data/routes";

interface Props {
  currentRoute?: string;
}

const { currentRoute } = Astro.props;
const pathname = (currentRoute ?? Astro.url.pathname).replace(/\/$/, "") || "/";
const isHome = pathname === "/";
const isAbout = pathname === "/about";
const isProjects =
  pathname === "/projects" || pathname.startsWith("/projects/");
const isWorkshop = pathname === "/workshop" || pathname === "/offers";
const isThoughts =
  pathname === "/thoughts" ||
  pathname.startsWith("/thoughts/") ||
  pathname === "/waiting-room";
const isConnect = pathname === "/connect" || pathname === "/letterbox";

const activeById: Record<string, boolean> = {
  platform: isHome,
  "about-me": isAbout,
  projects: isProjects,
  offers: isWorkshop,
  thoughts: isThoughts,
  connect: isConnect,
};

const routes = stationRoutes.map((route) => ({
  ...route,
  active: activeById[route.id] ?? false,
}));
---

<header
  class="border-border-soft bg-surface-sunlit/95 sticky top-0 z-30 border-b backdrop-blur-xs"
>
  <div
    class={`${siteContainer} flex min-h-[4.5rem] items-center justify-between gap-3 max-[480px]:min-h-16`}
  >
    <!-- Brand / Home Mark -->
    <a
      class="group text-ink-primary focus-visible:outline-signal-terracotta inline-flex min-h-11 items-center gap-3 no-underline focus-visible:outline-2 focus-visible:outline-offset-2"
      href="/"
      aria-label={isHome
        ? "LinCie station home (current page)"
        : "Return to LinCie station home"}
      aria-current={isHome ? "page" : undefined}
    >
      <span
        class="border-signal-terracotta bg-surface-paper before:border-signal-terracotta after:border-signal-terracotta relative grid size-8 place-items-center rounded-full border-[1.5px] transition-transform duration-200 ease-out group-hover:scale-105 before:absolute before:block before:h-0 before:w-[1.15rem] before:border-t-[1.5px] before:content-[''] after:absolute after:block after:h-[1.15rem] after:w-0 after:border-l-[1.5px] after:content-[''] motion-reduce:group-hover:scale-100"
        aria-hidden="true"
      >
        <span class="bg-signal-terracotta size-[.35rem] rounded-full"></span>
      </span>
      <span class="font-serif text-2xl tracking-[-0.02em]">LinCie</span>
    </a>

    <!-- Wayfinding & Navigation -->
    <nav
      aria-label="Station wayfinding"
      class="flex items-center gap-2 sm:gap-4 md:gap-6"
    >
      <!-- Location Badge -->
      <div
        class="border-border-soft/70 bg-surface-paper text-ink-secondary inline-flex items-center gap-2 rounded-full border px-2.5 py-1.5 font-sans text-xs font-semibold tracking-[0.03em] max-[360px]:hidden sm:px-3"
        aria-current="page"
        data-station-badge
      >
        <span
          class="bg-signal-terracotta size-2 shrink-0 rounded-full"
          aria-hidden="true"></span>
        <span>
          {
            isHome ? (
              <>
                Platform<span class="hidden sm:inline"> · Station arrival</span>
              </>
            ) : isAbout ? (
              <>
                <span class="hidden sm:inline">Station House · </span>About Me
                <span class="hidden md:inline"> · 駅舎</span>
              </>
            ) : isProjects ? (
              <>
                <span class="hidden sm:inline">Rice Fields · </span>Projects
                <span class="hidden md:inline"> · 稲田</span>
              </>
            ) : isWorkshop ? (
              <>
                <span class="hidden sm:inline">Workshop · </span>Offers
                <span class="hidden md:inline"> · 工房</span>
              </>
            ) : isThoughts ? (
              <>
                <span class="hidden sm:inline">Waiting Room · </span>Thoughts
                <span class="hidden md:inline"> · 待合室</span>
              </>
            ) : isConnect ? (
              <>
                <span class="hidden sm:inline">Letterbox · </span>Ways to
                connect
                <span class="hidden md:inline"> · 郵便受け</span>
              </>
            ) : (
              "Station"
            )
          }
        </span>
      </div>

      <!-- Desktop Action / Nav Links: inline only once there is room for six labels -->
      <div class="hidden items-center gap-1 sm:gap-3 lg:flex">
        {
          routes
            .filter((route) => !route.active)
            .map((route) => (
              <a
                href={route.href}
                class="group/nav text-ink-primary decoration-border-soft hover:text-signal-terracotta-ink hover:decoration-signal-terracotta-ink focus-visible:outline-signal-terracotta inline-flex min-h-11 items-center gap-1 rounded-md px-2 py-1.5 font-sans text-xs font-bold tracking-[0.03em] whitespace-nowrap underline decoration-1 underline-offset-4 transition-colors focus-visible:outline-2 focus-visible:outline-offset-2"
              >
                <span>{route.place}</span>
              </a>
            ))
        }
      </div>

      <!-- Mobile Menu Toggle Button -->
      <button
        type="button"
        id="mobile-nav-toggle"
        aria-expanded="false"
        aria-controls="mobile-sidebar-panel"
        aria-label="Open station menu"
        class="group border-border-soft/70 bg-surface-paper text-ink-primary hover:border-signal-terracotta hover:text-signal-terracotta-ink focus-visible:outline-signal-terracotta relative inline-flex size-11 items-center justify-center rounded-lg border shadow-xs transition-colors focus-visible:outline-2 focus-visible:outline-offset-2 active:scale-95 lg:hidden"
      >
        <span class="sr-only">Toggle navigation menu</span>
        <div
          class="relative flex h-3.5 w-4.5 flex-col justify-between"
          aria-hidden="true"
        >
          <span
            id="hamburger-line-1"
            class="h-0.5 w-full origin-center rounded-full bg-current transition-transform duration-300 ease-out motion-reduce:transition-none"
          ></span>
          <span
            id="hamburger-line-2"
            class="h-0.5 w-3/4 self-end rounded-full bg-current transition-all duration-200 ease-out motion-reduce:transition-none"
          ></span>
          <span
            id="hamburger-line-3"
            class="h-0.5 w-full origin-center rounded-full bg-current transition-transform duration-300 ease-out motion-reduce:transition-none"
          ></span>
        </div>
      </button>
    </nav>
  </div>
</header>

<!-- Mobile Sidebar Overlay & Drawer -->
<div
  id="mobile-sidebar-container"
  class="pointer-events-none invisible fixed inset-0 z-50"
  aria-hidden="true"
>
  <!-- Backdrop button -->
  <button
    type="button"
    id="mobile-sidebar-backdrop"
    tabindex="-1"
    aria-label="Close station menu"
    class="bg-ink-primary/40 absolute inset-0 size-full cursor-default opacity-0 backdrop-blur-xs focus:outline-none"
  >
  </button>

  <!-- Sidebar Panel (Drawer) -->
  <nav
    id="mobile-sidebar-panel"
    aria-label="Mobile station wayfinding"
    role="dialog"
    aria-modal="true"
    tabindex="-1"
    inert
    class="border-border-soft bg-surface-paper absolute top-0 right-0 bottom-0 flex h-full w-[min(100vw-2.5rem,360px)] max-w-sm translate-x-full flex-col overflow-hidden border-l shadow-[-16px_0_40px_rgba(45,51,43,0.12)]"
  >
    <!-- Sidebar Header -->
    <div
      data-sidebar-header
      class="border-border-soft/60 bg-surface-sunlit/85 flex items-center justify-between border-b px-5 py-4"
    >
      <div class="flex items-center gap-2.5">
        <span class="relative flex size-2.5" aria-hidden="true">
          <span
            class="bg-signal-terracotta absolute inline-flex size-full animate-ping rounded-full opacity-60 motion-reduce:animate-none"
          ></span>
          <span
            class="bg-signal-terracotta relative inline-flex size-2.5 rounded-full"
          ></span>
        </span>
        <div class="flex flex-col">
          <span
            class="text-ink-primary font-serif text-base tracking-[-0.01em]"
          >
            Station Board
          </span>
          <span
            class="text-ink-secondary font-sans text-xs font-semibold tracking-[0.04em]"
          >
            時刻表 · Wayfinding
          </span>
        </div>
      </div>
      <button
        type="button"
        id="mobile-sidebar-close"
        aria-label="Close station navigation menu"
        class="border-border-soft/60 bg-surface-paper text-ink-primary hover:border-signal-terracotta hover:text-signal-terracotta focus-visible:outline-signal-terracotta inline-flex size-11 items-center justify-center rounded-lg border transition-colors focus-visible:outline-2 focus-visible:outline-offset-2 active:scale-95 motion-reduce:transition-none"
      >
        <svg
          class="size-4"
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="2"
          stroke-linecap="round"
          stroke-linejoin="round"
          aria-hidden="true"
        >
          <line x1="18" y1="6" x2="6" y2="18"></line>
          <line x1="6" y1="6" x2="18" y2="18"></line>
        </svg>
      </button>
    </div>

    <!-- Current Station Status -->
    <div
      data-sidebar-status
      class="border-border-soft/40 bg-surface-sunlit/40 text-ink-secondary flex items-center gap-2 border-b px-5 py-2.5 text-[.8125rem]"
    >
      <span class="font-sans font-medium">Current Stop:</span>
      <span
        class="border-border-soft/50 bg-surface-paper text-ink-primary inline-flex items-center gap-1.5 rounded-full border px-2.5 py-0.5 font-semibold"
      >
        <span
          class="bg-signal-terracotta size-1.5 rounded-full"
          aria-hidden="true"></span>
        {
          isHome
            ? "Platform (Arrival)"
            : isAbout
              ? "Station House (About Me)"
              : isProjects
                ? "Rice Fields (Projects)"
                : isWorkshop
                  ? "Workshop (Offers)"
                  : isThoughts
                    ? "Waiting Room (Thoughts)"
                    : isConnect
                      ? "Letterbox (Connect)"
                      : "Station"
        }
      </span>
    </div>

    <!-- Route Links (Station Wayfinding List) -->
    <div class="flex-1 space-y-2 overflow-y-auto px-4 py-4" tabindex="-1">
      {
        routes.map((route) => (
          <a
            href={route.href}
            data-sidebar-link
            aria-current={route.active ? "page" : undefined}
            class={`group focus-visible:outline-signal-terracotta relative flex items-center justify-between rounded-xl border p-3.5 no-underline transition-colors duration-200 focus-visible:outline-2 focus-visible:outline-offset-2 ${
              route.active
                ? "border-signal-terracotta/60 bg-surface-sunlit shadow-xs"
                : "border-border-soft/40 bg-surface-paper hover:border-border-soft hover:bg-surface-sunlit/60"
            }`}
          >
            <div class="flex items-start gap-3">
              <div class="mt-0.5 flex flex-col items-center" aria-hidden="true">
                <span
                  class={`grid size-5 place-items-center rounded-full border ${
                    route.active
                      ? "border-signal-terracotta bg-signal-terracotta text-surface-paper"
                      : "border-border-soft bg-surface-paper group-hover:border-signal-terracotta"
                  }`}
                >
                  {route.active ? (
                    <span class="bg-surface-paper size-1.5 rounded-full" />
                  ) : (
                    <span class="bg-border-soft group-hover:bg-signal-terracotta size-1 rounded-full" />
                  )}
                </span>
              </div>

              <div class="flex flex-col">
                <div class="flex items-baseline gap-2">
                  <span
                    class={`font-serif text-lg tracking-[-0.01em] ${
                      route.active
                        ? "text-ink-primary font-medium"
                        : "text-ink-primary group-hover:text-signal-terracotta-ink"
                    }`}
                  >
                    {route.place}
                  </span>
                  <span class="text-ink-secondary font-sans text-[.8125rem] font-semibold">
                    {route.kanji}
                  </span>
                </div>
                <span class="text-ink-secondary font-sans text-[.8125rem]">
                  {route.label}
                </span>
                <span class="text-ink-secondary mt-0.5 font-sans text-[.8125rem] leading-snug">
                  {route.desc}
                </span>
              </div>
            </div>

            <div class="ml-2 shrink-0">
              {route.active ? (
                <span class="bg-signal-terracotta/10 text-signal-terracotta-ink inline-flex items-center rounded-md px-2 py-0.5 font-sans text-[.8125rem] font-bold tracking-wide">
                  Here
                </span>
              ) : (
                <span
                  class="text-border-soft group-hover:text-signal-terracotta font-serif text-sm transition-transform duration-200 group-hover:translate-x-0.5"
                  aria-hidden="true"
                >
                  ──→
                </span>
              )}
            </div>
          </a>
        ))
      }
    </div>

    <!-- Sidebar Footer -->
    <div
      data-sidebar-footer
      class="border-border-soft/50 bg-surface-sunlit/60 border-t px-5 py-3.5 text-center"
    >
      <p class="text-ink-secondary font-sans text-xs">
        LinCie · Software Engineering Trainee
      </p>
      <p class="text-ink-secondary mt-0.5 font-serif text-xs italic">
        A quiet rural station in morning light.
      </p>
    </div>
  </nav>
</div>

<script>
  import gsap from "gsap";

  let navAbortController: AbortController | null = null;
  let activeTimeline: gsap.core.Timeline | null = null;
  let isOpen = false;

  const prefersReducedMotion = (): boolean =>
    typeof window !== "undefined" &&
    window.matchMedia("(prefers-reduced-motion: reduce)").matches;

  function initMobileNav() {
    // Reset previous controller if running on page swap
    if (navAbortController) {
      navAbortController.abort();
      navAbortController = null;
    }

    if (activeTimeline) {
      activeTimeline.kill();
      activeTimeline = null;
    }

    // Ensure body scroll is unlocked when new page loads
    document.body.style.overflow = "";
    isOpen = false;

    const toggleBtn = document.getElementById("mobile-nav-toggle");
    const closeBtn = document.getElementById("mobile-sidebar-close");
    const backdrop = document.getElementById("mobile-sidebar-backdrop");
    const container = document.getElementById("mobile-sidebar-container");
    const drawer = document.getElementById("mobile-sidebar-panel");
    const line1 = document.getElementById("hamburger-line-1");
    const line2 = document.getElementById("hamburger-line-2");
    const line3 = document.getElementById("hamburger-line-3");
    const links = drawer?.querySelectorAll<HTMLAnchorElement>(
      "[data-sidebar-link]",
    );

    if (!toggleBtn || !container || !drawer) return;

    navAbortController = new AbortController();
    const { signal } = navAbortController;

    // Reset initial visual state
    gsap.set(drawer, { x: "100%" });
    if (backdrop) gsap.set(backdrop, { opacity: 0 });
    const initialItems = drawer.querySelectorAll<HTMLElement>(
      "[data-sidebar-link]",
    );
    const initialHeader = drawer.querySelector<HTMLElement>(
      "[data-sidebar-header]",
    );
    const initialStatus = drawer.querySelector<HTMLElement>(
      "[data-sidebar-status]",
    );
    const initialFooter = drawer.querySelector<HTMLElement>(
      "[data-sidebar-footer]",
    );
    if (initialHeader) gsap.set(initialHeader, { opacity: 0, x: 14 });
    if (initialStatus) gsap.set(initialStatus, { opacity: 0, x: 14 });
    if (initialItems && initialItems.length > 0)
      gsap.set(initialItems, { opacity: 0, x: 18 });
    if (initialFooter) gsap.set(initialFooter, { opacity: 0, y: 8 });

    function setHamburgerVisual(open: boolean) {
      if (!line1 || !line2 || !line3) return;
      if (open) {
        line1.style.transform = "translateY(6px) rotate(45deg)";
        line2.style.opacity = "0";
        line2.style.transform = "scaleX(0)";
        line3.style.transform = "translateY(-6px) rotate(-45deg)";
      } else {
        line1.style.transform = "";
        line2.style.opacity = "";
        line2.style.transform = "";
        line3.style.transform = "";
      }
    }

    function openSidebar() {
      if (isOpen) return;
      isOpen = true;

      toggleBtn?.setAttribute("aria-expanded", "true");
      toggleBtn?.setAttribute("aria-label", "Close station menu");
      container?.classList.remove("invisible", "pointer-events-none");
      container?.setAttribute("aria-hidden", "false");
      drawer?.removeAttribute("inert");
      document.body.style.overflow = "hidden";
      setHamburgerVisual(true);

      if (activeTimeline) activeTimeline.kill();

      const items = drawer?.querySelectorAll<HTMLElement>(
        "[data-sidebar-link]",
      );
      const header = drawer?.querySelector<HTMLElement>(
        "[data-sidebar-header]",
      );
      const status = drawer?.querySelector<HTMLElement>(
        "[data-sidebar-status]",
      );
      const footer = drawer?.querySelector<HTMLElement>(
        "[data-sidebar-footer]",
      );

      if (prefersReducedMotion()) {
        if (backdrop) gsap.set(backdrop, { opacity: 1 });
        gsap.set(drawer, { x: "0%" });
        if (header) gsap.set(header, { opacity: 1, x: 0 });
        if (status) gsap.set(status, { opacity: 1, x: 0 });
        if (items) gsap.set(items, { opacity: 1, x: 0 });
        if (footer) gsap.set(footer, { opacity: 1, y: 0 });
        const targetFocus =
          drawer?.querySelector<HTMLElement>('[aria-current="page"]') ||
          links?.[0] ||
          closeBtn;
        targetFocus?.focus();
        return;
      }

      // Start everything at 0 opacity regardless, avoiding any hitch or flash
      gsap.set(drawer, { x: "100%" });
      if (backdrop) gsap.set(backdrop, { opacity: 0 });
      if (header) gsap.set(header, { opacity: 0, x: 14 });
      if (status) gsap.set(status, { opacity: 0, x: 14 });
      if (items && items.length > 0) gsap.set(items, { opacity: 0, x: 18 });
      if (footer) gsap.set(footer, { opacity: 0, y: 8 });

      const tl = gsap.timeline({
        onComplete: () => {
          const targetFocus =
            drawer?.querySelector<HTMLElement>('[aria-current="page"]') ||
            links?.[0] ||
            closeBtn;
          targetFocus?.focus();
        },
      });
      activeTimeline = tl;

      // Start everything at the exact same time (0) with timeline sequencing via duration:
      // No nav waits for another to finish, eliminating the perceived pause.
      if (backdrop) {
        tl.to(backdrop, { opacity: 1, duration: 0.28, ease: "power2.out" }, 0);
      }

      tl.to(drawer, { x: "0%", duration: 0.34, ease: "power3.out" }, 0);

      const topContent = [header, status].filter(Boolean);
      if (topContent.length > 0) {
        tl.to(
          topContent,
          { opacity: 1, x: 0, duration: 0.24, ease: "power2.out" },
          0,
        );
      }

      if (items && items.length > 0) {
        tl.to(
          items,
          {
            opacity: 1,
            x: 0,
            duration: (i: number) => 0.24 + i * 0.02,
            ease: "power2.out",
          },
          0,
        );
      }

      if (footer) {
        tl.to(
          footer,
          { opacity: 1, y: 0, duration: 0.32, ease: "power2.out" },
          0,
        );
      }
    }

    function closeSidebar(instant = false) {
      if (!isOpen) return;
      isOpen = false;

      toggleBtn?.setAttribute("aria-expanded", "false");
      toggleBtn?.setAttribute("aria-label", "Open station menu");
      setHamburgerVisual(false);
      document.body.style.overflow = "";

      if (activeTimeline) activeTimeline.kill();

      const items = drawer?.querySelectorAll<HTMLElement>(
        "[data-sidebar-link]",
      );
      const header = drawer?.querySelector<HTMLElement>(
        "[data-sidebar-header]",
      );
      const status = drawer?.querySelector<HTMLElement>(
        "[data-sidebar-status]",
      );
      const footer = drawer?.querySelector<HTMLElement>(
        "[data-sidebar-footer]",
      );

      const finishClosing = () => {
        container?.classList.add("invisible", "pointer-events-none");
        container?.setAttribute("aria-hidden", "true");
        drawer?.setAttribute("inert", "");
        gsap.set(drawer, { x: "100%" });
        if (backdrop) gsap.set(backdrop, { opacity: 0 });
        if (items) gsap.set(items, { clearProps: "transform,opacity" });
        if (header) gsap.set(header, { clearProps: "transform,opacity" });
        if (status) gsap.set(status, { clearProps: "transform,opacity" });
        if (footer) gsap.set(footer, { clearProps: "transform,opacity" });
      };

      if (instant || prefersReducedMotion()) {
        finishClosing();
        if (!instant) toggleBtn?.focus();
        return;
      }

      const tl = gsap.timeline({
        onComplete: () => {
          finishClosing();
          toggleBtn?.focus();
        },
      });
      activeTimeline = tl;

      if (items && items.length > 0) {
        tl.to(
          items,
          {
            opacity: 0,
            x: 12,
            duration: 0.16,
            ease: "power2.in",
          },
          0,
        );
      }

      const contentElements = [header, status, footer].filter(Boolean);
      if (contentElements.length > 0) {
        tl.to(
          contentElements,
          {
            opacity: 0,
            duration: 0.14,
            ease: "power2.in",
          },
          0,
        );
      }

      tl.to(drawer, { x: "100%", duration: 0.22, ease: "power3.in" }, 0);

      if (backdrop) {
        tl.to(backdrop, { opacity: 0, duration: 0.2, ease: "power2.in" }, 0);
      }
    }

    toggleBtn.addEventListener(
      "click",
      () => {
        if (isOpen) {
          closeSidebar();
        } else {
          openSidebar();
        }
      },
      { signal },
    );

    closeBtn?.addEventListener("click", () => closeSidebar(), { signal });
    backdrop?.addEventListener("click", () => closeSidebar(), { signal });

    // Trap focus and handle ESC
    drawer.addEventListener(
      "keydown",
      (e: KeyboardEvent) => {
        if (e.key === "Escape") {
          e.preventDefault();
          closeSidebar();
          return;
        }

        if (e.key === "Tab") {
          const focusableEls = Array.from(
            drawer.querySelectorAll<HTMLElement>(
              'button, [href], input, select, textarea, [tabindex]:not([tabindex="-1"])',
            ),
          ).filter(
            (el) => !el.hasAttribute("disabled") && el.offsetParent !== null,
          );

          if (focusableEls.length === 0) return;

          const firstEl = focusableEls[0];
          const lastEl = focusableEls[focusableEls.length - 1];

          if (e.shiftKey) {
            if (document.activeElement === firstEl) {
              e.preventDefault();
              lastEl.focus();
            }
          } else {
            if (document.activeElement === lastEl) {
              e.preventDefault();
              firstEl.focus();
            }
          }
        }
      },
      { signal },
    );

    // Close when navigating via any sidebar link
    links?.forEach((link) => {
      link.addEventListener(
        "click",
        () => {
          const href = link.getAttribute("href");
          const current = window.location.pathname.replace(/\/$/, "") || "/";
          const target = href ? href.replace(/\/$/, "") || "/" : "";
          if (target === current) {
            closeSidebar(false);
          } else {
            closeSidebar(true);
          }
        },
        { signal },
      );
    });

    // Close automatically if viewport expands to desktop breakpoint
    const handleResize = () => {
      if (window.innerWidth >= 1024 && isOpen) {
        closeSidebar(true);
      }
    };
    window.addEventListener("resize", handleResize, { signal });
  }

  // Astro & DOM lifecycle
  if (typeof document !== "undefined") {
    if (document.readyState === "loading") {
      document.addEventListener("DOMContentLoaded", initMobileNav);
    } else {
      initMobileNav();
    }
  }

  document.addEventListener("astro:page-load", () => {
    initMobileNav();
  });

  document.addEventListener("astro:before-preparation", () => {
    document.body.style.overflow = "";
    const container = document.getElementById("mobile-sidebar-container");
    const drawer = document.getElementById("mobile-sidebar-panel");
    const toggleBtn = document.getElementById("mobile-nav-toggle");
    if (container && drawer) {
      container.classList.add("invisible", "pointer-events-none");
      container.setAttribute("aria-hidden", "true");
      drawer.setAttribute("inert", "");
      gsap.set(drawer, { x: "100%" });
      const items = drawer.querySelectorAll("[data-sidebar-link]");
      const header = drawer.querySelector("[data-sidebar-header]");
      const status = drawer.querySelector("[data-sidebar-status]");
      const footer = drawer.querySelector("[data-sidebar-footer]");
      if (items) gsap.set(items, { clearProps: "transform,opacity" });
      if (header) gsap.set(header, { clearProps: "transform,opacity" });
      if (status) gsap.set(status, { clearProps: "transform,opacity" });
      if (footer) gsap.set(footer, { clearProps: "transform,opacity" });
    }
    if (toggleBtn) {
      toggleBtn.setAttribute("aria-expanded", "false");
      toggleBtn.setAttribute("aria-label", "Open station menu");
    }
  });
</script>
