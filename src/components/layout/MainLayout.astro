---
import { ClientRouter } from "astro:transitions";
import Header from "./Header.astro";
import Footer from "./Footer.astro";
import StationPageTransition from "../transitions/StationPageTransition.astro";
import { site, absoluteUrl, canonicalUrl } from "../../data/site";
import "../../styles/global.css";

type JsonLdNode = Record<string, unknown>;

interface Breadcrumb {
  name: string;
  path: string;
}

interface Props {
  title?: string;
  description?: string;
  currentRoute?: string;
  ogType?: "website" | "article" | "profile";
  /** schema.org type for this page, e.g. "AboutPage", "CollectionPage", "ContactPage", "ProfilePage". */
  pageType?: string;
  noindex?: boolean;
  publishedTime?: string;
  modifiedTime?: string;
  breadcrumbs?: Breadcrumb[];
  jsonLd?: JsonLdNode | JsonLdNode[];
}

const {
  title = site.title,
  description = site.description,
  currentRoute,
  ogType = "website",
  pageType = "WebPage",
  noindex = false,
  publishedTime,
  modifiedTime,
  breadcrumbs,
  jsonLd,
} = Astro.props;

const pathname = currentRoute ?? Astro.url.pathname;
const canonicalURL = canonicalUrl(pathname);
const ogImageURL = absoluteUrl(site.ogImage.url);
const sitemapURL = absoluteUrl("/sitemap.xml");

const personId = `${site.url}/#person`;
const websiteId = `${site.url}/#website`;

// The person and website nodes are emitted on every page so that search engines can
// resolve the author and publisher references on deep-linked project and note pages.
const personNode: JsonLdNode = {
  "@type": "Person",
  "@id": personId,
  name: site.author.name,
  alternateName: site.author.alternateName,
  url: absoluteUrl("/"),
  jobTitle: site.author.jobTitle,
  worksFor: { "@type": "Organization", name: site.author.organization },
  sameAs: [site.author.github],
  knowsAbout: [
    "Backend engineering",
    "Go",
    "TypeScript",
    "PostgreSQL",
    "REST APIs",
    "Docker",
    "Web accessibility",
    "Astro",
  ],
};

const websiteNode: JsonLdNode = {
  "@type": "WebSite",
  "@id": websiteId,
  url: absoluteUrl("/"),
  name: site.name,
  description: site.description,
  inLanguage: site.language,
  author: { "@id": personId },
  publisher: { "@id": personId },
};

const breadcrumbNode: JsonLdNode | undefined = breadcrumbs && {
  "@type": "BreadcrumbList",
  "@id": `${canonicalURL}#breadcrumb`,
  itemListElement: breadcrumbs.map((crumb, index) => ({
    "@type": "ListItem",
    position: index + 1,
    name: crumb.name,
    item: canonicalUrl(crumb.path),
  })),
};

const pageNodes = Array.isArray(jsonLd) ? jsonLd : jsonLd ? [jsonLd] : [];

const webPageNode: JsonLdNode = {
  "@type": pageType,
  "@id": `${canonicalURL}#webpage`,
  url: canonicalURL,
  name: title,
  description,
  inLanguage: site.language,
  isPartOf: { "@id": websiteId },
  about: { "@id": personId },
  ...(breadcrumbNode ? { breadcrumb: { "@id": breadcrumbNode["@id"] } } : {}),
};

const structuredData = [
  personNode,
  websiteNode,
  webPageNode,
  ...(breadcrumbNode ? [breadcrumbNode] : []),
  ...pageNodes,
];

const robotsContent = noindex
  ? "noindex, nofollow"
  : "index, follow, max-image-preview:large, max-snippet:-1, max-video-preview:-1";
---

<html lang="en" class="scroll-smooth">
  <head>
    <meta charset="utf-8" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" href="/favicon.ico" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="generator" content={Astro.generator} />

    <!-- Primary metadata -->
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="robots" content={robotsContent} />
    <meta name="author" content={site.author.name} />
    <link rel="canonical" href={canonicalURL} />
    <link rel="sitemap" type="application/xml" href={sitemapURL} />
    <meta name="theme-color" content="#f7f2e8" />

    <!-- Open Graph -->
    <meta property="og:type" content={ogType} />
    <meta property="og:site_name" content={site.name} />
    <meta property="og:locale" content={site.locale} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonicalURL} />
    <meta property="og:image" content={ogImageURL} />
    <meta property="og:image:width" content={String(site.ogImage.width)} />
    <meta property="og:image:height" content={String(site.ogImage.height)} />
    <meta property="og:image:alt" content={site.ogImage.alt} />
    {
      ogType === "article" && publishedTime && (
        <meta property="article:published_time" content={publishedTime} />
      )
    }
    {
      ogType === "article" && modifiedTime && (
        <meta property="article:modified_time" content={modifiedTime} />
      )
    }
    {
      ogType === "article" && (
        <meta property="article:author" content={absoluteUrl("/about")} />
      )
    }

    <!-- Twitter / X -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImageURL} />
    <meta name="twitter:image:alt" content={site.ogImage.alt} />

    <script
      is:inline
      type="application/ld+json"
      set:html={JSON.stringify(structuredData)}
    />

    <ClientRouter />
  </head>
  <body
    class="bg-[#f7f2e8] text-[#2d332b] antialiased selection:bg-[#d49a48] selection:text-[#2d332b]"
  >
    <!-- Accessible Skip to Content Link -->
    <a
      class="fixed top-4 left-4 z-50 -translate-y-[160%] rounded-md border border-[#b8614b] bg-[#fffdf8] px-4 py-3 text-sm font-bold text-[#2d332b] shadow-md transition-transform duration-200 ease-out focus:translate-y-0 focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-[#b8614b] motion-reduce:transition-none"
      href="#main-content"
    >
      Skip to main content
    </a>

    <div class="flex min-h-screen flex-col overflow-x-clip bg-[#f7f2e8]">
      <Header currentRoute={pathname} />

      <main
        id="main-content"
        tabindex="-1"
        class="flex-1 scroll-mt-[5.5rem] focus:outline-none"
      >
        <slot />
      </main>

      <Footer currentRoute={pathname} />
    </div>

    <StationPageTransition />
  </body>
</html>
