---
import { siteContainer } from "./container";
import { stationRoutes } from "../../data/routes";
interface Props {
  currentRoute?: string;
}

const { currentRoute } = Astro.props;
const pathname = (currentRoute ?? Astro.url.pathname).replace(/\/$/, "") || "/";
const isHome = pathname === "/";
const isAbout = pathname === "/about";
const isProjects =
  pathname === "/projects" || pathname.startsWith("/projects/");
const isWorkshop = pathname === "/workshop" || pathname === "/offers";
const isThoughts =
  pathname === "/thoughts" ||
  pathname.startsWith("/thoughts/") ||
  pathname === "/waiting-room";
const isConnect = pathname === "/connect" || pathname === "/letterbox";

const activeById: Record<string, boolean> = {
  platform: isHome,
  "about-me": isAbout,
  projects: isProjects,
  offers: isWorkshop,
  thoughts: isThoughts,
  connect: isConnect,
};

const routes = stationRoutes.map((route) => ({
  ...route,
  active: activeById[route.id] ?? false,
}));

const routeLinkClass =
  "inline-flex min-h-11 items-center gap-2 text-sm text-surface-sunlit/85 underline decoration-signal-terracotta decoration-1 underline-offset-4 transition-colors hover:text-surface-paper hover:decoration-surface-paper focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-signal-terracotta";

const currentYear = new Date().getFullYear();
---

<footer
  class="border-border-soft/40 bg-surface-footer text-surface-sunlit border-t"
>
  <div class={`${siteContainer} py-12 md:py-16`}>
    <div
      class="grid grid-cols-1 gap-10 md:grid-cols-[1.3fr_1fr_1fr] md:gap-8 lg:gap-12"
    >
      <!-- Zone 1: Station Identity -->
      <div class="space-y-4">
        <div class="flex items-center gap-3">
          <span
            class="border-surface-sunlit/40 bg-surface-sunlit/10 relative grid size-7 place-items-center rounded-full border"
            aria-hidden="true"
          >
            <span class="bg-signal-terracotta size-2 rounded-full"></span>
          </span>
          <p class="text-surface-sunlit font-serif text-2xl tracking-[-0.02em]">
            LinCie Station
          </p>
        </div>

        <p class="text-surface-sunlit/80 max-w-[38ch] text-sm leading-relaxed">
          A personal world first. A portfolio second. LinCie is a software
          engineering trainee making room for thoughtful work and curious ideas.
        </p>

        <div
          class="text-surface-field flex items-center gap-2 pt-1 font-sans text-xs"
        >
          <span class="bg-signal-gold size-1.5 rounded-full" aria-hidden="true"
          ></span>
          <span>Sea Labs Indonesia · Go &amp; TypeScript</span>
        </div>
      </div>

      <!-- Zone 2: Wayfinding & Tracks -->
      <div>
        <h2
          class="text-surface-field font-sans text-xs font-bold tracking-[0.06em] uppercase"
        >
          Wayfinding &amp; Tracks
        </h2>
        <nav class="mt-4 flex flex-col gap-1" aria-label="Footer wayfinding">
          {
            routes.map((route) => (
              <a
                class={routeLinkClass}
                href={route.active ? "#main-content" : route.href}
              >
                <span>{route.footerLabel}</span>
                {route.active && (
                  <span class="text-surface-field text-xs">(Here)</span>
                )}
              </a>
            ))
          }

          <a class={routeLinkClass} href={isHome ? "#board" : "/#board"}>
            <span>Station Board</span>
          </a>

          <a class={routeLinkClass} href={isHome ? "#rooms" : "/#rooms"}>
            <span>Quiet Rooms</span>
          </a>

          <a class={`group/top ${routeLinkClass}`} href="#main-content">
            <span>Top of page</span>
            <svg
              class="size-3.5 fill-none [stroke:currentColor] [stroke-width:2] transition-transform group-hover/top:-translate-y-0.5 motion-reduce:transform-none"
              viewBox="0 0 24 24"
              aria-hidden="true"
            >
              <path d="M12 19V5M5 12l7-7 7 7"></path>
            </svg>
          </a>
        </nav>
      </div>

      <!-- Zone 3: Station Atmosphere -->
      <div>
        <h2
          class="text-surface-field font-sans text-xs font-bold tracking-[0.06em] uppercase"
        >
          Station Atmosphere
        </h2>
        <div
          class="text-surface-sunlit/80 mt-4 space-y-3 text-sm leading-relaxed"
        >
          <p>
            Take your time. There is no route to complete and no tour to finish.
            Come back when you feel like wandering again.
          </p>
          <p class="text-surface-sunlit/65 text-xs">
            Inspired by iyashikei calm, rural train platforms, and morning light
            across quiet fields.
          </p>
        </div>
      </div>
    </div>

    <!-- Bottom Colophon -->
    <div
      class="border-surface-sunlit/15 text-surface-sunlit/70 mt-12 flex flex-col items-center justify-between gap-4 border-t pt-6 text-xs sm:flex-row"
    >
      <p>
        LinCie Station · &copy; {currentYear} · Built with care
      </p>
      <p class="text-center sm:text-right">
        No algorithms, no tracking, no hurry.
      </p>
    </div>
  </div>
</footer>
