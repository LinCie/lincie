---
import MainLayout from "../../components/layout/MainLayout.astro";
import { thoughts } from "../../data/thoughts";
import { site, canonicalUrl } from "../../data/site";

const siteContainer =
  "mx-auto w-[calc(100%-40px)] max-w-[1152px] max-[480px]:w-[calc(100%-32px)] md:w-[calc(100%-80px)]";

const publishedThoughts = thoughts.filter((t) => t.status === "published");
const inPrepThoughts = thoughts.filter((t) => t.status === "in-preparation");

const thoughtsJsonLd = {
  "@type": "ItemList",
  "@id": `${canonicalUrl("/thoughts")}#notes`,
  name: "Passenger notes from the LinCie Station waiting room",
  numberOfItems: publishedThoughts.length,
  itemListElement: publishedThoughts.map((thought, index) => ({
    "@type": "ListItem",
    position: index + 1,
    item: {
      "@type": "BlogPosting",
      headline: thought.title,
      description: thought.summary,
      articleSection: thought.topic,
      datePublished: thought.isoDate,
      url: canonicalUrl(`/thoughts/${thought.slug}`),
      author: { "@id": `${site.url}/#person` },
      inLanguage: site.language,
    },
  })),
};
---

<MainLayout
  title="Thoughts — Notes on Backend Craft & Learning by LinCie"
  description="Passenger notes from the station table — reflections on backend engineering, database craft, and learning to work unhurried. No algorithms, no metrics."
  currentRoute="/thoughts"
  pageType="CollectionPage"
  breadcrumbs={[
    { name: "Station Platform", path: "/" },
    { name: "The Waiting Room (Thoughts)", path: "/thoughts" },
  ]}
  jsonLd={thoughtsJsonLd}
>
  <!-- Threshold & Wayfinding Banner -->
  <section
    class="border-b border-[#c4b49d] bg-[#f7f2e8] pt-10 pb-12 md:pt-16 md:pb-16"
  >
    <div class={siteContainer}>
      <nav
        aria-label="Route wayfinding"
        class="flex items-center gap-2 font-sans text-xs font-semibold tracking-[0.03em] text-[#5f665c]"
      >
        <a
          href="/"
          class="inline-flex min-h-11 items-center text-[#5f665c] underline decoration-[#c4b49d] decoration-1 underline-offset-4 transition-colors hover:text-[#b8614b] hover:decoration-[#b8614b] focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-[#b8614b]"
        >
          Station Platform
        </a>
        <span aria-hidden="true" class="text-[#c4b49d]">/</span>
        <span class="text-[#2d332b]" aria-current="page">The Waiting Room</span>
      </nav>

      <div class="mt-6 max-w-[72ch]">
        <h1
          class="font-serif text-[clamp(2.5rem,5.5vw,4.5rem)] leading-[1.05] font-normal tracking-[-0.03em] text-[#2d332b]"
        >
          The Waiting Room
        </h1>
        <p
          class="mt-4 font-serif text-[clamp(1.15rem,2.2vw,1.4rem)] leading-[1.45] text-[#5f665c]"
        >
          A sunlit timber bench between train tracks and rice fields. Loose-leaf
          notebooks rest on the table—reflections on backend systems, database
          craft, and learning with patience.
        </p>
      </div>

      <!-- Station Atmosphere & Status Plaque -->
      <div
        class="mt-8 flex flex-col gap-3 rounded-xl border border-[#c4b49d]/80 bg-[#fffdf8] p-5 sm:flex-row sm:items-center sm:justify-between"
      >
        <div class="flex items-center gap-2.5">
          <span class="relative flex size-3">
            <span
              class="absolute inline-flex h-full w-full animate-ping rounded-full bg-[#d49a48] opacity-75"
            ></span>
            <span class="relative inline-flex size-3 rounded-full bg-[#d49a48]"
            ></span>
          </span>
          <span
            class="font-sans text-xs font-bold tracking-[0.04em] text-[#2d332b] uppercase"
          >
            Passenger Notebook · Station Notes
          </span>
        </div>
        <p
          class="font-sans text-xs leading-relaxed text-[#5f665c] sm:max-w-[48ch] sm:text-right"
        >
          No algorithms, claps, or engagement metrics. Just thoughts penned in
          morning light while waiting for the next train.
        </p>
      </div>
    </div>
  </section>

  <!-- Curated Notes Index -->
  <div class="divide-y divide-[#c4b49d]">
    <!-- Ready to Read Notes -->
    <section
      class="bg-[#fffdf8] py-14 md:py-20"
      aria-labelledby="published-notes-title"
    >
      <div class={siteContainer}>
        <div class="mb-10 max-w-[48rem]">
          <h2
            id="published-notes-title"
            class="font-serif text-[clamp(2rem,3.8vw,3rem)] leading-[1.1] font-normal tracking-[-0.025em] text-[#2d332b]"
          >
            Notes on the Station Table
          </h2>
          <p class="mt-2.5 text-base leading-relaxed text-[#5f665c]">
            Complete reflections ready for an unhurried read. Step into any page
            and stay as long as you like.
          </p>
        </div>

        <div class="grid grid-cols-1 gap-8 md:grid-cols-2 lg:gap-10">
          {
            publishedThoughts.map((thought) => (
              <article class="flex flex-col justify-between rounded-2xl border border-[#c4b49d] bg-[#f7f2e8] p-6 transition-[border-color,box-shadow] duration-200 hover:border-[#b8614b] hover:shadow-[0_8px_24px_rgba(57,52,38,0.08)] sm:p-8">
                <div>
                  <div class="flex flex-wrap items-center justify-between gap-2 border-b border-[#c4b49d]/60 pb-3 text-xs">
                    <span class="inline-flex items-center gap-1.5 font-sans font-semibold text-[#6c895f]">
                      <span class="size-1.5 rounded-full bg-[#6c895f]" />
                      <span>{thought.poeticContext}</span>
                    </span>
                    <span class="font-sans text-[#5f665c]">
                      {thought.date} · {thought.topic}
                    </span>
                  </div>

                  <h3 class="mt-4 font-serif text-[clamp(1.4rem,2.4vw,1.85rem)] leading-[1.2] font-normal tracking-[-0.02em] text-[#2d332b]">
                    <a
                      href={`/thoughts/${thought.slug}`}
                      class="text-[#2d332b] no-underline transition-colors hover:text-[#b8614b] focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-[#b8614b]"
                    >
                      {thought.title}
                    </a>
                  </h3>

                  <p class="mt-2.5 font-sans text-xs text-[#5f665c] italic">
                    Atmosphere: {thought.sensoryWeather}
                  </p>

                  <p class="mt-4 text-sm leading-[1.68] text-[#2d332b]">
                    {thought.excerpt}
                  </p>
                </div>

                <div class="mt-8 pt-4">
                  <a
                    href={`/thoughts/${thought.slug}`}
                    class="inline-flex min-h-11 items-center gap-2 font-sans text-xs font-bold text-[#b8614b] underline decoration-[#b8614b] decoration-1 underline-offset-4 transition-colors hover:text-[#843d2f] focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-[#b8614b]"
                  >
                    <span>Read passenger note</span>
                    <span aria-hidden="true">&rarr;</span>
                  </a>
                </div>
              </article>
            ))
          }
        </div>
      </div>
    </section>

    <!-- Notes in Preparation -->
    {
      inPrepThoughts.length > 0 && (
        <section
          class="bg-[#f7f2e8] py-14 md:py-20"
          aria-labelledby="in-prep-title"
        >
          <div class={siteContainer}>
            <div class="mb-10 max-w-[48rem]">
              <h2
                id="in-prep-title"
                class="font-serif text-[clamp(1.8rem,3.2vw,2.4rem)] leading-[1.15] font-normal tracking-[-0.02em] text-[#2d332b]"
              >
                Drafted at the Corner Desk
              </h2>
              <p class="mt-2.5 text-base leading-relaxed text-[#5f665c]">
                Reflections currently in progress. These notes will be placed on
                the table when they are settled.
              </p>
            </div>

            <div class="grid grid-cols-1 gap-6 md:grid-cols-2">
              {inPrepThoughts.map((thought) => (
                <article class="flex flex-col justify-between rounded-xl border border-dashed border-[#c4b49d] bg-[#fffdf8]/70 p-6 sm:p-7">
                  <div>
                    <div class="flex flex-wrap items-center justify-between gap-2 border-b border-[#c4b49d]/50 pb-2.5 text-xs">
                      <span class="inline-flex items-center gap-1.5 font-sans font-semibold text-[#b8614b]">
                        <span class="size-1.5 rounded-full bg-[#b8614b]" />
                        <span>{thought.statusLabel}</span>
                      </span>
                      <span class="font-sans text-[#5f665c]">
                        {thought.date} · {thought.topic}
                      </span>
                    </div>

                    <h3 class="mt-3.5 font-serif text-xl leading-snug font-normal text-[#2d332b]">
                      {thought.title}
                    </h3>

                    <p class="mt-2 font-sans text-xs text-[#5f665c] italic">
                      {thought.sensoryWeather}
                    </p>

                    <p class="mt-3 text-xs leading-relaxed text-[#5f665c]">
                      {thought.excerpt}
                    </p>
                  </div>

                  <div class="mt-6 flex items-center gap-2 pt-3 font-sans text-xs font-semibold text-[#5f665c]">
                    <span class="size-2 rounded-full bg-[#c4b49d]" />
                    <span>Pen in hand · Coming soon</span>
                  </div>
                </article>
              ))}
            </div>
          </div>
        </section>
      )
    }

    <!-- Station Wayfinding Signpost -->
    <section class="bg-[#fffdf8] py-14 md:py-16">
      <div class={siteContainer}>
        <div
          class="rounded-2xl border border-[#c4b49d] bg-[#f7f2e8] p-8 md:p-10"
        >
          <div
            class="flex flex-col gap-6 md:flex-row md:items-center md:justify-between"
          >
            <div class="max-w-[42ch]">
              <h2
                class="font-serif text-2xl font-normal tracking-[-0.02em] text-[#2d332b]"
              >
                Wander further down the line
              </h2>
              <p class="mt-2 text-sm leading-relaxed text-[#5f665c]">
                The station tracks lead to cultivated software plots, workshop
                benches, and personal introductions.
              </p>
            </div>

            <div class="flex flex-wrap items-center gap-3">
              <a
                href="/"
                class="inline-flex min-h-11 items-center gap-2 rounded-lg border border-[#c4b49d] bg-[#fffdf8] px-4 py-2.5 font-sans text-xs font-bold text-[#2d332b] transition-colors hover:border-[#b8614b] hover:text-[#b8614b] focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-[#b8614b]"
              >
                <span>Station Platform</span>
                <span aria-hidden="true">&rarr;</span>
              </a>
              <a
                href="/projects"
                class="inline-flex min-h-11 items-center gap-2 rounded-lg border border-[#c4b49d] bg-[#fffdf8] px-4 py-2.5 font-sans text-xs font-bold text-[#2d332b] transition-colors hover:border-[#b8614b] hover:text-[#b8614b] focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-[#b8614b]"
              >
                <span>Rice Fields (Projects)</span>
                <span aria-hidden="true">&rarr;</span>
              </a>
              <a
                href="/workshop"
                class="inline-flex min-h-11 items-center gap-2 rounded-lg border border-[#c4b49d] bg-[#fffdf8] px-4 py-2.5 font-sans text-xs font-bold text-[#2d332b] transition-colors hover:border-[#b8614b] hover:text-[#b8614b] focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-[#b8614b]"
              >
                <span>The Workshop (Offers)</span>
                <span aria-hidden="true">&rarr;</span>
              </a>
            </div>
          </div>
        </div>
      </div>
    </section>
  </div>
</MainLayout>
