---
import { siteContainer } from "../../components/layout/container";
import MainLayout from "../../components/layout/MainLayout.astro";
import StationStopSection from "../../components/station/StationStopSection.astro";
import { projects, type Project } from "../../data/projects";
import { site, canonicalUrl } from "../../data/site";

export function getStaticPaths() {
  return projects.map((project) => ({
    params: { slug: project.slug },
    props: { project },
  }));
}

interface Props {
  project: Project;
}

const { project } = Astro.props;

// Calculate next project in order
const currentIndex = projects.findIndex((p) => p.slug === project.slug);
const nextProject = projects[(currentIndex + 1) % projects.length];

const pageUrl = canonicalUrl(`/projects/${project.slug}`);

const projectJsonLd = {
  "@type": "SoftwareApplication",
  "@id": `${pageUrl}#software`,
  name: project.title,
  alternateName: project.poeticTitle,
  description: project.summary,
  abstract: project.tagline,
  keywords: project.technologies.join(", "),
  author: { "@id": `${site.url}/#person` },
  creator: { "@id": `${site.url}/#person` },
  inLanguage: site.language,
  mainEntityOfPage: pageUrl,
  ...(project.liveUrl ? { url: project.liveUrl } : {}),
  ...(project.repoUrl ? { codeRepository: project.repoUrl } : {}),
};
---

<MainLayout
  title={project.seoTitle}
  description={project.seoDescription}
  currentRoute={`/projects/${project.slug}`}
  ogType="article"
  pageType="ItemPage"
  breadcrumbs={[
    { name: "Station Platform", path: "/" },
    { name: "Rice Fields (Projects)", path: "/projects" },
    { name: project.title, path: `/projects/${project.slug}` },
  ]}
  jsonLd={projectJsonLd}
>
  <!-- Route Sign & Return Breadcrumb -->
  <section class="border-b border-[#c4b49d] bg-[#f7f2e8] pt-10 pb-8 md:pt-14">
    <div class={siteContainer}>
      <nav
        aria-label="Route wayfinding"
        class="flex flex-wrap items-center gap-2 font-sans text-xs font-semibold tracking-[0.03em] text-[#5f665c]"
      >
        <a
          href="/"
          class="inline-flex min-h-11 items-center text-[#5f665c] underline decoration-[#c4b49d] decoration-1 underline-offset-4 transition-colors hover:text-[#b8614b] hover:decoration-[#b8614b] focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-[#b8614b]"
        >
          Station Platform
        </a>
        <span aria-hidden="true" class="text-[#c4b49d]">/</span>
        <a
          href="/projects"
          class="inline-flex min-h-11 items-center text-[#5f665c] underline decoration-[#c4b49d] decoration-1 underline-offset-4 transition-colors hover:text-[#b8614b] hover:decoration-[#b8614b] focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-[#b8614b]"
        >
          Rice Fields
        </a>
        <span aria-hidden="true" class="text-[#c4b49d]">/</span>
        <span class="text-[#2d332b]" aria-current="page">{project.title}</span>
      </nav>

      <!-- Project Header -->
      <div class="mt-6 max-w-[52rem]">
        <div class="flex flex-wrap items-center gap-3 pb-3">
          <span
            class="inline-flex items-center gap-1.5 rounded-full border border-[#c4b49d] bg-[#fffdf8] px-3 py-1 font-sans text-xs font-semibold tracking-[0.03em] text-[#2d332b]"
          >
            <span
              class:list={[
                "size-2 rounded-full",
                project.status === "tended" ? "bg-[#6c895f]" : "bg-[#d49a48]",
              ]}
              aria-hidden="true"></span>
            <span>{project.statusLabel}</span>
          </span>

          <span class="font-sans text-xs text-[#5f665c]">
            {project.timeline}
          </span>
        </div>

        <h1
          class="font-serif text-[clamp(2.5rem,5.5vw,4.5rem)] leading-[1.05] font-normal tracking-[-0.03em] text-[#2d332b]"
        >
          {project.title}
        </h1>

        <p
          class="mt-4 max-w-[65ch] font-serif text-[clamp(1.15rem,2.2vw,1.4rem)] leading-[1.45] text-[#5f665c]"
        >
          {project.tagline}
        </p>

        <!-- Meta info: Role & Live Links -->
        <div
          class="mt-8 flex flex-wrap items-center justify-between gap-4 border-t border-[#c4b49d]/60 pt-6"
        >
          <div class="space-y-1">
            <span
              class="block font-sans text-xs font-semibold tracking-[0.05em] text-[#5f665c] uppercase"
            >
              Role &amp; Context
            </span>
            <span class="font-medium text-[#2d332b]">{project.role}</span>
          </div>

          <div class="flex flex-wrap items-center gap-3">
            {
              project.liveUrl && (
                <a
                  href={project.liveUrl}
                  target="_blank"
                  rel="noopener noreferrer"
                  class="group inline-flex min-h-11 items-center gap-2 rounded-lg border border-[#c4b49d] bg-[#fffdf8] px-4 py-2 text-xs font-bold tracking-[0.03em] text-[#2d332b] shadow-xs transition-colors hover:border-[#b8614b] hover:text-[#b8614b] focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-[#b8614b]"
                >
                  <span>Visit Deployment</span>
                  <svg
                    class="size-3.5 fill-none [stroke:currentColor] [stroke-width:2] transition-transform group-hover:translate-x-0.5 group-hover:-translate-y-0.5 motion-reduce:transform-none"
                    viewBox="0 0 24 24"
                    aria-hidden="true"
                  >
                    <path d="M18 13v6a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h6M15 3h6v6M10 14L21 3" />
                  </svg>
                </a>
              )
            }
            {
              project.repoUrl && (
                <a
                  href={project.repoUrl}
                  target="_blank"
                  rel="noopener noreferrer"
                  class="inline-flex min-h-11 items-center gap-2 rounded-lg border border-[#c4b49d] bg-[#fffdf8] px-4 py-2 text-xs font-bold tracking-[0.03em] text-[#2d332b] shadow-xs transition-colors hover:border-[#b8614b] hover:text-[#b8614b] focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-[#b8614b]"
                >
                  <span>GitHub Repository</span>
                  <svg
                    class="size-3.5 fill-none [stroke:currentColor] [stroke-width:2]"
                    viewBox="0 0 24 24"
                    aria-hidden="true"
                  >
                    <path d="M9 19c-5 1.5-5-2.5-7-3m14 6v-3.87a3.37 3.37 0 0 0-.94-2.61c3.14-.35 6.44-1.54 6.44-7A5.44 5.44 0 0 0 20 4.77 5.07 5.07 0 0 0 19.91 1S18.73.65 16 2.48a13.38 13.38 0 0 0-7 0C6.27.65 5.09 1 5.09 1A5.07 5.07 0 0 0 5 4.77a5.44 5.44 0 0 0-1.5 3.78c0 5.42 3.3 6.61 6.44 7A3.37 3.37 0 0 0 9 18.13V22" />
                  </svg>
                </a>
              )
            }
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- Section 1: What is this? -->
  <section
    class="border-b border-[#c4b49d] bg-[#fffdf8] py-14 md:py-18"
    aria-labelledby="what-is-this-title"
  >
    <div class={siteContainer}>
      <div
        class="grid grid-cols-1 gap-8 lg:grid-cols-[minmax(0,0.4fr)_minmax(0,1fr)] lg:gap-16"
      >
        <div>
          <h2
            id="what-is-this-title"
            class="font-serif text-[clamp(1.8rem,3vw,2.5rem)] leading-[1.15] font-normal tracking-[-0.025em] text-[#2d332b]"
          >
            What is this system?
          </h2>
          <p class="mt-3 text-sm leading-relaxed text-[#5f665c]">
            A plain explanation of the project, its scope, and the real tasks it
            carries out.
          </p>
        </div>

        <div
          class="max-w-[68ch] space-y-5 text-base leading-[1.68] text-[#2d332b]"
        >
          {project.whatIsThis.map((paragraph) => <p>{paragraph}</p>)}

          <div class="pt-4">
            <h3
              class="font-sans text-xs font-semibold tracking-[0.05em] text-[#5f665c] uppercase"
            >
              Primary Technologies
            </h3>
            <div class="mt-3 flex flex-wrap gap-2">
              {
                project.technologies.map((tech) => (
                  <span class="rounded-md border border-[#c4b49d]/60 bg-[#f7f2e8] px-2.5 py-1 font-sans text-xs font-medium text-[#2d332b]">
                    {tech}
                  </span>
                ))
              }
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- Section 2: Why did it need to exist? -->
  <section
    class="border-b border-[#c4b49d] bg-[#f7f2e8] py-14 md:py-18"
    aria-labelledby="why-it-existed-title"
  >
    <div class={siteContainer}>
      <div
        class="grid grid-cols-1 gap-8 lg:grid-cols-[minmax(0,0.4fr)_minmax(0,1fr)] lg:gap-16"
      >
        <div>
          <h2
            id="why-it-existed-title"
            class="font-serif text-[clamp(1.8rem,3vw,2.5rem)] leading-[1.15] font-normal tracking-[-0.025em] text-[#2d332b]"
          >
            Why did it need to exist?
          </h2>
          <p class="mt-3 text-sm leading-relaxed text-[#5f665c]">
            The practical friction, human fatigue, or operational constraints
            that demanded this solution.
          </p>
        </div>

        <div
          class="max-w-[68ch] space-y-5 text-base leading-[1.68] text-[#2d332b]"
        >
          {project.whyItExisted.map((paragraph) => <p>{paragraph}</p>)}
        </div>
      </div>
    </div>
  </section>

  <!-- Section 3: Technical Craft & Architecture -->
  <section
    class="border-b border-[#c4b49d] bg-[#fffdf8] py-14 md:py-18"
    aria-labelledby="technical-craft-title"
  >
    <div class={siteContainer}>
      <div
        class="grid grid-cols-1 gap-8 lg:grid-cols-[minmax(0,0.4fr)_minmax(0,1fr)] lg:gap-16"
      >
        <div>
          <h2
            id="technical-craft-title"
            class="font-serif text-[clamp(1.8rem,3vw,2.5rem)] leading-[1.15] font-normal tracking-[-0.025em] text-[#2d332b]"
          >
            Technical Craft &amp; Architecture
          </h2>
          <p class="mt-3 text-sm leading-relaxed text-[#5f665c]">
            Engineering decisions, query plans, containerization, and measured
            benchmarks.
          </p>

          <div
            class="mt-6 rounded-xl border border-[#c4b49d]/70 bg-[#dce7c9]/40 p-5"
          >
            <h3
              class="font-sans text-xs font-bold tracking-[0.04em] text-[#2d332b] uppercase"
            >
              Field Benchmark
            </h3>
            <p class="mt-2 text-sm leading-relaxed text-[#5f665c]">
              {project.metricsSummary}
            </p>
          </div>
        </div>

        <div class="space-y-8">
          <p class="max-w-[68ch] text-base leading-[1.68] text-[#2d332b]">
            {project.technicalCraft.overview}
          </p>

          <!-- Highlights -->
          <div class="grid grid-cols-1 gap-4 sm:grid-cols-2">
            {
              project.technicalCraft.highlights.map((highlight) => (
                <div class="rounded-xl border border-[#c4b49d]/70 bg-[#f7f2e8] p-5">
                  <h3 class="font-serif text-lg font-normal text-[#2d332b]">
                    {highlight.label}
                  </h3>
                  <p class="mt-2 text-sm leading-relaxed text-[#5f665c]">
                    {highlight.detail}
                  </p>
                </div>
              ))
            }
          </div>

          <!-- Deep Dive Points -->
          <div
            class="border-t border-[#c4b49d]/60 pt-6"
            aria-label="Architectural details"
          >
            <h3
              class="font-sans text-xs font-semibold tracking-[0.05em] text-[#5f665c] uppercase"
            >
              Implementation Notes
            </h3>
            <ul
              class="mt-4 space-y-3 pl-5 text-sm leading-relaxed text-[#2d332b]"
            >
              {
                project.technicalCraft.deepDive.map((item) => (
                  <li class="list-disc marker:text-[#b8614b]">{item}</li>
                ))
              }
            </ul>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- Section 4: Atmosphere & Feeling -->
  <section
    class="border-b border-[#c4b49d] bg-[#f7f2e8] py-14 md:py-16"
    aria-labelledby="atmosphere-title"
  >
    <div class={siteContainer}>
      <div
        class="grid grid-cols-1 gap-8 lg:grid-cols-[minmax(0,0.4fr)_minmax(0,1fr)] lg:gap-16"
      >
        <div>
          <h2
            id="atmosphere-title"
            class="font-serif text-[clamp(1.8rem,3vw,2.5rem)] leading-[1.15] font-normal tracking-[-0.025em] text-[#2d332b]"
          >
            Atmosphere &amp; Feeling
          </h2>
          <p class="mt-3 text-sm leading-relaxed text-[#5f665c]">
            How the project feels in production: its sensory texture and quiet
            rhythm.
          </p>
        </div>

        <div class="max-w-[68ch]">
          <blockquote
            class="rounded-xl border border-[#c4b49d] bg-[#fffdf8] p-6 text-base leading-[1.7] text-[#2d332b] italic"
          >
            &ldquo;{project.atmosphere}&rdquo;
          </blockquote>
        </div>
      </div>
    </div>
  </section>

  <!-- Section 5: Field Note & Return Rail -->
  <section
    class="bg-[#fffdf8] py-14 md:py-20"
    aria-labelledby="return-rail-title"
  >
    <div class={siteContainer}>
      <div class="mx-auto max-w-[48rem] text-center">
        <span
          class="inline-block size-3 rounded-full bg-[#b8614b]"
          aria-hidden="true"></span>
        <h2
          id="return-rail-title"
          class="mt-4 font-serif text-[clamp(2rem,4vw,3rem)] leading-[1.1] font-normal tracking-[-0.025em] text-[#2d332b]"
        >
          A Note from the Field
        </h2>
        <p
          class="mx-auto mt-4 max-w-[60ch] text-base leading-[1.7] text-[#5f665c]"
        >
          {project.fieldNote}
        </p>

        <!-- Navigation Paths -->
        <div
          class="mt-12 flex flex-wrap items-center justify-center gap-4 border-t border-[#c4b49d]/60 pt-8"
        >
          <a
            href="/projects"
            class="inline-flex min-h-11 items-center gap-2 rounded-lg border border-[#c4b49d] bg-[#f7f2e8] px-5 py-2.5 text-xs font-bold tracking-[0.03em] text-[#2d332b] transition-colors hover:border-[#b8614b] hover:text-[#b8614b] focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-[#b8614b]"
          >
            <svg
              class="size-3.5 fill-none [stroke:currentColor] [stroke-width:2]"
              viewBox="0 0 24 24"
              aria-hidden="true"
            >
              <path d="M19 12H5M12 19l-7-7 7-7"></path>
            </svg>
            <span>Back to Rice Fields</span>
          </a>

          <a
            href={`/projects/${nextProject.slug}`}
            class="inline-flex min-h-11 items-center gap-2 rounded-lg border border-[#b8614b] bg-[#fffdf8] px-5 py-2.5 text-xs font-bold tracking-[0.03em] text-[#b8614b] transition-colors hover:bg-[#b8614b] hover:text-[#fffdf8] focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-[#b8614b]"
          >
            <span>Next Field: {nextProject.title}</span>
            <svg
              class="size-3.5 fill-none [stroke:currentColor] [stroke-width:2]"
              viewBox="0 0 24 24"
              aria-hidden="true"
            >
              <path d="M5 12h14M12 5l7 7-7 7"></path>
            </svg>
          </a>

          <a
            href="/"
            class="inline-flex min-h-11 items-center gap-2 rounded-lg border border-transparent px-4 py-2.5 text-xs font-bold tracking-[0.03em] text-[#5f665c] underline decoration-[#c4b49d] decoration-1 underline-offset-4 transition-colors hover:text-[#2d332b] focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-[#b8614b]"
          >
            <span>Station Platform</span>
          </a>
        </div>
      </div>
    </div>
  </section>

  <!-- Station Stop Sign & Next Destinations -->
  <StationStopSection currentRoute="/projects" />
</MainLayout>
