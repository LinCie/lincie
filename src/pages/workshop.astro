---
import { siteContainer } from "../components/layout/container";
import MainLayout from "../components/layout/MainLayout.astro";
import StationStopSection from "../components/station/StationStopSection.astro";
import { site, canonicalUrl } from "../data/site";
---

<MainLayout
  title="Workshop | Backend APIs & Handcrafted Websites by LinCie"
  description="Backend engineering in Go and TypeScript, plus carefully crafted, anti-AI-slop websites. Built for speed, reliability, accessibility, and real workflows."
  currentRoute="/workshop"
  pageType="CollectionPage"
  breadcrumbs={[
    { name: "Station Platform", path: "/" },
    { name: "The Workshop (Offers)", path: "/workshop" },
  ]}
  jsonLd={{
    "@type": "ItemList",
    "@id": `${canonicalUrl("/workshop")}#services`,
    name: "Backend and web craft services offered by LinCie",
    itemListElement: [
      {
        "@type": "ListItem",
        position: 1,
        item: {
          "@type": "Service",
          name: "Backend & Systems Engineering",
          serviceType: "Backend engineering",
          description:
            "REST and gRPC API architecture, PostgreSQL database modeling and query tuning, and internal tools and business automation built in Go and TypeScript.",
          provider: { "@id": `${site.url}/#person` },
          areaServed: "Worldwide",
          url: canonicalUrl("/workshop"),
        },
      },
      {
        "@type": "ListItem",
        position: 2,
        item: {
          "@type": "Service",
          name: "Carefully Crafted Websites",
          serviceType: "Web design and development",
          description:
            "Hand-tuned, accessible, sub-second websites built with Astro and Tailwind CSS, with semantic HTML, WCAG 2.2 AA contrast, and SEO foundations included.",
          provider: { "@id": `${site.url}/#person` },
          areaServed: "Worldwide",
          url: canonicalUrl("/workshop"),
        },
      },
    ],
  }}
>
  <!-- Threshold & Wayfinding Banner -->
  <section
    class="border-b border-[#c4b49d] bg-[#f7f2e8] pt-10 pb-12 md:pt-16 md:pb-16"
  >
    <div class={siteContainer}>
      <nav
        aria-label="Route wayfinding"
        class="flex items-center gap-2 font-sans text-xs font-semibold tracking-[0.03em] text-[#5f665c]"
      >
        <a
          href="/"
          class="inline-flex min-h-11 items-center text-[#5f665c] underline decoration-[#c4b49d] decoration-1 underline-offset-4 transition-colors hover:text-[#b8614b] hover:decoration-[#b8614b] focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-[#b8614b]"
        >
          Station Platform
        </a>
        <span aria-hidden="true" class="text-[#c4b49d]">/</span>
        <span class="text-[#2d332b]" aria-current="page">The Workshop</span>
      </nav>

      <div class="mt-6 max-w-[72ch]">
        <h1
          class="font-serif text-[clamp(2.5rem,5.5vw,4.5rem)] leading-[1.05] font-normal tracking-[-0.03em] text-[#2d332b]"
        >
          The Workshop
        </h1>
        <p
          class="mt-4 font-serif text-[clamp(1.15rem,2.2vw,1.4rem)] leading-[1.45] text-[#5f665c]"
        >
          A quiet bench between tracks and rice fields, with tools resting in
          their grooves. I build reliable backend services and fast, custom
          websites without agency overhead.
        </p>
      </div>

      <!-- Workshop Philosophy & Status Plaque -->
      <div
        class="mt-8 flex flex-col gap-3 rounded-xl border border-[#c4b49d]/80 bg-[#fffdf8] p-5 sm:flex-row sm:items-center sm:justify-between"
      >
        <div class="flex items-center gap-2.5">
          <span class="relative flex size-3">
            <span
              class="absolute inline-flex h-full w-full animate-ping rounded-full bg-[#6c895f] opacity-75 motion-reduce:animate-none"
            ></span>
            <span class="relative inline-flex size-3 rounded-full bg-[#6c895f]"
            ></span>
          </span>
          <span
            class="font-sans text-xs font-bold tracking-[0.04em] text-[#2d332b] uppercase"
          >
            Open for selected projects
          </span>
        </div>
        <p
          class="font-sans text-xs leading-relaxed text-[#5f665c] sm:max-w-[48ch] sm:text-right"
        >
          You'll work directly with me, with clear limits on what I take on and
          plain answers about the work.
        </p>
      </div>
    </div>
  </section>

  <!-- Main Benches Landscape -->
  <div class="divide-y divide-[#c4b49d]">
    <!-- Bench 01: Backend & Developer Services -->
    <section id="backend" class="scroll-mt-12 bg-[#fffdf8] py-14 md:py-20">
      <div class={siteContainer}>
        <div
          class="grid grid-cols-1 gap-10 lg:grid-cols-[1.1fr_0.9fr] lg:gap-16"
        >
          <div>
            <div
              class="flex items-center gap-2 text-xs font-bold tracking-[0.04em] text-[#6c895f] uppercase"
            >
              <span>Bench 01</span>
              <span aria-hidden="true">·</span>
              <span>Developer services</span>
            </div>

            <h2
              class="mt-2 font-serif text-[clamp(2rem,3.8vw,3rem)] leading-[1.1] font-normal tracking-[-0.02em] text-[#2d332b]"
            >
              Backend &amp; systems engineering
            </h2>

            <p class="mt-4 text-base leading-[1.68] text-[#5f665c]">
              I build backend APIs, design database schemas, and make internal
              tools to replace manual spreadsheet work. The services need to
              handle high throughput, keep data consistent, and be
              straightforward to maintain.
            </p>

            <div class="mt-8 space-y-6">
              <div
                class="rounded-xl border border-[#c4b49d]/70 bg-[#f7f2e8] p-5"
              >
                <h3 class="font-serif text-lg font-normal text-[#2d332b]">
                  REST &amp; gRPC API architecture
                </h3>
                <p class="mt-2 text-sm leading-relaxed text-[#5f665c]">
                  APIs in Go and TypeScript, with clear endpoints, strict HTTP
                  semantics, type-safe payload validation, and predictable
                  errors. Frontend teams and integration developers can tell
                  what each request will return.
                </p>
              </div>

              <div
                class="rounded-xl border border-[#c4b49d]/70 bg-[#f7f2e8] p-5"
              >
                <h3 class="font-serif text-lg font-normal text-[#2d332b]">
                  Database modeling &amp; query tuning
                </h3>
                <p class="mt-2 text-sm leading-relaxed text-[#5f665c]">
                  For PostgreSQL, I design relational schemas and indexes and
                  tune type-safe queries with Kysely. I address slow queries and
                  eliminate N+1 latency before they become scaling problems, and
                  make sure concurrent writes are safe.
                </p>
              </div>

              <div
                class="rounded-xl border border-[#c4b49d]/70 bg-[#f7f2e8] p-5"
              >
                <h3 class="font-serif text-lg font-normal text-[#2d332b]">
                  Internal tools &amp; business automation
                </h3>
                <p class="mt-2 text-sm leading-relaxed text-[#5f665c]">
                  Custom ERP modules, inventory trackers, and admin dashboards
                  can replace fragile spreadsheets. I draw on my business
                  administration degree and experience moving enterprise
                  operations into custom software.
                </p>
              </div>
            </div>
          </div>

          <!-- Bench Spec Card & Evidence -->
          <div class="space-y-6">
            <div
              class="rounded-2xl border border-[#c4b49d] bg-[#f7f2e8] p-6 md:p-8"
            >
              <h3
                class="font-sans text-xs font-bold tracking-[0.06em] text-[#2d332b] uppercase"
              >
                Stack &amp; tools
              </h3>

              <div class="mt-4 flex flex-wrap gap-2">
                {
                  [
                    "Go",
                    "TypeScript",
                    "PostgreSQL",
                    "Kysely",
                    "Docker",
                    "Docker Compose",
                    "REST APIs",
                    "gRPC",
                    "Redis",
                    "Linux / Bash",
                  ].map((tech) => (
                    <span class="rounded-md border border-[#c4b49d]/70 bg-[#fffdf8] px-2.5 py-1 font-sans text-xs font-semibold text-[#2d332b]">
                      {tech}
                    </span>
                  ))
                }
              </div>

              <h3
                class="mt-8 font-sans text-xs font-bold tracking-[0.06em] text-[#2d332b] uppercase"
              >
                Training &amp; experience
              </h3>

              <div
                class="mt-3 space-y-3 text-sm leading-relaxed text-[#5f665c]"
              >
                <p>
                  I trained at <strong>Sea Labs Indonesia</strong> through the Shopee
                  backend fellowship. My work includes:
                </p>
                <ul class="list-disc space-y-2 pl-4 marker:text-[#6c895f]">
                  <li>
                    <strong>Bearuang POS &amp; ERP:</strong> Benchmarked at 2,000+
                    requests per minute against 1M+ seeded database rows, with query
                    response times under a second.
                  </li>
                  <li>
                    <strong>PT Haebot enterprise migration:</strong> I moved core
                    business operations from manual spreadsheets to a custom multi-tenant
                    management backend.
                  </li>
                </ul>
              </div>

              <div class="mt-6 border-t border-[#c4b49d]/60 pt-4">
                <a
                  href="/projects/bearuang"
                  class="inline-flex min-h-11 items-center gap-2 font-sans text-xs font-bold text-[#b8614b] underline decoration-[#b8614b] decoration-1 underline-offset-4 transition-colors hover:text-[#843d2f] focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-[#b8614b]"
                >
                  <span>Read about Bearuang</span>
                  <span aria-hidden="true">&rarr;</span>
                </a>
              </div>
            </div>

            <!-- Situational Fit Box -->
            <div class="rounded-xl border border-[#c4b49d]/70 bg-[#fffdf8] p-5">
              <span class="font-sans text-xs font-bold text-[#2d332b]">
                A good fit
              </span>
              <p class="mt-1.5 text-xs leading-relaxed text-[#5f665c]">
                You have a defined feature, a product idea, or a workflow that's
                slowing you down. You want sound database design, predictable
                APIs, and code you can take over.
              </p>
            </div>
          </div>
        </div>
      </div>
    </section>

    <!-- Bench 02: Carefully Crafted, Anti-AI-Slop Websites -->
    <section id="web-craft" class="scroll-mt-12 bg-[#f7f2e8] py-14 md:py-20">
      <div class={siteContainer}>
        <div
          class="grid grid-cols-1 gap-10 lg:grid-cols-[1.1fr_0.9fr] lg:gap-16"
        >
          <div>
            <div
              class="flex items-center gap-2 text-xs font-bold tracking-[0.04em] text-[#6c895f] uppercase"
            >
              <span>Bench 02</span>
              <span aria-hidden="true">·</span>
              <span>Web craft</span>
            </div>

            <h2
              class="mt-2 font-serif text-[clamp(2rem,3.8vw,3rem)] leading-[1.1] font-normal tracking-[-0.02em] text-[#2d332b]"
            >
              Websites built with care
            </h2>

            <p class="mt-4 text-base leading-[1.68] text-[#5f665c]">
              I build custom websites with their own look and feel. AI helps me
              deliver sooner and keep costs accessible, without thousands in
              agency markups. I handle the design and engineering so the site
              feels human and memorable, and performs well.
            </p>

            <!-- The Anti-Slop Pledge -->
            <div
              class="mt-8 rounded-2xl border border-[#c4b49d] bg-[#fffdf8] p-6 md:p-7"
            >
              <h3 class="font-serif text-xl font-normal text-[#2d332b]">
                How I use AI
              </h3>
              <p class="mt-2 text-sm leading-relaxed text-[#5f665c]">
                AI-built sites often share the same problems: generic corporate
                illustrations and copy, too much client-side JavaScript, layouts
                that break at different screen sizes, and text that's hard to
                read against its background. These are things I check and fix.
              </p>

              <div class="mt-5 grid grid-cols-1 gap-4 sm:grid-cols-2">
                <div
                  class="rounded-xl border border-[#c4b49d]/60 bg-[#f7f2e8] p-4"
                >
                  <span class="font-sans text-xs font-bold text-[#6c895f]">
                    Where AI helps
                  </span>
                  <p class="mt-1.5 text-xs leading-relaxed text-[#5f665c]">
                    I use AI to scaffold projects, reduce boilerplate, try
                    visual variations, and generate code quickly. That saves
                    hours and lowers the project cost.
                  </p>
                </div>

                <div
                  class="rounded-xl border border-[#c4b49d]/60 bg-[#f7f2e8] p-4"
                >
                  <span class="font-sans text-xs font-bold text-[#b8614b]">
                    What I handle
                  </span>
                  <p class="mt-1.5 text-xs leading-relaxed text-[#5f665c]">
                    I tune the typography and choose colors that work together,
                    with accessible contrast. I also take care of semantic
                    HTML5, strict performance budgets, and copy that sounds like
                    you.
                  </p>
                </div>
              </div>
            </div>
          </div>

          <!-- Web Craft Features & Deliverables -->
          <div class="space-y-6">
            <div
              class="rounded-2xl border border-[#c4b49d] bg-[#fffdf8] p-6 md:p-8"
            >
              <h3
                class="font-sans text-xs font-bold tracking-[0.06em] text-[#2d332b] uppercase"
              >
                Included in every build
              </h3>

              <div class="mt-4 space-y-4">
                <div class="border-b border-[#c4b49d]/40 pb-4">
                  <h4 class="font-sans text-sm font-bold text-[#2d332b]">
                    Load times under a second
                  </h4>
                  <p class="mt-1 text-xs leading-relaxed text-[#5f665c]">
                    Built with Astro or modern static tools, with runtime
                    JavaScript kept to a minimum and optimized WebP images so
                    the first content appears quickly.
                  </p>
                </div>

                <div class="border-b border-[#c4b49d]/40 pb-4">
                  <h4 class="font-sans text-sm font-bold text-[#2d332b]">
                    WCAG 2.2 AA accessibility &amp; mobile-first layouts
                  </h4>
                  <p class="mt-1 text-xs leading-relaxed text-[#5f665c]">
                    I test for touch targets of at least 44px, visible keyboard
                    focus rings, and semantic headings. I check that layouts
                    reflow across phones, tablets, and wide monitors.
                  </p>
                </div>

                <div>
                  <h4 class="font-sans text-sm font-bold text-[#2d332b]">
                    Search engine optimization (SEO) &amp; Open Graph
                  </h4>
                  <p class="mt-1 text-xs leading-relaxed text-[#5f665c]">
                    Meta tags, structured data, canonical URLs, and custom
                    social share cards are set up from the start.
                  </p>
                </div>
              </div>

              <div class="mt-6 border-t border-[#c4b49d]/60 pt-4">
                <span class="font-sans text-xs font-bold text-[#2d332b]">
                  A good fit for
                </span>
                <p class="mt-1 text-xs leading-relaxed text-[#5f665c]">
                  Personal portfolios, independent creative studios, developer
                  tools, publications, and local businesses.
                </p>
              </div>
            </div>
          </div>
        </div>
      </div>
    </section>

    <!-- Honest Boundaries Notice -->
    <section class="bg-[#fffdf8] py-14 md:py-18">
      <div class={siteContainer}>
        <div
          class="rounded-2xl border border-[#c4b49d] bg-[#e9ddc9]/40 p-6 md:p-10"
        >
          <div class="max-w-[70ch]">
            <div
              class="flex items-center gap-2 text-xs font-bold tracking-[0.04em] text-[#843d2f] uppercase"
            >
              <span class="size-2 rounded-full bg-[#b8614b]"></span>
              <span>Workshop boundaries</span>
            </div>

            <h2
              class="mt-2 font-serif text-[clamp(1.8rem,3vw,2.5rem)] leading-[1.15] font-normal tracking-[-0.02em] text-[#2d332b]"
            >
              What stays outside this shop
            </h2>

            <p class="mt-3 text-base leading-[1.65] text-[#5f665c]">
              I limit the work I take on so I can give each project the
              attention it needs. These are the limits to know before we start.
            </p>
          </div>

          <div
            class="mt-8 grid grid-cols-1 gap-6 sm:grid-cols-2 lg:grid-cols-3"
          >
            <div class="rounded-xl border border-[#c4b49d]/80 bg-[#fffdf8] p-5">
              <h3 class="font-sans text-sm font-bold text-[#2d332b]">
                No 24/7 on-call rotations
              </h3>
              <p class="mt-2 text-xs leading-relaxed text-[#5f665c]">
                I build and thoroughly test systems to withstand failures and
                recover on their own. I don't provide round-the-clock emergency
                support or take on-call shifts.
              </p>
            </div>

            <div class="rounded-xl border border-[#c4b49d]/80 bg-[#fffdf8] p-5">
              <h3 class="font-sans text-sm font-bold text-[#2d332b]">
                No high-risk legacy migrations
              </h3>
              <p class="mt-2 text-xs leading-relaxed text-[#5f665c]">
                I focus on new services, API expansions with a defined scope,
                and clean rebuilds. I don't take on undocumented legacy database
                rescues or untangle monoliths without clear specifications.
              </p>
            </div>

            <div
              class="rounded-xl border border-[#c4b49d]/80 bg-[#fffdf8] p-5 sm:col-span-2 lg:col-span-1"
            >
              <h3 class="font-sans text-sm font-bold text-[#2d332b]">
                No artificial sales pressure
              </h3>
              <p class="mt-2 text-xs leading-relaxed text-[#5f665c]">
                I don't lock you into tiered subscriptions or use false urgency
                timers. If the project suits us both, we agree on the
                deliverables before I start building.
              </p>
            </div>
          </div>
        </div>
      </div>
    </section>

    <!-- Quiet Bridge to the Letterbox -->
    <section class="bg-[#f7f2e8] py-14 md:py-20">
      <div class={siteContainer}>
        <div
          class="rounded-2xl border border-[#c4b49d] bg-[#fffdf8] p-8 md:p-12"
        >
          <div class="max-w-[65ch]">
            <h2
              class="font-serif text-[clamp(2rem,3.5vw,2.8rem)] leading-[1.1] font-normal tracking-[-0.02em] text-[#2d332b]"
            >
              What are you working on?
            </h2>

            <p class="mt-4 text-base leading-[1.68] text-[#5f665c]">
              Send me your API specification, tell me about a workflow you want
              to fix, or describe the custom website you need. We can talk
              through the work from there.
            </p>

            <div class="mt-6 space-y-2">
              <p class="font-sans text-xs font-bold text-[#2d332b]">
                You could start with:
              </p>
              <ul
                class="list-disc space-y-1.5 pl-4 text-xs text-[#5f665c] marker:text-[#b8614b]"
              >
                <li>
                  <em
                    >"I need a backend API or database schema built in Go or
                    TypeScript."</em
                  >
                </li>
                <li>
                  <em
                    >"I want a fast, distinct website built without generic
                    agency bloat."</em
                  >
                </li>
                <li>
                  <em
                    >"We have a spreadsheet workflow that needs to become a
                    reliable internal tool."</em
                  >
                </li>
              </ul>
            </div>

            <div class="mt-8 flex flex-wrap items-center gap-4">
              <a
                href="/connect"
                class="inline-flex min-h-12 items-center justify-center rounded-lg border border-[#b8614b] bg-[#b8614b] px-6 py-3 font-sans text-sm font-bold text-[#fffdf8] shadow-sm transition-[background-color,transform] hover:bg-[#843d2f] focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-[#b8614b] active:scale-[0.98]"
              >
                <span>Leave a note at the Letterbox</span>
                <span aria-hidden="true" class="ml-2">&rarr;</span>
              </a>

              <a
                href="/"
                class="inline-flex min-h-12 items-center justify-center rounded-lg border border-[#c4b49d] bg-[#fffdf8] px-5 py-3 font-sans text-sm font-semibold text-[#2d332b] transition-colors hover:border-[#2d332b] focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-[#b8614b]"
              >
                <span>Return to Station Platform</span>
              </a>
            </div>
          </div>
        </div>
      </div>
    </section>
  </div>

  <!-- Station Stop Sign & Next Destinations -->
  <StationStopSection currentRoute="/workshop" />
</MainLayout>
