        </h2>
        <p class="mt-3 max-w-[40rem] text-base leading-[1.6] text-[#5f665c]">
          There is no tour to finish and nothing to keep up with. Come back when
          you feel like wandering again.
        </p>
      </div>
      <a
        class="inline-flex min-h-11 items-center gap-[.45rem] font-sans text-[.8125rem] font-bold text-[#2d332b] underline decoration-[#b8614b] decoration-1 underline-offset-[.3rem] transition-[color,gap] duration-200 ease-out hover:gap-[.7rem] hover:text-[#843d2f] motion-reduce:transition-none max-[760px]:col-start-2 max-[760px]:justify-self-start max-[480px]:col-start-1"
        href="#main-content"
      >
        <span>Back to the platform</span>
        <span
          class="grid size-[1.3rem] shrink-0 place-items-center text-[#b8614b]"
          aria-hidden="true"
        >
          <svg
            class="block size-4 fill-none [stroke:currentColor] [stroke-width:1.5] [stroke-linecap:round] [stroke-linejoin:round]"
            viewBox="0 0 20 20"
          >
            <path d="M3 10h13M10 4l6 6-6 6"></path>
          </svg>
        </span>
      </a>
    </div>
  </section>
</MainLayout>

<style>
  [data-arrival] {
    transition: background-color 1s ease-out;
  }
  [data-arrival][data-sky="dusk"] #board {
    box-shadow:
      0 16px 36px rgba(57, 52, 38, 0.18),
      0 -4px 22px rgba(212, 154, 72, 0.22);
  }
  [data-arrival][data-sky="night"] #board {
    box-shadow:
      0 16px 40px rgba(18, 22, 24, 0.38),
      0 -6px 30px rgba(240, 184, 110, 0.32);
  }
</style>

<script>
  import gsap from "gsap";
  import ScrollTrigger from "gsap/ScrollTrigger";
  import DrawSVGPlugin from "gsap/DrawSVGPlugin";
  import MotionPathPlugin from "gsap/MotionPathPlugin";

  gsap.registerPlugin(ScrollTrigger, DrawSVGPlugin, MotionPathPlugin);

  type SkyMode = "morning" | "midday" | "dusk" | "night";

  const skyConfigs: Record<
    SkyMode,
    {
      time: string;
      label: string;
      announcement: string;
      noticeNote: string;
      bgColor: string;
      imgFilter: string;
      sun: { x: number; y: number; alpha: number };
      moonAlpha: number;
      starsAlpha: number;
      lanternAlpha: number;
      trainWindow: string;
    }
  > = {
    morning: {
      time: "07:00",
      label: "Morning",
      announcement:
        "Station atmosphere set to Morning, 07:00. Dewy morning mist and soft golden sun.",
      noticeNote:
        "The doors below are unlocked and tended. The morning air is crisp and quiet across the platform.",
      bgColor: "#c9e0e2",
      imgFilter: "brightness(1.02) saturate(1.02)",
      sun: { x: 0, y: 0, alpha: 1 },
      moonAlpha: 0,
      starsAlpha: 0,
      lanternAlpha: 0,
      trainWindow: "#e9ddc9",
    },
    midday: {
      time: "12:00",
      label: "Midday",
      announcement:
        "Station atmosphere set to Midday, 12:00. Clear high sun over the countryside.",
      noticeNote:
        "The doors below are unlocked and tended. High sun over the rice fields; take your time wandering.",
      bgColor: "#bde0ea",
      imgFilter: "brightness(1.06) saturate(1.08) contrast(1.02)",
      sun: { x: -210, y: -50, alpha: 1 },
      moonAlpha: 0,
      starsAlpha: 0,
      lanternAlpha: 0,
      trainWindow: "#e9ddc9",
    },
    dusk: {
      time: "17:30",
      label: "Sunset",
      announcement:
        "Station atmosphere set to Sunset, 17:30. Warm terracotta golden hour and amber tracks.",
      noticeNote:
        "The doors below are unlocked and tended. Golden hour settles across the tracks; unhurried wandering.",
      bgColor: "#dfa684",
      imgFilter:
        "sepia(0.24) saturate(1.25) brightness(0.96) hue-rotate(-12deg)",
      sun: { x: -390, y: 136, alpha: 1 },
      moonAlpha: 0,
      starsAlpha: 0,
      lanternAlpha: 0.55,
      trainWindow: "#ffd479",
    },
    night: {
      time: "21:00",
      label: "Night",
      announcement:
        "Station atmosphere set to Night, 21:00. Quiet indigo night, crescent moon, and platform lanterns.",
      noticeNote:
        "The doors below are unlocked and tended. Platform lanterns are lit; stay and wander as long as you like.",
      bgColor: "#242f36",
      imgFilter:
        "brightness(0.68) contrast(1.15) saturate(0.85) hue-rotate(185deg)",
      sun: { x: 0, y: 0, alpha: 0 },
      moonAlpha: 1,
      starsAlpha: 0.85,
      lanternAlpha: 1,
      trainWindow: "#fff0a8",
    },
  };

  let motion: gsap.MatchMedia | null = null;
  let trainTimeline: gsap.core.Timeline | null = null;
  let starTwinkleTimeline: gsap.core.Tween | null = null;
  let observer: IntersectionObserver | null = null;
  let abortController: AbortController | null = null;
  let isLive = false;

  document.addEventListener("astro:before-swap", () => {
    ScrollTrigger.getAll().forEach((trigger) => trigger.kill());
    if (motion) {
      motion.revert();
      motion = null;
    }
    if (trainTimeline) {
      trainTimeline.kill();
      trainTimeline = null;
    }
    if (starTwinkleTimeline) {
      starTwinkleTimeline.kill();
      starTwinkleTimeline = null;
    }
    if (observer) {
      observer.disconnect();
      observer = null;
    }
    if (abortController) {
      abortController.abort();
      abortController = null;
    }
  });

  document.addEventListener("astro:page-load", () => {
    const arrival = document.querySelector<HTMLElement>("[data-arrival]");
    if (!arrival) return;

    ScrollTrigger.getAll().forEach((trigger) => trigger.kill());
    if (motion) {
      motion.revert();
    }
    if (trainTimeline) {
      trainTimeline.kill();
      trainTimeline = null;
    }
    if (starTwinkleTimeline) {
      starTwinkleTimeline.kill();
      starTwinkleTimeline = null;
    }
    if (observer) {
      observer.disconnect();
      observer = null;
    }
    if (abortController) {
      abortController.abort();
    }
    abortController = new AbortController();
    const { signal } = abortController;

    const sceneImage = arrival.querySelector<HTMLImageElement>(
      "[data-arrival-image]",
    );
    const sun = arrival.querySelector<SVGGElement>("[data-arrival-sun]");
    const moon = arrival.querySelector<SVGGElement>("[data-arrival-moon]");
    const stars = arrival.querySelector<SVGGElement>("[data-arrival-stars]");
    const lantern = arrival.querySelector<SVGCircleElement>(
      "[data-arrival-lantern]",
    );
    const stop = arrival.querySelector<SVGGElement>("[data-arrival-stop]");
    const drawPaths = arrival.querySelectorAll<SVGElement>(
      "[data-arrival-draw]",
    );
    const train = arrival.querySelector<SVGGElement>("[data-arrival-train]");
    const trainWindows = arrival.querySelectorAll<SVGRectElement>(
      "[data-train-window]",
    );
    const skyLayers = arrival.querySelectorAll<HTMLElement>("[data-sky-layer]");
    const location = arrival.querySelector<HTMLElement>(
      "[data-arrival-location]",
    );
    const title = arrival.querySelector<HTMLElement>("[data-arrival-title]");
    const copy = arrival.querySelector<HTMLElement>("[data-arrival-copy]");
    const note = arrival.querySelector<HTMLElement>("[data-arrival-note]");
    const notice = arrival.querySelector<HTMLElement>("[data-arrival-notice]");
    const noticeNote = arrival.querySelector<HTMLElement>(
      "[data-arrival-notice-note]",
    );
    const board = arrival.querySelector<HTMLElement>("[data-arrival-board]");
    const routes = arrival.querySelectorAll<HTMLElement>(
      "[data-arrival-route]",
    );
    const gestures = arrival.querySelectorAll<HTMLElement>(
      "[data-arrival-gesture]",
    );

    // Solar Clock controls
    const clockContainer = arrival.querySelector<HTMLElement>(
      "[data-station-clock]",
    );
    const timeButtons =
      arrival.querySelectorAll<HTMLButtonElement>("[data-time-btn]");
    const liveButtons =
      arrival.querySelectorAll<HTMLButtonElement>("[data-time-live]");
    const clockTimeDisplay = arrival.querySelector<HTMLElement>(
      "[data-clock-current-time]",
    );
    const announcementEl = arrival.querySelector<HTMLElement>(
      "[data-clock-announcement]",
    );

    let currentMode: SkyMode =
      (sessionStorage.getItem("lincie-station-sky") as SkyMode) || "morning";
    if (!skyConfigs[currentMode]) currentMode = "morning";

    function updateControlStates(mode: SkyMode, customTime?: string) {
      const cfg = skyConfigs[mode];
      if (clockTimeDisplay) {
        clockTimeDisplay.textContent = customTime || cfg.time;
      }
      if (announcementEl) {
        announcementEl.textContent = cfg.announcement;
      }
      if (noticeNote) {
        noticeNote.textContent = cfg.noticeNote;
      }

      timeButtons.forEach((btn) => {
        const btnMode = btn.getAttribute("data-time-btn") as SkyMode;
        const isSelected = btnMode === mode && !isLive;
        btn.setAttribute("aria-checked", isSelected ? "true" : "false");
        const indicator = btn.querySelector("[data-btn-indicator]");

        if (isSelected) {
          btn.classList.add(
            "border-[#b8614b]/60",
            "bg-[#e9ddc9]",
            "font-semibold",
            "text-[#2d332b]",
            "shadow-xs",
          );
          btn.classList.remove("border-transparent", "text-[#5f665c]");
          indicator?.classList.add("bg-[#b8614b]");
          indicator?.classList.remove("bg-[#c4b49d]");
        } else {
          btn.classList.remove(
            "border-[#b8614b]/60",
            "bg-[#e9ddc9]",
            "font-semibold",
            "text-[#2d332b]",
            "shadow-xs",
          );
          btn.classList.add("border-transparent", "text-[#5f665c]");
          indicator?.classList.remove("bg-[#b8614b]");
          indicator?.classList.add("bg-[#c4b49d]");
        }
      });

      liveButtons.forEach((btn) => {
        btn.setAttribute("aria-pressed", isLive ? "true" : "false");
        if (isLive) {
          btn.classList.add(
            "border-[#b8614b]/60",
            "bg-[#e9ddc9]",
            "font-semibold",
            "text-[#2d332b]",
            "shadow-xs",
          );
          btn.classList.remove("border-transparent", "text-[#5f665c]");
        } else {
          btn.classList.remove(
            "border-[#b8614b]/60",
            "bg-[#e9ddc9]",
            "font-semibold",
            "text-[#2d332b]",
            "shadow-xs",
          );
          btn.classList.add("border-transparent", "text-[#5f665c]");
        }
      });
    }

    function applyAtmosphere(
      mode: SkyMode,
      immediate = false,
      reduceMotion = false,
    ) {
      if (!arrival) return;
      currentMode = mode;
      sessionStorage.setItem("lincie-station-sky", mode);
      const cfg = skyConfigs[mode];

      arrival.setAttribute("data-sky", mode);
      arrival.style.backgroundColor = cfg.bgColor;

      // Cross-fade sky gradient layers
      skyLayers.forEach((layer) => {
        const layerMode = layer.getAttribute("data-sky-layer");
        if (layerMode === mode) {
          layer.style.opacity = "1";
        } else {
          layer.style.opacity = "0";
        }
      });

      // Color filter on landscape image
      if (sceneImage) {
        sceneImage.style.filter = cfg.imgFilter;
      }

      // Train passenger window light
      trainWindows.forEach((w) => {
        w.setAttribute("fill", cfg.trainWindow);
      });

      // Update button visual states
      updateControlStates(mode);

      // Celestial positioning & lantern lighting
      const dur = immediate || reduceMotion ? 0 : 1.2;

      if (mode === "night") {
        if (sun) gsap.to(sun, { autoAlpha: 0, duration: dur * 0.6 });
        if (moon)
          gsap.to(moon, {
            autoAlpha: cfg.moonAlpha,
            duration: dur,
            ease: "power2.out",
          });
        if (stars)
          gsap.to(stars, {
            autoAlpha: cfg.starsAlpha,
            duration: dur,
            ease: "power2.out",
          });

        if (!reduceMotion && stars) {
          if (starTwinkleTimeline) starTwinkleTimeline.kill();
          const starCircles = stars.querySelectorAll("circle");
          starTwinkleTimeline = gsap.to(starCircles, {
            opacity: "random(0.3, 1)",
            duration: "random(1.8, 3.2)",
            repeat: -1,
            yoyo: true,
            stagger: { amount: 1.5, from: "random" },
            ease: "sine.inOut",
          });
        }
      } else {
        if (moon) gsap.to(moon, { autoAlpha: 0, duration: dur * 0.5 });
        if (stars) gsap.to(stars, { autoAlpha: 0, duration: dur * 0.5 });
        if (starTwinkleTimeline) {
          starTwinkleTimeline.kill();
          starTwinkleTimeline = null;
        }
        if (sun) {
          gsap.to(sun, {
            x: cfg.sun.x,
            y: cfg.sun.y,
            autoAlpha: cfg.sun.alpha,
            duration: dur,
            ease: "power2.out",
          });
        }
      }

      if (lantern) {
        gsap.to(lantern, {
          autoAlpha: cfg.lanternAlpha,
          duration: dur,
          ease: "power2.out",
        });
      }
    }

    function determineLiveMode(): { mode: SkyMode; timeStr: string } {
      const now = new Date();
      const hour = now.getHours();
      const timeStr = now.toLocaleTimeString([], {
        hour: "2-digit",
        minute: "2-digit",
      });

      let mode: SkyMode;
      if (hour >= 5 && hour < 11) {
        mode = "morning";
      } else if (hour >= 11 && hour < 16) {
        mode = "midday";
      } else if (hour >= 16 && hour < 20) {
        mode = "dusk";
      } else {
        mode = "night";
      }

      return { mode, timeStr };
    }

    // Set up button listeners
    timeButtons.forEach((btn) => {
      btn.addEventListener(
        "click",
        () => {
          isLive = false;
          const targetMode = btn.getAttribute("data-time-btn") as SkyMode;
          if (targetMode && skyConfigs[targetMode]) {
            applyAtmosphere(
              targetMode,
              false,
              window.matchMedia("(prefers-reduced-motion: reduce)").matches,
            );
          }
        },
        { signal },
      );
    });

    liveButtons.forEach((btn) => {
      btn.addEventListener(
        "click",
        () => {
          isLive = !isLive;
          if (isLive) {
            const { mode, timeStr } = determineLiveMode();
            applyAtmosphere(
              mode,
              false,
              window.matchMedia("(prefers-reduced-motion: reduce)").matches,
            );
            updateControlStates(mode, timeStr);
          } else {
            updateControlStates(currentMode);
          }
        },
        { signal },
      );
    });

    // Set up GSAP matchMedia & entrance animation
    motion = gsap.matchMedia();

    motion.add(
      {
        reduceMotion: "(prefers-reduced-motion: reduce)",
        isMobile: "(max-width: 760px)",
        isDesktop: "(min-width: 761px)",
      },
      (context) => {
        const conditions = context.conditions as
          { isMobile?: boolean; reduceMotion?: boolean } | undefined;
        const isMobile = conditions?.isMobile ?? false;
        const reduceMotion = conditions?.reduceMotion ?? false;

        const visibleElements = [
          sceneImage,
          sun,
          stop,
          location,
          clockContainer,
          title,
          copy,
          note,
          notice,
          board,
          ...routes,
          ...gestures,
        ].filter(
          (element): element is HTMLElement | SVGGElement => element !== null,
        );

        if (!sceneImage || !sun || !stop || !title || !board) {
          return;
        }

        // Apply saved or current atmosphere immediately
        applyAtmosphere(currentMode, true, reduceMotion);

        if (reduceMotion) {
          gsap.set(drawPaths, { drawSVG: "0% 100%" });
          gsap.set(visibleElements, {
            autoAlpha: 1,
            clearProps: "transform,opacity,filter",
          });
          if (train) gsap.set(train, { autoAlpha: 0 });
          const activeRail =
            document.querySelector<SVGLineElement>("[data-rail-active]");
          if (activeRail) gsap.set(activeRail, { drawSVG: "100%" });
          const railCar =
            document.querySelector<HTMLElement>("[data-rail-car]");
          if (railCar) gsap.set(railCar, { autoAlpha: 0 });
          return;
        }

        // The living countryside train journey
        if (train) {
          if (trainTimeline) trainTimeline.kill();
          trainTimeline = gsap.timeline({ repeat: -1, repeatDelay: 12 });
          trainTimeline.set(train, { autoAlpha: 1 });
          trainTimeline.to(train, {
            duration: 26,
            ease: "none",
            motionPath: {
              path: "#arrival-train-track",
              align: "#arrival-train-track",
              alignOrigin: [0.5, 0.95],
              autoRotate: true,
            },
          });
          trainTimeline.to(train, { autoAlpha: 0, duration: 0.4 });

          // Intersection observer: pause train animation when scrolled out of view
          observer = new IntersectionObserver(
            (entries) => {
              entries.forEach((entry) => {
                if (entry.isIntersecting) {
                  trainTimeline?.resume();
                } else {
                  trainTimeline?.pause();
                }
              });
            },
            { threshold: 0.1 },
          );
          observer.observe(arrival);
        }

        // Coordinated arrival entrance sequence
        const sequence = gsap.timeline({
          defaults: {
            ease: "power3.out",
          },
        });

        sequence
          .addLabel("arrival")
          .fromTo(
            sceneImage,
            { scale: 1.035, willChange: "transform" },
            {
              scale: 1,
              duration: 1.4,
              ease: "power1.out",
              clearProps: "willChange",
            },
            "arrival",
          )
          .fromTo(
            drawPaths,
            { drawSVG: 0, autoAlpha: 0 },
            {
              drawSVG: "0% 100%",
              autoAlpha: 1,
              duration: 1.5,
              ease: "power1.inOut",
            },
            "arrival",
          )
          .fromTo(
            stop,
            { y: 14, autoAlpha: 0 },
            { y: 0, autoAlpha: 1, duration: 1.1 },
            "arrival",
          )
          .fromTo(
            location,
            { x: -16, autoAlpha: 0 },
            { x: 0, autoAlpha: 1, duration: 0.7 },
            "arrival",
          )
          .fromTo(
            clockContainer,
            { x: -12, autoAlpha: 0 },
            { x: 0, autoAlpha: 1, duration: 0.8 },
            "arrival",
          )
          .fromTo(title, { y: 24 }, { y: 0, duration: 0.95 }, "arrival")
          .fromTo(
            copy,
            { y: 14, autoAlpha: 0 },
            { y: 0, autoAlpha: 1, duration: 1.2 },
            "arrival",
          )
          .fromTo(
            note,
            { y: 10, autoAlpha: 0 },
            { y: 0, autoAlpha: 1, duration: 1.35 },
            "arrival",
          )
          .fromTo(
            notice,
            { y: 10, autoAlpha: 0 },
            { y: 0, autoAlpha: 1, duration: 1.5 },
            "arrival",
          )
          .fromTo(
            board,
            { y: isMobile ? 16 : 26, scale: 0.985 },
            { y: 0, scale: 1, duration: 1.2 },
            "arrival",
          )
          .fromTo(
            routes,
            { y: 8, autoAlpha: 0 },
            { y: 0, autoAlpha: 1, duration: 1.4 },
            "arrival",
          )
          .fromTo(
            gestures,
            { y: 10, autoAlpha: 0 },
            { y: 0, autoAlpha: 1, duration: 1.6 },
            "arrival",
          );

        // 1. Hero Atmospheric Parallax on Scroll
        gsap.to(sceneImage, {
          yPercent: isMobile ? 8 : 15,
          ease: "none",
          scrollTrigger: {
            trigger: arrival,
            start: "top top",
            end: "bottom top",
            scrub: 1,
          },
        });

        const celestials = [sun, moon].filter(Boolean);
        if (celestials.length) {
          gsap.to(celestials, {
            yPercent: -14,
            ease: "none",
            scrollTrigger: {
              trigger: arrival,
              start: "top top",
              end: "bottom top",
              scrub: 1,
            },
          });
        }

        if (stop) {
          gsap.to(stop, {
            yPercent: 8,
            ease: "none",
            scrollTrigger: {
              trigger: arrival,
              start: "top top",
              end: "bottom top",
              scrub: 1,
            },
          });
        }

        const arrivalLeftCol = arrival.querySelector<HTMLElement>(
          "[data-arrival-left-column]",
        );
        if (arrivalLeftCol) {
          gsap.to(arrivalLeftCol, {
            y: -30,
            autoAlpha: 0.85,
            ease: "none",
            scrollTrigger: {
              trigger: arrival,
              start: "top top",
              end: "bottom top",
              scrub: 1,
            },
          });
        }

        if (board) {
          gsap.to(board, {
            y: isMobile ? -14 : -45,
            rotation: isMobile ? 0 : -0.3,
            ease: "none",
            scrollTrigger: {
              trigger: arrival,
              start: "top top",
              end: "bottom top",
              scrub: 1,
            },
          });
        }

        // 2. The Countryside Rail Journey in #rooms
        const railJourney = document.querySelector<HTMLElement>(
          "[data-rail-journey]",
        );
        const railTrackWrap = document.querySelector<HTMLElement>(
          "[data-rail-track-wrap]",
        );
        const baseLeft = document.querySelector<SVGLineElement>(
          "[data-rail-base-left]",
        );
        const baseRight = document.querySelector<SVGLineElement>(
          "[data-rail-base-right]",
        );
        const activeRail =
          document.querySelector<SVGLineElement>("[data-rail-active]");
        const railCar = document.querySelector<HTMLElement>("[data-rail-car]");

        function setupRailGeometry() {
          if (!railTrackWrap) return;
          const width = railTrackWrap.clientWidth;
          const height = railTrackWrap.clientHeight;
          const cx = width / 2;
          const gauge = isMobile ? 8 : 11;

          if (baseLeft) {
            baseLeft.setAttribute("x1", String(cx - gauge / 2));
            baseLeft.setAttribute("y1", "0");
            baseLeft.setAttribute("x2", String(cx - gauge / 2));
            baseLeft.setAttribute("y2", String(height));
          }
          if (baseRight) {
            baseRight.setAttribute("x1", String(cx + gauge / 2));
            baseRight.setAttribute("y1", "0");
            baseRight.setAttribute("x2", String(cx + gauge / 2));
            baseRight.setAttribute("y2", String(height));
          }
          if (activeRail) {
            activeRail.setAttribute("x1", String(cx));
            activeRail.setAttribute("y1", "0");
            activeRail.setAttribute("x2", String(cx));
            activeRail.setAttribute("y2", String(height));
          }
        }

        setupRailGeometry();

        if (activeRail && railJourney) {
          gsap.fromTo(
            activeRail,
            { drawSVG: "0%" },
            {
              drawSVG: "100%",
              ease: "none",
              scrollTrigger: {
                trigger: railJourney,
                start: "top 75%",
                end: "bottom 80%",
                scrub: 1,
                invalidateOnRefresh: true,
                onRefresh: () => setupRailGeometry(),
              },
            },
          );
        }

        if (railCar && railJourney && railTrackWrap) {
          gsap.fromTo(
            railCar,
            { y: 0, autoAlpha: 0 },
            {
              y: () => railTrackWrap.clientHeight - 18,
              ease: "none",
              scrollTrigger: {
                trigger: railJourney,
                start: "top 75%",
                end: "bottom 80%",
                scrub: 1,
                invalidateOnRefresh: true,
                onEnter: () =>
                  gsap.to(railCar, { autoAlpha: 1, duration: 0.35 }),
                onLeave: () =>
                  gsap.to(railCar, { autoAlpha: 0, duration: 0.35 }),
                onEnterBack: () =>
                  gsap.to(railCar, { autoAlpha: 1, duration: 0.35 }),
                onLeaveBack: () =>
                  gsap.to(railCar, { autoAlpha: 0, duration: 0.35 }),
              },
            },
          );
        }

        // 3. Station Stop Milestones & Room Dioramas
        const roomArticles = document.querySelectorAll<HTMLElement>(
          "[data-room-article]",
        );

        roomArticles.forEach((article) => {
          const beacon =
            article.querySelector<HTMLElement>("[data-stop-beacon]");
          const dot = article.querySelector<HTMLElement>("[data-stop-dot]");
          const tag = article.querySelector<HTMLElement>("[data-stop-tag]");

          ScrollTrigger.create({
            trigger: article,
            start: "top 68%",
            end: "bottom 32%",
            onEnter: () => setStopActive(true),
            onEnterBack: () => setStopActive(true),
            onLeave: () => setStopActive(false),
            onLeaveBack: () => setStopActive(false),
          });

          function setStopActive(active: boolean) {
            if (beacon) {
              beacon.style.borderColor = active ? "#b8614b" : "#c4b49d";
              beacon.style.boxShadow = active
                ? "0 0 14px rgba(184, 97, 75, 0.38)"
                : "";
              beacon.style.transform = active ? "scale(1.15)" : "scale(1)";
            }
            if (dot) {
              dot.style.backgroundColor = active ? "#b8614b" : "#c4b49d";
            }
            if (tag) {
              tag.style.color = active ? "#843d2f" : "#5f665c";
            }
          }

          // Dual-plane optical diorama parallax inside each room card
          const diorama = article.querySelector<HTMLElement>(
            "[data-room-diorama]",
          );
          if (diorama) {
            const sunEl =
              diorama.querySelector<HTMLElement>("[data-diorama-sun]");
            const backEls = diorama.querySelectorAll<HTMLElement>(
              "[data-diorama-back]",
            );
            const midEls =
              diorama.querySelectorAll<HTMLElement>("[data-diorama-mid]");
            const signEl = diorama.querySelector<HTMLElement>(
              "[data-diorama-sign]",
            );

            if (sunEl) {
              gsap.fromTo(
                sunEl,
                { y: 16 },
                {
                  y: -22,
                  ease: "none",
                  scrollTrigger: {
                    trigger: article,
                    start: "top bottom",
                    end: "bottom top",
                    scrub: 1.2,
                  },
                },
              );
            }

            if (backEls.length) {
              gsap.fromTo(
                backEls,
                { y: 12 },
                {
                  y: -14,
                  ease: "none",
                  scrollTrigger: {
                    trigger: article,
                    start: "top bottom",
                    end: "bottom top",
                    scrub: 1.2,
                  },
                },
              );
            }

            if (midEls.length) {
              gsap.fromTo(
                midEls,
                { y: -6 },
                {
                  y: 10,
                  ease: "none",
                  scrollTrigger: {
                    trigger: article,
                    start: "top bottom",
                    end: "bottom top",
                    scrub: 1.2,
                  },
                },
              );
            }

            if (signEl) {
              gsap.fromTo(
                signEl,
                { y: 10, scale: 0.98 },
                {
                  y: -6,
                  scale: 1,
                  ease: "none",
                  scrollTrigger: {
                    trigger: article,
                    start: "top bottom",
                    end: "bottom top",
                    scrub: 1.2,
                  },
                },
              );
            }
          }

          // Content arrival entrance
          const content = article.querySelector<HTMLElement>(
            "[data-room-content]",
          );
          if (content) {
            gsap.fromTo(
              content,
              { y: 24, autoAlpha: 0.8 },
              {
                y: 0,
                autoAlpha: 1,
                duration: 0.8,
                ease: "power2.out",
                scrollTrigger: {
                  trigger: article,
                  start: "top 80%",
                  toggleActions: "play none none reverse",
                },
              },
            );
          }
        });

        // 4. Platform Buffer Stop at #pause
        const pauseSection = document.querySelector<HTMLElement>("#pause");
        const pauseBuffer = pauseSection?.querySelector<HTMLElement>(
          "[data-pause-buffer]",
        );
        const pauseBufferInner = pauseSection?.querySelector<HTMLElement>(
          "[data-pause-buffer-inner]",
        );

        if (pauseSection && pauseBuffer && pauseBufferInner) {
          ScrollTrigger.create({
            trigger: pauseSection,
            start: "top 78%",
            onEnter: () => {
              pauseBuffer.style.borderColor = "#b8614b";
              pauseBuffer.style.boxShadow = "0 0 20px rgba(184, 97, 75, 0.32)";
              pauseBufferInner.style.backgroundColor = "#b8614b";
            },
            onLeaveBack: () => {
              pauseBuffer.style.borderColor = "#c4b49d";
              pauseBuffer.style.boxShadow = "";
              pauseBufferInner.style.backgroundColor = "transparent";
            },
          });
        }

        ScrollTrigger.refresh();
      },
      arrival,
    );
  });
</script>
