---
import { siteContainer } from "../components/layout/container";
import MainLayout from "../components/layout/MainLayout.astro";
import FieldCard from "../components/station/FieldCard.astro";
import StepLink from "../components/station/StepLink.astro";
import StationSolarDial from "../components/station/StationSolarDial.astro";
import RoomDiorama from "../components/station/RoomDiorama.astro";
import { offers } from "../data/offers";
import { projects } from "../data/projects";
import { stationRoutes } from "../data/routes";
import { thoughts } from "../data/thoughts";
import { site } from "../data/site";

type Tone = "house" | "field" | "workshop" | "thoughts" | "letterbox";

type HomeDetail = {
  label: string;
  invitation: string;
  roomNote: string;
  tone: Tone;
  /** Status line beside the room heading. Omitted for rooms that carry none. */
  badge?: string;
};

const tendedCount = projects.filter(
  (project) => project.status === "tended",
).length;
const harvestedCount = projects.filter(
  (project) => project.status === "harvested",
).length;
const publishedThoughts = thoughts.filter(
  (thought) => thought.status === "published",
);
const projectCountLabel = `${projects.length} ${projects.length === 1 ? "cultivated project" : "cultivated projects"}`;
const contactEmail = site.contactEmail.trim();

/** Homepage-only wording per place: the board's literal label, its invitation, room note, and tone. */
const homeDetails: Record<string, HomeDetail> = {
  "about-me": {
    label: "About Me",
    invitation: "Meet the person behind the work.",
    roomNote:
      "I’m currently a software engineering trainee at one of Southeast Asia’s biggest e-commerce companies.",
    tone: "house",
  },
  projects: {
    label: "Projects",
    invitation: "See what is being tended.",
    badge: `Field Gate · ${tendedCount} Tended, ${harvestedCount} Harvested`,
    roomNote:
      "I cultivate systems the way one tends land: planted with human purpose, rooted in clean database schemas, and cared for until they run quietly and reliably.",
    tone: "field",
  },
  offers: {
    label: "Things LinCie offers",
    invitation: "See where backend or web craft may help.",
    badge: "Workshop · Backend & Web Craft",
    roomNote:
      "A sunlit bench where tools rest in their grooves. I build reliable backend services in Go and TypeScript, and carefully craft bespoke websites with deep human care.",
    tone: "workshop",
  },
  thoughts: {
    label: "Personal thoughts",
    invitation: "Read a note when one is ready.",
    badge: "Waiting Room · Published notes",
    roomNote:
      "A sunlit timber bench where thoughts rest on the table. Human-sized reflections on backend engineering, databases, and the unhurried craft of software.",
    tone: "thoughts",
  },
  connect: {
    label: "Ways to connect",
    invitation: "Find a practical way to say hello.",
    badge: "Letterbox · Email contact",
    roomNote:
      "A quiet desk at the edge of the platform for hellos, project questions, and open thoughts.",
    tone: "letterbox",
  },
};

const destinations = stationRoutes
  .filter((route) => route.id !== "platform")
  .map((route) => ({ ...route, ...homeDetails[route.id] }));
---

<MainLayout
  title={site.title}
  description={site.description}
  currentRoute="/"
  pageType="ProfilePage"
>
  <section
    class="bg-sky-morning relative isolate min-h-[47rem] overflow-hidden transition-colors duration-1000 ease-out motion-reduce:transition-none max-[760px]:min-h-0"
    aria-labelledby="arrival-title"
    data-arrival
    data-sky="morning"
  >
    <div
      class="pointer-events-none absolute inset-0 z-0 overflow-hidden"
      aria-hidden="true"
    >
      <img
        class="absolute inset-0 size-full object-cover object-center opacity-[.98] transition-[filter,opacity] duration-1000 ease-out motion-reduce:transition-none max-[760px]:object-[70%_center] max-[760px]:opacity-[.42]"
        src="/images/lincie-countryside-arrival.webp"
        alt=""
        width="1376"
        height="768"
        decoding="async"
        fetchpriority="high"
        data-arrival-image
      />

      <!-- Morning Sky Layer (default) -->
      <div
        class="absolute inset-0 transition-opacity duration-1000 ease-out motion-reduce:transition-none"
        data-sky-layer="morning"
      >
        <div
          class="absolute inset-0 bg-[linear-gradient(90deg,rgba(201,224,226,.86)_0%,rgba(201,224,226,.58)_34%,rgba(201,224,226,.16)_70%,rgba(201,224,226,.02)_100%)] max-[760px]:bg-[linear-gradient(180deg,rgba(201,224,226,.92)_0%,rgba(201,224,226,.72)_48%,rgba(220,231,201,.48)_100%)]"
        >
        </div>
        <div
          class="absolute inset-x-0 bottom-0 h-[43%] bg-[linear-gradient(180deg,rgba(220,231,201,.02)_0%,rgba(220,231,201,.38)_100%)] max-[760px]:h-[32%]"
        >
        </div>
        <div
          class="absolute inset-y-0 left-0 w-[62%] bg-[linear-gradient(90deg,rgba(247,242,232,.58)_0%,rgba(247,242,232,.46)_46%,rgba(247,242,232,0)_100%)] max-[760px]:hidden"
        >
        </div>
      </div>

      <!-- Midday Sky Layer -->
      <div
        class="absolute inset-0 opacity-0 transition-opacity duration-1000 ease-out motion-reduce:transition-none"
        data-sky-layer="midday"
      >
        <div
          class="absolute inset-0 bg-[linear-gradient(90deg,rgba(247,244,232,.85)_0%,rgba(235,243,238,.55)_34%,rgba(189,224,234,.15)_70%,rgba(189,224,234,.02)_100%)] max-[760px]:bg-[linear-gradient(180deg,rgba(247,244,232,.92)_0%,rgba(235,243,238,.72)_48%,rgba(198,222,170,.48)_100%)]"
        >
        </div>
        <div
          class="absolute inset-x-0 bottom-0 h-[43%] bg-[linear-gradient(180deg,rgba(210,228,185,.04)_0%,rgba(198,222,170,.42)_100%)] max-[760px]:h-[32%]"
        >
        </div>
        <div
          class="absolute inset-y-0 left-0 w-[62%] bg-[linear-gradient(90deg,rgba(255,253,248,.68)_0%,rgba(247,242,232,.48)_46%,rgba(247,242,232,0)_100%)] max-[760px]:hidden"
        >
        </div>
      </div>

      <!-- Dusk / Sunset Sky Layer -->
      <div
        class="absolute inset-0 opacity-0 transition-opacity duration-1000 ease-out motion-reduce:transition-none"
        data-sky-layer="dusk"
      >
        <div
          class="absolute inset-0 bg-[linear-gradient(90deg,rgba(244,228,212,.90)_0%,rgba(238,192,160,.62)_34%,rgba(223,166,132,.22)_70%,rgba(223,166,132,.04)_100%)] max-[760px]:bg-[linear-gradient(180deg,rgba(244,228,212,.94)_0%,rgba(238,192,160,.75)_48%,rgba(184,97,75,.42)_100%)]"
        >
        </div>
        <div
          class="absolute inset-x-0 bottom-0 h-[43%] bg-[linear-gradient(180deg,rgba(184,97,75,.03)_0%,rgba(184,97,75,.35)_100%)] max-[760px]:h-[32%]"
        >
        </div>
        <div
          class="absolute inset-y-0 left-0 w-[62%] bg-[linear-gradient(90deg,rgba(253,246,238,.72)_0%,rgba(248,234,220,.52)_46%,rgba(248,234,220,0)_100%)] max-[760px]:hidden"
        >
        </div>
      </div>

      <!-- Night / Lantern Sky Layer -->
      <div
        class="absolute inset-0 opacity-0 transition-opacity duration-1000 ease-out motion-reduce:transition-none"
        data-sky-layer="night"
      >
        <div
          class="absolute inset-0 bg-[linear-gradient(90deg,rgba(242,238,230,.92)_0%,rgba(220,222,218,.72)_34%,rgba(42,54,62,.48)_70%,rgba(36,47,54,.18)_100%)] max-[760px]:bg-[linear-gradient(180deg,rgba(245,242,236,.95)_0%,rgba(220,222,218,.78)_48%,rgba(30,40,46,.68)_100%)]"
        >
        </div>
        <div
          class="absolute inset-x-0 bottom-0 h-[43%] bg-[linear-gradient(180deg,rgba(30,40,46,.05)_0%,rgba(25,34,39,.68)_100%)] max-[760px]:h-[32%]"
        >
        </div>
        <div
          class="absolute inset-y-0 left-0 w-[62%] bg-[linear-gradient(90deg,rgba(250,247,242,.88)_0%,rgba(245,241,234,.72)_46%,rgba(245,241,234,0)_100%)] max-[760px]:hidden"
        >
        </div>
      </div>

      <svg
        class="absolute inset-0 size-full"
        viewBox="0 0 1440 760"
        preserveAspectRatio="xMidYMid slice"
        focusable="false"
      >
        <defs>
          <radialGradient id="arrival-sun-halo" cx="50%" cy="50%" r="50%">
            <stop offset="0%" stop-color="var(--signal-gold)" stop-opacity=".46"
            ></stop>
            <stop offset="100%" stop-color="var(--signal-gold)" stop-opacity="0"
            ></stop>
          </radialGradient>
          <radialGradient id="arrival-moon-halo" cx="50%" cy="50%" r="50%">
            <stop
              offset="0%"
              stop-color="var(--surface-paper)"
              stop-opacity=".45"></stop>
            <stop offset="100%" stop-color="var(--sky-morning)" stop-opacity="0"
            ></stop>
          </radialGradient>
          <radialGradient id="arrival-lantern-glow" cx="50%" cy="50%" r="50%">
            <stop offset="0%" stop-color="#ffd479" stop-opacity=".95"></stop>
            <stop
              offset="45%"
              stop-color="var(--signal-gold)"
              stop-opacity=".42"></stop>
            <stop offset="100%" stop-color="var(--signal-gold)" stop-opacity="0"
            ></stop>
          </radialGradient>
        </defs>

        <!-- Stars (Night mode) -->
        <g
          data-arrival-stars
          class="max-[760px]:hidden"
          opacity="0"
          fill="var(--surface-paper)"
        >
          <circle cx="680" cy="70" r="1.5" opacity=".7"></circle>
          <circle cx="740" cy="110" r="1.2" opacity=".8"></circle>
          <circle cx="810" cy="50" r="1.8" opacity=".9"></circle>
          <circle cx="880" cy="95" r="1" opacity=".6"></circle>
          <circle cx="940" cy="65" r="1.6" opacity=".85"></circle>
          <circle cx="1020" cy="45" r="1.2" opacity=".75"></circle>
          <circle cx="1090" cy="85" r="1.5" opacity=".8"></circle>
          <circle cx="1240" cy="60" r="1.8" opacity=".9"></circle>
          <circle cx="1310" cy="95" r="1.2" opacity=".7"></circle>
          <circle cx="1380" cy="70" r="1.5" opacity=".85"></circle>
          <circle cx="770" cy="160" r="1.2" opacity=".65"></circle>
          <circle cx="910" cy="140" r="1.4" opacity=".75"></circle>
          <circle cx="1040" cy="120" r="1.2" opacity=".8"></circle>
        </g>

        <!-- Moon (Night mode) -->
        <g class="max-[760px]:hidden" data-arrival-moon opacity="0">
          <circle cx="1170" cy="122" r="70" fill="url(#arrival-moon-halo)"
          ></circle>
          <path
            d="M 1158 98 A 30 30 0 0 0 1190 130 A 26 26 0 1 1 1158 98 Z"
            fill="var(--surface-paper)"
            fill-opacity=".88"></path>
        </g>

        <g class="max-[760px]:hidden" data-arrival-sun>
          <circle cx="1170" cy="122" r="96" fill="url(#arrival-sun-halo)"
          ></circle>
          <circle
            cx="1170"
            cy="122"
            r="39"
            fill="var(--signal-gold)"
            fill-opacity=".64"></circle>
          <g
            fill="none"
            stroke="var(--signal-gold)"
            stroke-linecap="round"
            stroke-width="2.5"
            opacity=".72"
          >
            <path data-arrival-draw d="M1170 59V40"></path>
            <path data-arrival-draw d="M1170 185v19"></path>
            <path data-arrival-draw d="M1107 122h-19"></path>
            <path data-arrival-draw d="M1233 122h19"></path>
            <path data-arrival-draw d="m1125 77-14-14"></path>
            <path data-arrival-draw d="m1215 167 14 14"></path>
            <path data-arrival-draw d="m1215 77 14-14"></path>
            <path data-arrival-draw d="m1125 167-14 14"></path>
          </g>
        </g>

        <g
          fill="none"
          stroke="var(--surface-sunlit)"
          stroke-linecap="round"
          stroke-linejoin="round"
          stroke-width="2"
          opacity=".52"
          vector-effect="non-scaling-stroke"
        >
          <path
            data-arrival-draw
            d="M640 338c126-43 198-10 300-69 94-54 167-6 261-45 91-38 172 39 275-9 112-52 184 23 288-38 99-57 221-8 356-69"
          ></path>

          <!-- The Valley Track Path (train journeys along this path) -->
          <path
            id="arrival-train-track"
            data-arrival-draw
            d="M-80 584 L-20 576c270-35 493-8 720-29 259-24 483 8 760-30 L1520 509"
          ></path>
          <path
            data-arrival-draw
            d="M-20 632c272-29 500-10 780-31 255-20 477 11 700-28"></path>
          <path
            data-arrival-draw
            d="M-20 687c312-27 566-13 841-37 242-21 453 10 639-22"></path>
          <path
            data-arrival-draw
            d="M-20 706c291-30 568-14 852-35 236-17 431 5 628-21"></path>
          <path
            data-arrival-draw
            d="M-20 728c306-26 577-13 873-37 235-19 422 6 607-16"></path>
        </g>

        <!-- The Living Countryside Valley Train (Distant 2-car train) -->
        <g
          data-arrival-train
          class="max-[760px]:hidden"
          opacity="0"
          pointer-events="none"
        >
          <!-- Car 1 (front car) -->
          <rect
            x="-26"
            y="-10"
            width="24"
            height="9.5"
            rx="2"
            fill="var(--ink-primary)"
            opacity=".88"></rect>
          <!-- Car 1 windows -->
          <rect
            data-train-window
            x="-24"
            y="-8"
            width="4.5"
            height="3.5"
            rx="1"
            fill="var(--surface-station)"
            opacity=".92"></rect>
          <rect
            data-train-window
            x="-17"
            y="-8"
            width="4.5"
            height="3.5"
            rx="1"
            fill="var(--surface-station)"
            opacity=".92"></rect>
          <rect
            data-train-window
            x="-10"
            y="-8"
            width="4.5"
            height="3.5"
            rx="1"
            fill="var(--surface-station)"
            opacity=".92"></rect>
          <!-- Coupler -->
          <line
            x1="-2"
            y1="-4.5"
            x2="2"
            y2="-4.5"
            stroke="var(--ink-primary)"
            stroke-width="1.8"></line>
          <!-- Car 2 (rear car) -->
          <rect
            x="2"
            y="-10"
            width="24"
            height="9.5"
            rx="2"
            fill="var(--ink-primary)"
            opacity=".88"></rect>
          <!-- Car 2 windows -->
          <rect
            data-train-window
            x="4"
            y="-8"
            width="4.5"
            height="3.5"
            rx="1"
            fill="var(--surface-station)"
            opacity=".92"></rect>
          <rect
            data-train-window
            x="11"
            y="-8"
            width="4.5"
            height="3.5"
            rx="1"
            fill="var(--surface-station)"
            opacity=".92"></rect>
          <rect
            data-train-window
            x="18"
            y="-8"
            width="4.5"
            height="3.5"
            rx="1"
            fill="var(--surface-station)"
            opacity=".92"></rect>
        </g>

        <!-- Platform Stop Sign & Platform Lantern -->
        <g
          data-arrival-stop
          fill="none"
          stroke="var(--signal-terracotta)"
          stroke-linecap="round"
          stroke-linejoin="round"
          stroke-width="2.5"
          opacity=".78"
          vector-effect="non-scaling-stroke"
        >
          <path data-arrival-draw d="M746 548V395"></path>
          <path data-arrival-draw d="M746 409h-27"></path>
          <path data-arrival-draw d="M714 548h64"></path>
          <circle cx="746" cy="386" r="14" fill="var(--signal-terracotta)"
          ></circle>
          <path d="M738 386h16" stroke="var(--surface-paper)" stroke-width="2"
          ></path>

          <!-- Vintage Station Gooseneck Platform Lamp -->
          <path
            d="M746 395 C746 368 732 360 725 360"
            stroke="var(--ink-primary)"
            stroke-width="2"></path>
          <path
            d="M717 360 L733 360 L729 356 Z"
            fill="var(--ink-primary)"
            stroke="var(--ink-primary)"
            stroke-width="1"></path>
          <circle
            cx="725"
            cy="362"
            r="2.5"
            fill="var(--surface-paper)"
            stroke="var(--ink-primary)"
            stroke-width="0.5"></circle>
          <!-- Lantern Glow Pool (Dusk/Night) -->
          <circle
            cx="725"
            cy="370"
            r="64"
            fill="url(#arrival-lantern-glow)"
            data-arrival-lantern
            opacity="0"></circle>
        </g>
      </svg>
    </div>

    <div
      class={`${siteContainer} relative grid min-h-[47rem] grid-cols-[minmax(0,0.95fr)_minmax(25rem,0.8fr)] grid-rows-[auto_auto] items-center gap-[clamp(2.5rem,7vw,7.5rem)] py-[clamp(3rem,5vw,4rem)] max-[1050px]:grid-cols-[minmax(0,0.9fr)_minmax(22rem,0.8fr)] max-[1050px]:gap-10 max-[760px]:flex max-[760px]:min-h-0 max-[760px]:flex-col max-[760px]:items-stretch max-[760px]:gap-12 max-[760px]:pb-16 max-[760px]:pt-14`}
    >
      <div
        class="relative z-[2] col-start-1 row-start-1 max-w-[38rem] self-start max-[760px]:col-auto max-[760px]:row-auto max-[760px]:max-w-none"
        data-arrival-left-column
      >
        <div
          class="border-ink-primary/40 text-ink-primary mb-4 flex w-fit flex-wrap items-center gap-x-3 gap-y-2 border-b pb-[.7rem] font-sans text-[.8125rem] tracking-[.02em]"
          data-arrival-location
        >
          <span
            class="bg-signal-terracotta size-[.55rem] shrink-0 rounded-full"
            aria-hidden="true"></span>
          <span>You are here</span>
          <strong class="text-ink-primary font-bold"
            >Platform / Station arrival</strong
          >
        </div>

        <h1
          id="arrival-title"
          class="max-w-[10ch] font-serif text-[clamp(3.75rem,7.2vw,6rem)] leading-[.99] font-normal tracking-[-0.035em] max-[760px]:max-w-[9ch] max-[760px]:text-[clamp(3rem,14vw,4.5rem)]"
          data-arrival-title
        >
          Welcome.<br />You made it <em
            class="text-signal-terracotta-ink font-normal not-italic">here.</em
          >
        </h1>

        <p
          class="mt-7 max-w-[38rem] text-[clamp(1.05rem,1.5vw,1.25rem)] leading-[1.55]"
          data-arrival-copy
        >
          LinCie is a software engineering trainee making room for thoughtful
          work, curious ideas, and a life around them.
        </p>

        <p
          class="text-ink-primary mt-[1.35rem] flex max-w-[32rem] items-start gap-[.85rem] text-[.9rem] leading-[1.55]"
          data-arrival-note
        >
          <span
            class="border-signal-terracotta mt-[.7rem] w-9 shrink-0 border-t"
            aria-hidden="true"></span>
          <span
            >Take your time. There is no right route through this place.</span
          >
        </p>

        <aside
          class="border-ink-primary/30 mt-8 grid max-w-[31rem] grid-cols-[minmax(7rem,0.3fr)_1fr] gap-x-5 gap-y-[.35rem] border-y py-4 max-[900px]:grid-cols-1 max-[900px]:gap-y-[.45rem]"
          aria-labelledby="current-signal-title"
          data-arrival-notice
        >
          <div
            class="text-ink-primary flex items-center gap-2 font-sans text-[.8125rem] font-bold tracking-[.03em] whitespace-nowrap"
          >
            <span
              class="bg-signal-terracotta size-[.55rem] rounded-full"
              aria-hidden="true"></span>
            <span>Current notice</span>
          </div>
          <h2
            id="current-signal-title"
            class="font-serif text-[clamp(1.35rem,2vw,1.75rem)] leading-[1.1] font-normal tracking-[-0.025em]"
          >
            The station is ready.
          </h2>
          <p
            class="text-ink-primary col-start-2 text-[.9rem] leading-[1.5] transition-opacity duration-300 motion-reduce:transition-none max-[900px]:col-start-1"
            data-arrival-notice-note
          >
            The board below is ready to explore. Morning air is crisp and quiet
            across the platform.
          </p>
        </aside>

        <details
          class="border-ink-primary/20 bg-surface-paper/55 relative z-10 mt-5 max-w-[31rem] rounded-lg border px-3 py-2"
          data-arrival-dial
        >
          <summary
            class="text-ink-primary focus-visible:outline-signal-terracotta flex min-h-11 cursor-pointer list-none items-center justify-between gap-3 font-sans text-[.8125rem] font-semibold marker:hidden focus-visible:outline-2 focus-visible:outline-offset-2"
          >
            <span class="flex items-center gap-2">
              <span
                class="bg-signal-terracotta size-2 shrink-0 rounded-full"
                aria-hidden="true"></span>
              <span>Set station atmosphere</span>
            </span>
            <span class="text-ink-secondary font-normal">Optional</span>
          </summary>
          <div
            class="absolute top-full left-0 z-20 mt-2 w-full max-w-[31rem]"
            data-arrival-dial-panel
          >
            <StationSolarDial />
          </div>
        </details>
      </div>

      <nav
        class="border-border-soft bg-surface-station relative z-[1] col-start-2 row-span-2 row-start-1 rotate-[.7deg] scroll-mt-[5.5rem] self-center rounded-[1.25rem] border p-[clamp(1.25rem,3vw,2rem)] shadow-[0_12px_24px_rgba(57,52,38,0.1)] transition-[box-shadow] duration-1000 ease-out motion-reduce:transition-none max-[760px]:col-auto max-[760px]:row-auto max-[760px]:rotate-0"
        id="board"
        aria-labelledby="board-title"
        data-arrival-board
      >
        <span
          class="border-ink-primary/35 bg-surface-paper absolute top-4 left-4 size-[.6rem] rounded-full border shadow-[inset_0_1px_2px_rgba(45,51,43,0.14)]"
          aria-hidden="true"></span>
        <span
          class="border-ink-primary/35 bg-surface-paper absolute top-4 right-4 size-[.6rem] rounded-full border shadow-[inset_0_1px_2px_rgba(45,51,43,0.14)]"
          aria-hidden="true"></span>

        <div
          class="border-ink-primary/25 flex items-end justify-between gap-4 border-b px-[.6rem] pt-[.6rem] pb-5 max-[760px]:flex-col max-[760px]:items-start"
        >
          <h2
            id="board-title"
            class="max-w-[15ch] font-serif text-[clamp(1.65rem,3vw,2.35rem)] leading-[1.05] font-normal tracking-[-0.03em]"
          >
            Where would you like to wander?
          </h2>
          <p
            class="text-ink-primary max-w-40 text-right text-[.8125rem] leading-[1.35] max-[760px]:max-w-none max-[760px]:text-left"
          >
            {destinations.length} rooms, all on this page.
          </p>
        </div>

        <ul class="divide-ink-primary/20 m-0 list-none divide-y p-0">
          {
            destinations.map((destination) => (
              <li data-arrival-route>
                <a
                  class="group text-ink-primary hover:bg-surface-paper/55 grid min-h-20 grid-cols-[1fr_auto] items-center gap-4 px-[.6rem] py-[.85rem] no-underline transition-[background-color,padding-inline] duration-200 ease-out hover:px-[.95rem] motion-reduce:transition-none max-[480px]:min-h-[5.4rem] max-[480px]:px-0 max-[480px]:hover:px-[.35rem]"
                  href={`#${destination.id}`}
                >
                  <span class="grid min-w-0 gap-[.14rem]">
