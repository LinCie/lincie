---
import MainLayout from "../components/layout/MainLayout.astro";

type Destination = {
  id: string;
  place: string;
  label: string;
  invitation: string;
  roomNote: string;
  tone: "house" | "field" | "workshop" | "thoughts" | "letterbox";
};

const destinations: Destination[] = [
  {
    id: "about-me",
    place: "Station House",
    label: "About Me",
    invitation: "Meet the person behind the work.",
    roomNote:
      "This room is quiet for now. A plain introduction will live here when there is something true to say.",
    tone: "house",
  },
  {
    id: "projects",
    place: "Rice Fields",
    label: "Projects",
    invitation: "See what is being tended.",
    roomNote:
      "The fields are quiet for now. Project stories will begin with what they are and why they needed to exist.",
    tone: "field",
  },
  {
    id: "offers",
    place: "Workshop",
    label: "Things LinCie offers",
    invitation: "Find the situations that may fit.",
    roomNote:
      "The workshop is quiet for now. Confirmed ways LinCie may help will be listed here.",
    tone: "workshop",
  },
  {
    id: "thoughts",
    place: "Waiting Room",
    label: "Personal thoughts",
    invitation: "Read a note when one is ready.",
    roomNote:
      "The waiting room is quiet for now. Personal notes will appear here when they are ready to share.",
    tone: "thoughts",
  },
  {
    id: "connect",
    place: "Letterbox",
    label: "Ways to connect",
    invitation: "Find a practical way to say hello.",
    roomNote:
      "The letterbox is quiet for now. Contact channels and next steps will be added once they are confirmed.",
    tone: "letterbox",
  },
];
---

<MainLayout title="LinCie — Welcome. You made it here.">
  <a class="skip-link" href="#main-content">Skip to main content</a>

  <div class="site-shell">
    <header class="site-header">
      <div class="site-container header-inner">
        <a
          class="brand"
          href="/"
          aria-current="page"
          aria-label="LinCie station home"
        >
          <span class="brand-mark" aria-hidden="true">
            <span></span>
          </span>
          <span class="brand-name">LinCie</span>
        </a>

        <p class="header-status">
          <span class="status-light" aria-hidden="true"></span>
          Station arrival
        </p>
      </div>
    </header>

    <main id="main-content" tabindex="-1">
      <section class="arrival" aria-labelledby="arrival-title">
        <div class="arrival-landscape" aria-hidden="true">
          <span class="morning-sun"></span>
          <span class="far-hill"></span>
          <span class="near-field"></span>
          <span class="station-house-shape">
            <span class="station-roof"></span>
            <span class="station-wall">
              <span class="station-window"></span>
              <span class="station-window"></span>
              <span class="station-door"></span>
            </span>
            <span class="station-lamp"></span>
          </span>
          <span class="track-system"></span>
          <span class="grass-cluster grass-cluster-one"></span>
          <span class="grass-cluster grass-cluster-two"></span>
        </div>

        <div class="site-container arrival-inner">
          <div class="welcome-column">
            <div class="current-location" aria-label="Current location">
              <span class="location-signal" aria-hidden="true"></span>
              <span>You are here</span>
              <strong>Platform / Station arrival</strong>
            </div>

            <h1 id="arrival-title">Welcome.<br />You made it <em>here.</em></h1>

            <p class="welcome-copy">
              LinCie is a software engineering trainee making room for
              thoughtful work, curious ideas, and a life around them.
            </p>

            <p class="identity-line">
              <span class="identity-rule" aria-hidden="true"></span>
              <span
                >Take your time. There is no right route through this place.</span
              >
            </p>

            <aside
              class="current-signal"
              aria-labelledby="current-signal-title"
            >
              <div class="signal-heading">
                <span class="signal-dot" aria-hidden="true"></span>
                <span>Current notice</span>
              </div>
              <h2 id="current-signal-title">Still making room.</h2>
              <p>
                The rooms below are quiet for now. Their doors are still easy to
                find.
              </p>
            </aside>
          </div>

          <nav class="station-board" id="board" aria-labelledby="board-title">
            <div class="board-peg board-peg-left" aria-hidden="true"></div>
            <div class="board-peg board-peg-right" aria-hidden="true"></div>

            <div class="board-heading">
              <div>
                <h2 id="board-title">Where would you like to wander?</h2>
              </div>
              <p class="board-note">Five rooms, all on this page.</p>
            </div>

            <ul class="board-list">
              {
                destinations.map((destination) => (
                  <li>
                    <a class="board-link" href={`#${destination.id}`}>
                      <span class="board-link-copy">
                        <span class="route-place">{destination.place}</span>
                        <span class="route-label">{destination.label}</span>
                        <span class="route-invitation">
                          {destination.invitation}
                        </span>
                      </span>
                      <span class="route-arrow" aria-hidden="true">
                        <svg viewBox="0 0 20 20" role="img">
                          <path d="M3 10h13M10 4l6 6-6 6" />
                        </svg>
                      </span>
                    </a>
                  </li>
                ))
              }
            </ul>

            <div class="board-footer">
              <span class="board-footer-line" aria-hidden="true"></span>
              <span>Choose a door, or simply stay a while.</span>
            </div>
          </nav>

          <div class="arrival-gestures" aria-label="Ways to begin">
            <a class="gesture-link" href="#board">
              <span class="gesture-icon" aria-hidden="true">
                <svg viewBox="0 0 24 24" role="img">
                  <rect x="4" y="3.5" width="16" height="17" rx="1.5"></rect>
                  <path d="M7.5 8h9M7.5 12h9M7.5 16h5"></path>
                </svg>
              </span>
              <span class="gesture-copy">
                <strong>Look at the board</strong>
                <small>See every room on this page.</small>
              </span>
              <span class="link-arrow" aria-hidden="true">
                <svg viewBox="0 0 20 20" role="img">
                  <path d="M3 10h13M10 4l6 6-6 6"></path>
                </svg>
              </span>
            </a>

            <a class="gesture-link" href="#pause">
              <span class="gesture-icon" aria-hidden="true">
                <svg viewBox="0 0 24 24" role="img">
                  <path
                    d="M4 16.5h16M6.5 16.5v2M17.5 16.5v2M7 13h10M9 13V8.5h6V13"
                  ></path>
                  <path d="M8 8.5 12 5l4 3.5"></path>
                </svg>
              </span>
              <span class="gesture-copy">
                <strong>Sit for a moment</strong>
                <small>Stay with the welcome.</small>
              </span>
              <span class="link-arrow" aria-hidden="true">
                <svg viewBox="0 0 20 20" role="img">
                  <path d="M3 10h13M10 4l6 6-6 6"></path>
                </svg>
              </span>
            </a>

            <a class="gesture-link" href="#about-me">
              <span class="gesture-icon" aria-hidden="true">
                <svg viewBox="0 0 24 24" role="img">
                  <path
                    d="M3.5 10.5 12 4l8.5 6.5M5.5 9.5v10h13v-10M9 19.5v-6h6v6"
                  ></path>
                </svg>
              </span>
              <span class="gesture-copy">
                <strong>Step inside</strong>
                <small>Visit the Station House.</small>
              </span>
              <span class="link-arrow" aria-hidden="true">
                <svg viewBox="0 0 20 20" role="img">
                  <path d="M3 10h13M10 4l6 6-6 6"></path>
                </svg>
              </span>
            </a>
          </div>
        </div>
      </section>

      <section class="rooms-section" id="rooms" aria-labelledby="rooms-title">
        <div class="site-container">
          <div class="section-heading">
            <div>
              <h2 id="rooms-title">A small world, still becoming.</h2>
            </div>
            <p class="section-intro">
              The places are named now. Their real stories will arrive when
              there is something confirmed to share.
            </p>
          </div>

          <div class="room-list">
            {
              destinations.map((destination) => (
                <article
                  class={`quiet-room quiet-room-${destination.tone}`}
                  id={destination.id}
                >
                  <div class="room-marker" aria-hidden="true">
                    <span class="marker-sun" />
                    <span class="marker-shape marker-shape-one" />
                    <span class="marker-shape marker-shape-two" />
                    <span class="marker-sign">
                      <span>{destination.place}</span>
                    </span>
                  </div>

                  <div class="room-copy">
                    <div class="room-heading-row">
                      <h3>{destination.label}</h3>
                      <span class="quiet-state">Quiet for now</span>
                    </div>
                    <p class="room-place">{destination.place}</p>
                    <p class="room-note">{destination.roomNote}</p>
                    <a class="room-return" href="#board">
                      <span>Return to the station board</span>
                      <span class="link-arrow" aria-hidden="true">
                        <svg viewBox="0 0 20 20" role="img">
                          <path d="M3 10h13M10 4l6 6-6 6" />
                        </svg>
                      </span>
                    </a>
                  </div>
                </article>
              ))
            }
          </div>
        </div>
      </section>

      <section class="pause-section" id="pause" aria-labelledby="pause-title">
        <div class="site-container pause-inner">
          <div class="pause-mark" aria-hidden="true">
            <span></span>
          </div>
          <div>
            <h2 id="pause-title">You can pause here.</h2>
            <p>
              There is no tour to finish and nothing to keep up with. Come back
              when you feel like wandering again.
            </p>
          </div>
          <a class="back-to-top" href="#main-content">
            <span>Back to the platform</span>
            <span class="link-arrow" aria-hidden="true">
              <svg viewBox="0 0 20 20" role="img">
                <path d="M3 10h13M10 4l6 6-6 6"></path>
              </svg>
            </span>
          </a>
        </div>
      </section>
    </main>

    <footer class="return-platform" id="return-platform">
      <div class="site-container footer-inner">
        <div>
          <p class="footer-sign">LinCie Station</p>
          <p class="footer-copy">A personal world first. A portfolio second.</p>
        </div>

        <nav class="footer-nav" aria-label="Return navigation">
          <a href="#board">Station board</a>
          <a href="#rooms">Quiet rooms</a>
          <a href="#main-content">Top of page</a>
        </nav>

        <p class="footer-note">No route to complete.</p>
      </div>
    </footer>
  </div>
</MainLayout>

<style>
  /* The station scene uses local CSS for its responsive physical layers; the content remains native HTML anchors. */
  :global(:root) {
    --sunlit: #f7f2e8;
    --paper: #fffdf8;
    --station: #e9ddc9;
    --field: #dce7c9;
    --sky: #c9e0e2;
    --ink: #2d332b;
    --quiet: #5f665c;
    --line: #c4b49d;
    --green: #6c895f;
    --terracotta: #b8614b;
    --signal-ink: #843d2f;
    --quiet-strong: #50594d;
    --gold: #d49a48;
    --deep-green: #384637;
    --shadow: 0 16px 34px rgba(57, 52, 38, 0.14);
  }

  :global(html) {
    scroll-padding-top: 1.5rem;
  }

  :global(body) {
    background: var(--sunlit);
    color: var(--ink);
  }

  .site-shell {
    min-height: 100vh;
    overflow: clip;
    background: var(--sunlit);
  }

  .site-container {
    width: min(calc(100% - 40px), 1152px);
    margin-inline: auto;
  }

  .skip-link {
    position: fixed;
    z-index: 20;
    top: 1rem;
    left: 1rem;
    padding: 0.75rem 1rem;
    border: 1px solid var(--terracotta);
    border-radius: 0.375rem;
    background: var(--paper);
    color: var(--ink);
    font-size: 0.875rem;
    font-weight: 700;
    transform: translateY(-160%);
    transition: transform 180ms ease-out;
  }

  .skip-link:focus {
    transform: translateY(0);
  }

  .site-header {
    position: relative;
    z-index: 5;
    border-bottom: 1px solid var(--line);
    background: color-mix(in srgb, var(--sunlit) 94%, transparent);
  }

  .header-inner {
    display: flex;
    min-height: 4.5rem;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
  }

  .brand,
  .header-status,
  .signal-heading,
  .quiet-state,
  .footer-sign {
    font-family: ui-sans-serif, system-ui, sans-serif;
  }

  .brand {
    display: inline-flex;
    min-height: 2.75rem;
    align-items: center;
    gap: 0.75rem;
    color: var(--ink);
    text-decoration: none;
  }

  .brand-mark {
    position: relative;
    display: grid;
    width: 2rem;
    height: 2rem;
    place-items: center;
    border: 1.5px solid var(--terracotta);
    border-radius: 50%;
  }

  .brand-mark::before,
  .brand-mark::after,
  .brand-mark span {
    position: absolute;
    display: block;
    content: "";
  }

  .brand-mark::before {
    width: 1.15rem;
    border-top: 1.5px solid var(--terracotta);
  }

  .brand-mark::after {
    height: 1.15rem;
    border-left: 1.5px solid var(--terracotta);
  }

  .brand-mark span {
    width: 0.35rem;
    height: 0.35rem;
    border-radius: 50%;
    background: var(--terracotta);
  }

  .brand-name {
    font-family: Georgia, "Noto Serif", serif;
    font-size: 1.5rem;
    letter-spacing: -0.02em;
  }

  .header-status {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    color: var(--quiet);
    font-size: 0.75rem;
    font-weight: 700;
    letter-spacing: 0.04em;
  }

  .status-light,
  .location-signal,
  .signal-dot {
    display: inline-block;
    width: 0.55rem;
    height: 0.55rem;
    flex: 0 0 auto;
    border-radius: 50%;
    background: var(--terracotta);
  }

  .arrival {
    position: relative;
    isolation: isolate;
    min-height: 47rem;
    overflow: hidden;
    background: var(--sky);
  }

  .arrival-landscape,
  .arrival-landscape > span {
    position: absolute;
    pointer-events: none;
  }

  .arrival-landscape {
    inset: 0;
    z-index: -1;
  }

  .morning-sun {
    top: 13%;
    right: 18%;
    width: clamp(5rem, 10vw, 9rem);
    aspect-ratio: 1;
    border: 1px solid color-mix(in srgb, var(--gold) 65%, var(--sky));
    border-radius: 50%;
    background: color-mix(in srgb, var(--gold) 65%, var(--sky));
    box-shadow: 0 0 0 1.25rem color-mix(in srgb, var(--gold) 15%, transparent);
  }

  .far-hill {
    right: -8%;
    bottom: 27%;
    width: 70%;
    height: 31%;
    border-radius: 58% 42% 0 0 / 100% 100% 0 0;
    background: color-mix(in srgb, var(--green) 35%, var(--sky));
    transform: rotate(-3deg);
  }

  .near-field {
    right: -10%;
    bottom: -18%;
    left: -10%;
    height: 48%;
    border-radius: 50% 50% 0 0 / 20% 20% 0 0;
    background: var(--field);
    transform: rotate(1.5deg);
  }

  .station-house-shape {
    right: 5%;
    bottom: 25%;
    width: min(35vw, 27rem);
    height: 13rem;
  }

  .station-roof {
    right: -4%;
    left: -4%;
    height: 2.25rem;
    border: 1px solid color-mix(in srgb, var(--ink) 35%, var(--station));
    background: var(--station);
    clip-path: polygon(5% 100%, 50% 0, 95% 100%);
  }

  .station-wall {
    right: 5%;
    bottom: 0;
    left: 5%;
    height: 11.5rem;
    border: 1px solid var(--line);
    background: color-mix(in srgb, var(--paper) 55%, var(--station));
  }

  .station-window,
  .station-door {
    position: absolute;
    bottom: 1.25rem;
    display: block;
    border: 1px solid var(--line);
    background: var(--sky);
  }

  .station-window {
    left: 13%;
    width: 22%;
    height: 5.5rem;
    box-shadow:
      inset 1.5rem 0 0 color-mix(in srgb, var(--paper) 12%, transparent),
      inset -1.5rem 0 0 color-mix(in srgb, var(--paper) 12%, transparent);
  }

  .station-window + .station-window {
    left: 39%;
  }

  .station-door {
    right: 12%;
    width: 20%;
    height: 7rem;
    background: var(--green);
  }

  .station-lamp {
    top: 3.5rem;
    right: 43%;
    width: 0.75rem;
    height: 0.75rem;
    border-radius: 50%;
    background: var(--gold);
    box-shadow: 0 0 0 0.6rem color-mix(in srgb, var(--gold) 24%, transparent);
  }

  .track-system {
    right: -6%;
    bottom: 17%;
    left: -6%;
    height: 4rem;
    border-top: 2px solid color-mix(in srgb, var(--ink) 72%, transparent);
    border-bottom: 2px solid color-mix(in srgb, var(--ink) 72%, transparent);
    opacity: 0.72;
    transform: rotate(-1deg);
  }

  .track-system::before,
  .track-system::after {
    position: absolute;
    top: 1.15rem;
    right: 0;
    left: 0;
    display: block;
    height: 0.35rem;
    border-top: 1px solid var(--line);
    border-bottom: 1px solid var(--line);
    content: "";
  }

  .track-system::after {
    top: 2.5rem;
    border-color: color-mix(in srgb, var(--ink) 35%, transparent);
  }

  .grass-cluster {
    bottom: 19%;
    width: 2rem;
    height: 3rem;
    border-left: 1px solid var(--green);
    border-radius: 100% 0 0 0;
    transform: rotate(25deg);
  }

  .grass-cluster::before,
  .grass-cluster::after {
    position: absolute;
    bottom: 0;
    display: block;
    width: 1.4rem;
    height: 2.65rem;
    border-left: 1px solid var(--green);
    border-radius: 100% 0 0 0;
    content: "";
  }

  .grass-cluster::before {
    left: 0.5rem;
    transform: rotate(18deg);
  }

  .grass-cluster::after {
    left: 0.9rem;
    transform: rotate(37deg);
  }

  .grass-cluster-one {
    left: 7%;
  }

  .grass-cluster-two {
    right: 43%;
    transform: scale(0.8) rotate(25deg);
  }

  .arrival-inner {
    position: relative;
    display: grid;
    min-height: 47rem;
    grid-template-columns: minmax(0, 0.95fr) minmax(25rem, 0.8fr);
    grid-template-rows: auto auto;
    align-items: center;
    gap: clamp(2.5rem, 7vw, 7.5rem);
    padding-top: clamp(3rem, 5vw, 4rem);
    padding-bottom: clamp(3rem, 5vw, 4rem);
  }

  .welcome-column {
    position: relative;
    z-index: 2;
    max-width: 38rem;
    grid-column: 1;
    grid-row: 1;
    align-self: start;
  }

  .current-location {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.5rem 0.75rem;
    width: fit-content;
    margin-bottom: 1.5rem;
    padding-bottom: 0.7rem;
    border-bottom: 1px solid color-mix(in srgb, var(--ink) 38%, transparent);
    color: var(--quiet-strong);
    font-family: ui-sans-serif, system-ui, sans-serif;
    font-size: 0.78rem;
    letter-spacing: 0.02em;
  }

  .current-location strong {
    color: var(--ink);
    font-weight: 700;
  }

  h1,
  h2,
  h3,
  p {
    margin: 0;
  }

  h1,
  h2,
  h3,
  .brand-name,
  .route-place,
  .footer-sign {
    font-family: Georgia, "Noto Serif", serif;
    font-weight: 400;
  }

  h1 {
    max-width: 10ch;
    font-size: clamp(3.75rem, 7.2vw, 6rem);
    letter-spacing: -0.035em;
    line-height: 0.99;
  }

  h1 em {
    color: var(--terracotta);
    font-style: normal;
  }

  .welcome-copy {
    max-width: 38rem;
    margin-top: 1.75rem;
    color: var(--ink);
    font-size: clamp(1.05rem, 1.5vw, 1.25rem);
    line-height: 1.55;
  }

  .identity-line {
    display: flex;
    max-width: 32rem;
    align-items: flex-start;
    gap: 0.85rem;
    margin-top: 1.35rem;
    color: var(--quiet-strong);
    font-size: 0.9rem;
    line-height: 1.55;
  }

  .identity-rule {
    width: 2.25rem;
    flex: 0 0 auto;
    margin-top: 0.7rem;
    border-top: 1px solid var(--terracotta);
  }

  .current-signal {
    display: grid;
    max-width: 31rem;
    grid-template-columns: minmax(7rem, 0.3fr) 1fr;
    gap: 0.35rem 1.25rem;
    margin-top: 2rem;
    padding-block: 1rem;
    border-top: 1px solid color-mix(in srgb, var(--ink) 30%, transparent);
    border-bottom: 1px solid color-mix(in srgb, var(--ink) 30%, transparent);
  }

  .signal-heading {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    color: var(--quiet-strong);
    font-size: 0.75rem;
    font-weight: 700;
    letter-spacing: 0.03em;
  }

  .current-signal h2 {
    font-size: clamp(1.35rem, 2vw, 1.75rem);
    letter-spacing: -0.025em;
    line-height: 1.1;
  }

  .current-signal p {
    grid-column: 2;
    color: var(--quiet-strong);
    font-size: 0.9rem;
    line-height: 1.5;
  }

  .arrival-gestures {
    display: grid;
    max-width: 36rem;
    grid-column: 1;
    grid-row: 2;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 0.75rem;
    margin-top: 1.25rem;
  }

  .gesture-link {
    display: grid;
    min-width: 0;
    grid-template-columns: auto 1fr auto;
    align-items: center;
    gap: 0.65rem;
    min-height: 4.2rem;
    padding: 0.75rem;
    border: 1px solid color-mix(in srgb, var(--ink) 25%, transparent);
    border-radius: 0.75rem;
    background: color-mix(in srgb, var(--paper) 55%, transparent);
    color: var(--ink);
    text-decoration: none;
    transition:
      border-color 180ms ease-out,
      background-color 180ms ease-out,
      transform 180ms ease-out;
  }

  .gesture-link:hover {
    border-color: var(--terracotta);
    background: var(--paper);
    transform: translateY(-2px);
  }

  .gesture-icon {
    display: grid;
    width: 1.75rem;
    height: 1.75rem;
    place-items: center;
    border: 1px solid var(--line);
    border-radius: 0.375rem;
    background: var(--paper);
    color: var(--terracotta);
  }

