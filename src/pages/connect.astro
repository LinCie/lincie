<script is:inline define:vars={{ intentsData: intents, targetEmail }}>
  function initConnectDesk() {
    const tabs = document.querySelectorAll(".intent-btn");
    if (!tabs.length) return;
    const subjectEl = document.getElementById("blueprint-subject");
    const promptsEl = document.getElementById("blueprint-prompts");
    const mailtoLink = document.getElementById("primary-mailto-link");
    const webmailLink = document.getElementById("webmail-gmail-link");
    const copyBtn = document.getElementById("copy-email-btn");
    const copyText = document.getElementById("copy-btn-text");
    const copyStatus = document.getElementById("copy-status");

    let activeIntentKey = "say-hello";

    function updateDesk(key) {
      const intent = intentsData.find((i) => i.key === key);
      if (!intent) return;
      activeIntentKey = key;

      tabs.forEach((tab) => {
        const isSelected = tab.getAttribute("data-intent-key") === key;
        tab.setAttribute("aria-selected", isSelected ? "true" : "false");
        const indicator = tab.querySelector(".intent-indicator");

        if (isSelected) {
          tab.classList.remove(
            "border-[#c4b49d]/70",
            "bg-[#fffdf8]",
            "text-[#5f665c]",
          );
          tab.classList.add(
            "border-[#b8614b]",
            "bg-[#f7f2e8]",
            "text-[#2d332b]",
            "shadow-xs",
          );
          if (indicator) {
            indicator.classList.remove("bg-[#c4b49d]/60");
            indicator.classList.add("bg-[#b8614b]");
          }
        } else {
          tab.classList.remove(
            "border-[#b8614b]",
            "bg-[#f7f2e8]",
            "text-[#2d332b]",
            "shadow-xs",
          );
          tab.classList.add(
            "border-[#c4b49d]/70",
            "bg-[#fffdf8]",
            "text-[#5f665c]",
          );
          if (indicator) {
            indicator.classList.remove("bg-[#b8614b]");
            indicator.classList.add("bg-[#c4b49d]/60");
          }
        }
      });

      if (subjectEl) {
        subjectEl.textContent = intent.subject;
      }

      if (promptsEl) {
        promptsEl.innerHTML = "";
        intent.prompts.forEach((promptText) => {
          const li = document.createElement("li");
          li.textContent = promptText;
          promptsEl.appendChild(li);
        });
      }

      const encodedSubject = encodeURIComponent(intent.subject);
      const bodyTemplate = intent.bodyTemplate;

      if (mailtoLink) {
        mailtoLink.setAttribute(
          "href",
          `mailto:${targetEmail}?subject=${encodedSubject}&body=${bodyTemplate}`,
        );
      }

      if (webmailLink) {
        webmailLink.setAttribute(
          "href",
          `https://mail.google.com/mail/?view=cm&fs=1&to=${targetEmail}&su=${encodedSubject}&body=${bodyTemplate}`,
        );
      }
    }

    tabs.forEach((tab) => {
      tab.addEventListener("click", () => {
        const key = tab.getAttribute("data-intent-key");
        if (key && key !== activeIntentKey) {
          updateDesk(key);
        }
      });
    });

    if (copyBtn) {
      copyBtn.addEventListener("click", async () => {
        try {
          await navigator.clipboard.writeText(targetEmail);
          if (copyText) copyText.textContent = "Copied!";
          if (copyStatus) copyStatus.classList.remove("hidden");

          setTimeout(() => {
            if (copyText) copyText.textContent = "Copy email";
            if (copyStatus) copyStatus.classList.add("hidden");
          }, 3000);
        } catch {
          // Fallback if clipboard API is blocked
          if (copyText) copyText.textContent = targetEmail;
        }
      });
    }
  }

  document.addEventListener("astro:page-load", initConnectDesk);
</script>
